# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Контактный адрес владельца парсера (подставляется в User-Agent)
CONTACT_EMAIL=you@yourcompany.ru

# --- Уровень C: агрегаторы с официальным API (без ключа источник отключается) ---
# Dadata (https://dadata.ru/api/find-party/)
DADATA_API_KEY=
# 2ГИС Catalog API (https://dev.2gis.ru/)
DGIS_API_KEY=
# Яндекс.Карты, API Поиска по организациям (https://yandex.ru/dev/geosearch/)
YANDEX_MAPS_API_KEY=

# --- Уровень D: официальные search API для поиска домена ---
# Google Programmable Search Engine
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# Яндекс Search API (XML): ключ и идентификатор каталога
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# --- Пул HTTP-прокси (опционально), через запятую ---
# HTTP_PROXY_POOL=http://user:pass@1.2.3.4:8080,http://user:pass@5.6.7.8:8080
HTTP_PROXY_POOL=

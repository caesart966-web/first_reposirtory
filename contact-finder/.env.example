# Скопируйте этот файл в .env (без .example) и впишите свои ключи.
# Файл .env в git не попадает — он в .gitignore.

# --- Checko API — главный источник контактов -------------------------------
# Где взять: checko.ru -> раздел API -> зарегистрироваться -> ключ.
# У бесплатного тарифа суточный лимит запросов; актуальные цифры и цены
# смотрите на странице тарифов Checko.
CHECKO_API_KEY=

# --- Datanewton API — запасной структурный источник ------------------------
# Где взять: datanewton.ru -> API.
DATANEWTON_API_KEY=

# --- 2ГИС Catalog API — точные телефоны из справочника ---------------------
# Где взять: dev.2gis.ru
DGIS_API_KEY=

# --- Яндекс XML — более точный поиск по РФ ---------------------------------
# Где взять: yandex.ru/dev/xml
YANDEX_XML_USER=
YANDEX_XML_KEY=

# --- Прокси (если нужен) ---------------------------------------------------
# CF_PROXY=http://user:pass@host:port

# Скопируйте в .env и заполните нужные ключи. Файл .env в репозиторий не попадает.

# Реквизиты из ЕГРЮЛ/ЕГРИП. Бесплатно до 10 000 запросов в сутки: https://dadata.ru/api/find-party/
DADATA_TOKEN=

# Карточка компании, контакты, связи: https://checko.ru/api
CHECKO_KEY=

# Корпоративные адреса по домену: https://hunter.io/api-keys
HUNTER_API_KEY=

# Поисковая выдача — достаточно любого одного из блоков.
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
YANDEX_XML_USER=
YANDEX_XML_KEY=
BRAVE_API_KEY=

# Справочник организаций: https://dev.2gis.ru/
TWOGIS_KEY=

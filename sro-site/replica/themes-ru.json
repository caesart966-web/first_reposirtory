{
 "_about": "Темы для reviews.py по-русски (набор Replica идёт с английскими). Шаблоны — регулярные выражения без учёта регистра. Темы составлены по самим 51 строкам replica/reviews.csv, 23.10.2026. Похвалы вида «без дополнительных поборов», «нет скрытых платежей», «не повышают взносы» в жалобы не идут: шаблоны их обходят.",
 "request_patterns": [
  "хотелось бы",
  "не хватает",
  "почему нельзя",
  "нужно было бы",
  "было бы (хорошо|удобно|лучше)"
 ],
 "themes": [
  {
   "id": "delays",
   "label": "Сроки сорваны, тянут",
   "kind": "complaint",
   "patterns": [
    "дольше",
    "на третьи сутки",
    "2 месяца",
    "месяц[аев]* (заполня|переделыва)",
    "долго",
    "забывал",
    "кормят завтраками"
   ]
  },
  {
   "id": "money",
   "label": "Деньги не возвращают",
   "kind": "complaint",
   "patterns": [
    "возврат",
    "не возвращают",
    "выкачка денег",
    "вымогают"
   ]
  },
  {
   "id": "price",
   "label": "Сумма выросла, «за всё платить»",
   "kind": "complaint",
   "patterns": [
    "сумм[аы].{0,60}(иная|другая)",
    "за вс[её] (нужно )?(всегда )?платить",
    "дорог",
    "(?<!не )повышают"
   ]
  },
  {
   "id": "docs",
   "label": "Документы: переделки, сделайте сами",
   "kind": "complaint",
   "patterns": [
    "переделыва",
    "замечани",
    "самим сделать",
    "перечень документов",
    "документы готовили долго",
    "напутал с документами",
    "документы все не дают"
   ]
  },
  {
   "id": "fakes",
   "label": "Подделки, «липа», специалисты «в подарок»",
   "kind": "complaint",
   "patterns": [
    "рисуют",
    "липов",
    "фиктивн",
    "в подарок",
    "не имело права"
   ]
  },
  {
   "id": "trust",
   "label": "Не встречаются, не отвечают за результат",
   "kind": "complaint",
   "patterns": [
    "некомпетент",
    "от личной встречи отказались",
    "шарага",
    "ни за что не отвечают",
    "золотые горы"
   ]
  },
  {
   "id": "sro_burden",
   "label": "Нагрузка со стороны самой СРО",
   "kind": "complaint",
   "patterns": [
    "членские взносы",
    "отчетност",
    "долги",
    "проверками замучают",
    "внезапные проверки"
   ]
  }
 ]
}
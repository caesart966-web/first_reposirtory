# Куда уходит заявка из квиза.
#
# Локально: скопируйте файл в .env и подставьте значения (.env в .gitignore).
# На сборке: Settings → Secrets and variables → Actions → New repository secret.
#
# VITE_LEAD_ENDPOINT  — адрес приёмника заявок.
#                       Если не задан, используется https://api.web3forms.com/submit
# VITE_LEAD_ACCESS_KEY — ключ. Без него отправка не работает: посетитель
#                       увидит экран ошибки с прямыми контактами.
#
# Боевой вариант — свой хостинг с PHP и обработчик public/api/submit.php.
# Только он работает у посетителей из России без VPN: Web3Forms — зарубежный
# сервис, из России без VPN не открывается, и заявки не дойдут. Токен ниже —
# тот же, что FORM_TOKEN в submit.php, менять не нужно:
#
#   VITE_LEAD_ENDPOINT=/api/submit.php
#   VITE_LEAD_ACCESS_KEY=sro-mn3gi1r1iambpw0ljb25fzcdqwm1
#
# Временно, пока сайт на GitHub Pages (PHP там не выполняется) — Web3Forms.
# Ключ привязан к почте, на которую создан: чтобы заявки шли на
# 9001330219@mail.ru, ключ должен быть создан на этот ящик.
#
#   VITE_LEAD_ENDPOINT=https://api.web3forms.com/submit
#   VITE_LEAD_ACCESS_KEY=<ключ сервиса>

VITE_LEAD_ENDPOINT=
VITE_LEAD_ACCESS_KEY=

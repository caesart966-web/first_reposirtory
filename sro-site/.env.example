# Куда уходит заявка из квиза.
#
# Локально: скопируйте файл в .env и подставьте значения (.env в .gitignore).
# На сборке: Settings → Secrets and variables → Actions → New repository secret.
#
# VITE_LEAD_ENDPOINT  — адрес сервиса приёма форм.
#                       Если не задан, используется https://api.web3forms.com/submit
# VITE_LEAD_ACCESS_KEY — ключ доступа сервиса. Без него отправка не работает:
#                       посетитель увидит экран ошибки с прямыми контактами.

VITE_LEAD_ENDPOINT=
VITE_LEAD_ACCESS_KEY=

# Куда уходит заявка из квиза.
# Задавать не обязательно: без этих переменных сборка использует значения
# по умолчанию из src/lib/lead.ts (Web3Forms, письма приходят на 9001330219@mail.ru).
# Переменные нужны, когда приём заявок переезжает на другой сервис или на
# собственный обработчик — тогда код менять не придётся.
#
# Локально: скопируйте файл в .env и подставьте свои значения.
# На GitHub Pages: Settings → Secrets and variables → Actions → New repository secret.

VITE_LEAD_ENDPOINT=https://api.web3forms.com/submit
VITE_LEAD_ACCESS_KEY=

{#
  Шапка сайта. Перенесена из макета stroigeroi-site/*.html без изменения
  разметки и классов: стили в style.css рассчитаны ровно на эти имена.

  Что здесь заменено на данные движка:
    - заголовок, описание, канонические ссылки  -> title/description/links
    - адреса разделов каталога                  -> цикл по categories
    - поиск                                     -> маршрут product/search
    - корзина                                   -> {{ cart }}, шаблон common/cart.twig
    - вход/личный кабинет                       -> logged ? account : login

  Чего здесь НЕТ и почему: телефон, адреса магазинов и график работы стоят
  текстом. Это не недоделка — в OpenCart нет полей под три магазина с разным
  расписанием, а выдумывать их источник нельзя. Правятся здесь, в одном месте.
#}
{#
  --- Адреса текстовых страниц --------------------------------------------
  Заполняется один раз, после создания страницы в админке
  (Каталог -> Информация; в адресе страницы виден information_id).
  ВНИМАНИЕ: такой же блок есть в common/menu.twig - правьте оба.
  Пока стоит 0, пункт меню не выводится совсем: лучше нет пункта,
  чем пункт, ведущий в никуда.
  ------------------------------------------------------------------------
#}
{% set id_delivery = 0 %}
{% set url_delivery = id_delivery ? 'index.php?route=information/information&information_id=' ~ id_delivery : '' %}
{% set url_calculator = 'index.php?route=information/calculator' %}
{% set url_compare = 'index.php?route=product/compare' %}
{% set url_special = 'index.php?route=product/special' %}

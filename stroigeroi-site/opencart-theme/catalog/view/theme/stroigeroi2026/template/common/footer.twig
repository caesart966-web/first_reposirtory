  </div>
  <div class="modal__body" data-quick-body></div>
</dialog>

<script src="catalog/view/theme/stroigeroi2026/javascript/app.js?v={{ asset_v }}"></script>
{% for script in scripts %}
<script src="{{ script }}"></script>
{% endfor %}
{#
  Предзагрузка страниц. В макете правило ловило все ссылки на .html;
  здесь так делать НЕЛЬЗЯ: часть адресов движка меняет состояние, и
  предзагрузка "route=account/logout" просто выкинула бы покупателя
  из кабинета, ничего ему не сказав. Поэтому перечислены только классы
  ссылок на разделы каталога - страницы, которые лишь показывают товар.
  Предварительная отрисовка (prerender) убрана совсем: на динамических
  страницах она заводит сессии и накручивает счётчики посещений.
#}
<script type="speculationrules">
{
  "prefetch": [{"source": "document", "where": {"selector_matches": ".catalog-menu__link, .header-quick__link, .mobile-nav__link, .site-logo"}, "eagerness": "moderate"}]
}
</script>
</body>
</html>

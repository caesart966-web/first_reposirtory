            <label for="name">Как вас зовут</label>
            <input id="name" name="name" type="text" placeholder="Имя" required autocomplete="name">
            <p class="form__error">Впишите имя</p>
          </div>
          <div class="form__row">
            <label for="contact">Телефон</label>
            <input id="contact" name="phone" type="tel" placeholder="+7 (___) ___-__-__" data-phone-mask required autocomplete="tel">
            <p class="form__error">Впишите номер телефона</p>
          </div>
          <div class="form__row">
            <label for="message">Вопрос</label>
            <textarea id="message" name="message" placeholder="Что нужно: материал, объём, сроки" required></textarea>
            <p class="form__error">Напишите, чем помочь</p>
          </div>

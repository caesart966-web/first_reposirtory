{#
  Карточка товара.

  Отличия от макета и причины:

  ГАЛЕРЕЯ. В макете четыре заглушки «фото из прайса». Здесь - настоящие
  снимки: thumb это главный, images - дополнительные. Если у товара
  фотографий нет, движок подставляет свою заглушку, поэтому пустого
  прямоугольника не будет. Блок миниатюр показывается только когда
  снимков больше одного.

  ПОКУПКА - настоящая форма, а не кнопка. Движку нужно передать номер
  товара, количество и выбранные параметры; кнопкой с одним номером
  этого не сделать. Отправляет её тот же обработчик, что и остальные
  формы темы.

  ВКЛАДКА «ДОСТАВКА И ОПЛАТА» осталась текстом с телефоном: условий
  доставки заказчик пока не дал, а выдумывать их нельзя. Когда даст -
  здесь встанет ссылка на страницу.

  ОТЗЫВОВ НЕТ. У движка они есть, но у магазина их нет ни одного, и
  пустой блок «Отзывы (0)» на новом сайте выглядит хуже, чем отсутствие
  отзывов. Вернуть просто: у движка всё для этого готово.
#}
{{ header }}
  <div class="container">

    {% if breadcrumbs %}
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><span itemprop="name">{{ breadcrumb.text }}</span><meta itemprop="position" content="{{ loop.index }}"></li>{% else %}<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a itemprop="item" href="{{ breadcrumb.href }}"><span itemprop="name">{{ breadcrumb.text }}</span></a><meta itemprop="position" content="{{ loop.index }}"></li>{% endif %}
        {% endfor %}
      </ol>
    </nav>
    {% endif %}

    {{ content_top }}

    <div class="product-hero" itemscope itemtype="https://schema.org/Product">

      <div class="gallery">
        <div class="gallery__main">
          {% if thumb %}<img itemprop="image" src="{{ thumb }}" alt="{{ heading_title }}" id="product-photo" decoding="async">{% endif %}
          {% if popup %}<a class="gallery__zoom" href="{{ popup }}" target="_blank" rel="noopener" aria-label="Открыть фотографию целиком"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4M11 8.5v5M8.5 11h5"/></svg></a>{% endif %}
        </div>
        {% if images %}
        <div class="gallery__thumbs">
          <button class="gallery__thumb" type="button" data-thumb data-full="{{ thumb }}" aria-current="true" aria-label="Фото 1"><img src="{{ thumb }}" alt="" loading="lazy"></button>
          {% for image in images %}
          <button class="gallery__thumb" type="button" data-thumb data-full="{{ image.thumb }}" aria-current="false" aria-label="Фото {{ loop.index + 1 }}"><img src="{{ image.thumb }}" alt="" loading="lazy"></button>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <div class="product-info">
        {% if manufacturer %}<p class="product-info__brand" itemprop="brand" itemscope itemtype="https://schema.org/Brand"><meta itemprop="name" content="{{ manufacturer }}"><a href="{{ manufacturers }}">{{ manufacturer }}</a></p>{% endif %}
        <h1 itemprop="name">{{ heading_title }}</h1>
        {% if model %}<p class="product-info__art">Артикул: <span itemprop="sku">{{ model }}</span></p>{% endif %}
        {% if stock %}<p class="product-info__stock"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 13 4 4 10-10"/></svg> {{ stock }}</p>{% endif %}

        <form class="product-buy" data-product-form data-validate action="index.php?route=checkout/cart/add" method="post" novalidate>
          <input type="hidden" name="product_id" value="{{ product_id }}">

          {% if price %}
          <div>
            {% if special %}<span class="price">{{ special }}</span><s class="price--old">{{ price }}</s>{% else %}<span class="price">{{ price }}</span>{% endif %}
            {% if tax %}<div class="price__unit gap-xs">Без налога: {{ tax }}</div>{% endif %}
          </div>
          {% endif %}

          {#
            Цена и наличие для поисковика (schema.org/Offer). Без этих двух строк
            Яндекс и Google показывают товар голой ссылкой, а с ними - с ценой
            и пометкой «в наличии» прямо в выдаче.

            Движок отдаёт цену уже готовой строкой («1 250,00 руб.»), а разметке
            нужно число. Поэтому строка чистится и ПРОВЕРЯЕТСЯ: если после чистки
            осталось не число или в исходной строке не было рубля (другая валюта,
            другой формат в настройках магазина) - блок не выводится совсем.
            Пустая разметка лучше неверной цены: за цену в выдаче, которой нет
            на сайте, Яндекс наказывает магазин, а не разметку.
          #}
          {% set price_shown = special ? special : price %}
          {#
            Пробел между числом и «руб» может прийти не символом, а текстом
            «&nbsp;»: так записан знак валюты в настройках магазина (фильтр
            OCFilter показывает его покупателю буквально - «13776&nbsp;руб»).
            В разметке страницы это пробел, а для разбора - шесть лишних
            знаков, и без них цена не распознавалась ни на одной карточке.
          #}
          {% set price_num = price_shown|replace({
            ' ': '', ' ': '', ' ': '', ' ': '',
            '&nbsp;': '', '&#160;': '', '&#xa0;': '', '&thinsp;': '', '&#8201;': '', '&#8239;': '',
            '₽': '', 'руб.': '', 'руб': '', 'р.': '', 'RUB': '', ',': '.'
          })|trim %}
          {% set price_ok = price_num matches '/^\\d+(\\.\\d+)?$/'
            and ('₽' in price_shown or 'руб' in price_shown or 'р.' in price_shown or 'RUB' in price_shown) %}
          {% if price_ok %}
          <div itemprop="offers" itemscope itemtype="https://schema.org/Offer">
            <meta itemprop="price" content="{{ price_num }}">
            <meta itemprop="priceCurrency" content="RUB">
            {#
              Наличие берётся только там, где его видно наверняка: число
              остатка (это включено в настройках) или две готовые строки
              самого движка. Проверка на «Нет» идёт первой - «Нет в наличии»
              тоже содержит слово «наличии», и без этого порядка товар,
              которого нет, уезжал бы в выдачу как имеющийся.
            #}
            {% if stock matches '/^\\d+$/' %}
            <link itemprop="availability" href="https://schema.org/{{ stock > 0 ? 'InStock' : 'OutOfStock' }}">
            {% elseif 'Нет' in stock %}
            <link itemprop="availability" href="https://schema.org/OutOfStock">
            {% elseif 'наличии' in stock %}
            <link itemprop="availability" href="https://schema.org/InStock">
            {% endif %}
          </div>
          {% endif %}

          {% if options %}
          <div class="product-options">
            {% for option in options %}
            <div class="form__row{% if option.required %} required{% endif %}">
              <label for="option-{{ option.product_option_id }}">{{ option.name }}</label>
              {% if option.type == 'select' %}
              <select class="select" id="option-{{ option.product_option_id }}" name="option[{{ option.product_option_id }}]">
                <option value="">— выберите —</option>
                {% for option_value in option.product_option_value %}
                <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}{% if option_value.price %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}</option>
                {% endfor %}
              </select>
              {% elseif option.type == 'radio' or option.type == 'checkbox' %}
              <div class="option-list">
                {% for option_value in option.product_option_value %}
                <label class="consent">
                  <input type="{{ option.type }}" name="option[{{ option.product_option_id }}]{% if option.type == 'checkbox' %}[]{% endif %}" value="{{ option_value.product_option_value_id }}">
                  <span>{{ option_value.name }}{% if option_value.price %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}</span>
                </label>
                {% endfor %}
              </div>
              {% elseif option.type == 'textarea' %}
              <textarea id="option-{{ option.product_option_id }}" name="option[{{ option.product_option_id }}]" rows="4">{{ option.value }}</textarea>
              {% else %}
              <input id="option-{{ option.product_option_id }}" type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}">
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}

          <div class="qty" data-qty>
            <button type="button" data-qty-step="-1" aria-label="Уменьшить количество">−</button>
            <label class="visually-hidden" for="qty">Количество</label>
            <input id="qty" name="quantity" type="text" inputmode="numeric" value="{{ minimum }}" autocomplete="off">
            <button type="button" data-qty-step="1" aria-label="Увеличить количество">+</button>
          </div>
          <button class="btn btn--action btn--lg" type="submit">В корзину</button>
          {% if minimum > 1 %}<p class="calc__hint">{{ text_minimum }}</p>{% endif %}
        </form>

        <div class="product-actions">
          <button class="action-link" type="button" data-add="fav" data-product-id="{{ product_id }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-9.4A3.9 3.9 0 0 1 12 7.2 3.9 3.9 0 0 1 19 10.6c0 5-7 9.4-7 9.4Z"/></svg>В избранное</button>
          <button class="action-link" type="button" data-add="compare" data-product-id="{{ product_id }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 20V11M12 20V4M18 20v-6"/></svg>К сравнению</button>
          <button class="action-link" type="button" data-modal-open="modal-callback"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/></svg>Спросить о товаре</button>
        </div>
      </div>

    </div>

    <div class="tabs">
      <div class="tabs__list" role="tablist">
        <button class="tabs__btn" type="button" role="tab" data-tab="tab-desc" aria-selected="true" aria-controls="tab-desc">Описание</button>
        {% if attribute_groups %}<button class="tabs__btn" type="button" role="tab" data-tab="tab-specs" aria-selected="false" aria-controls="tab-specs">Характеристики</button>{% endif %}
        <button class="tabs__btn" type="button" role="tab" data-tab="tab-delivery" aria-selected="false" aria-controls="tab-delivery">Доставка и оплата</button>
      </div>

      <div class="tabs__panel" id="tab-desc" role="tabpanel">
        {% if description %}{{ description|raw }}{% else %}<p>Описание этого товара ещё не заполнено в учётной системе. Позвоните <a class="tel-inline" href="tel:+79638300999">8-963-830-09-99</a> — расскажем о товаре и подскажем, подойдёт ли он для вашей задачи.</p>{% endif %}
      </div>

      {% if attribute_groups %}
      <div class="tabs__panel" id="tab-specs" role="tabpanel" hidden>
        {% for attribute_group in attribute_groups %}
        <table class="spec-table">
          <caption>{{ attribute_group.name }}</caption>
          <tbody>
            {% for attribute in attribute_group.attribute %}
            <tr><th scope="row">{{ attribute.name }}</th><td>{{ attribute.text }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
        {% endfor %}
      </div>
      {% endif %}

      <div class="tabs__panel" id="tab-delivery" role="tabpanel" hidden>
        <p>Забрать товар можно в любом из трёх магазинов: два в Петропавловске-Камчатском и один в Елизово. Адреса и время работы — на странице <a href="index.php?route=information/contact">контактов</a>.</p>
        <p>Про доставку и способы оплаты спрашивайте по телефону <a class="tel-inline" href="tel:+79638300999">8-963-830-09-99</a>.</p>
      </div>
    </div>

    {% if products %}
    <section class="section section--tight">
      <div class="container">
        <div class="selection" data-slider>
          <div class="selection__head">
            <h2 class="section__title">Похожие товары</h2>
            <div class="selection__nav">
              <button class="slider-btn" type="button" data-slider-prev aria-label="Предыдущие товары"><svg class="icon-prev" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg></button>
              <button class="slider-btn" type="button" data-slider-next aria-label="Следующие товары"><svg class="icon-next" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg></button>
            </div>
          </div>
          <div class="selection__line" data-slider-line tabindex="0" role="group" aria-label="Похожие товары">
            {% for product in products %}
{# КАРТОЧКА: начало — собирается tools/make-cards.py, руками не править #}
          <article class="product-card reveal">
            <div class="product-card__media">
              {% if product.special %}<div class="product-card__badges"><span class="badge badge--sale">Скидка</span></div>{% endif %}
              <a class="product-card__photo" href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy" decoding="async"></a>
              <div class="product-card__tools">
                <button class="card-tool" type="button" data-add="fav" data-product-id="{{ product.product_id }}" aria-label="В избранное"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-9.4A3.9 3.9 0 0 1 12 7.2 3.9 3.9 0 0 1 19 10.6c0 5-7 9.4-7 9.4Z"/></svg></button>
                <button class="card-tool" type="button" data-add="compare" data-product-id="{{ product.product_id }}" aria-label="К сравнению"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 20V11M12 20V4M18 20v-6"/></svg></button>
              </div>
            </div>
            <div class="product-card__body">
              <a class="product-card__title" href="{{ product.href }}">{{ product.name }}</a>
            </div>
            <div class="product-card__bottom">
              {% if product.special %}<span class="price">{{ product.special }}</span><s class="price--old">{{ product.price }}</s>{% else %}<span class="price">{{ product.price }}</span>{% endif %}
              <button class="btn btn--action product-card__buy" type="button" data-add="cart" data-product-id="{{ product.product_id }}" aria-label="В корзину"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9.5" cy="19.5" r="1.6"/><circle cx="17" cy="19.5" r="1.6"/><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h8.6a1 1 0 0 0 1-.8L20 8H6"/></svg><span>В корзину</span></button>
            </div>
          </article>
{# КАРТОЧКА: конец #}
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
    {% endif %}

    {{ content_bottom }}
  </div>
{{ footer }}

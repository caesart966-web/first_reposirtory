{#
  Страница «Товары со скидкой».

  Отдельный шаблон понадобился не сразу: у движка есть МОДУЛЬ special
  (подборка на главной) и СТРАНИЦА product/special - это разные вещи
  с разными шаблонами. Я сделал только модуль, и страница открылась
  стандартной темой: чужая вёрстка посреди нашего сайта.

  Заголовка heading_title контроллер не отдаёт (проверено по исходнику),
  поэтому он задан здесь.
#}
{{ header }}
  <div class="container">

    {% if breadcrumbs %}
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><span itemprop="name">{{ breadcrumb.text }}</span><meta itemprop="position" content="{{ loop.index }}"></li>{% else %}<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a itemprop="item" href="{{ breadcrumb.href }}"><span itemprop="name">{{ breadcrumb.text }}</span></a><meta itemprop="position" content="{{ loop.index }}"></li>{% endif %}
        {% endfor %}
      </ol>
    </nav>
    {% endif %}

    <div class="page-head">
      <h1>Товары со скидкой</h1>
      {% if products %}<p>Цены уже со скидкой. Наличие уточняйте по телефону — часть товара разбирают в первые дни.</p>{% endif %}
    </div>

    {{ content_top }}

    {#
      Боковая колонка рисуется, только если ей есть что показать. Пустая
      рамка с надписью «Каталог» не просто некрасива: она занимает 280 px
      и отжимает товары вправо. На странице «Товары со скидкой» подразделов
      нет по определению, а в разделе без подразделов и без фильтров
      колонка тоже оказывалась пустой.

      Подпись и кнопка меняются по содержимому: «Разделы», когда внутри
      подразделы, «Фильтры», когда только модули движка.
    #}
    <div class="catalog-layout{% if not column_left %} catalog-layout--wide{% endif %}">

      {% if column_left %}
      <aside class="filters" data-filters aria-label="Фильтры">
        <div class="filters__head">
          <h2>Фильтры</h2>
        </div>
        <button class="btn btn--outline btn--block filters-toggle" type="button" data-filters-toggle aria-expanded="true" aria-controls="filters-body">Показать фильтры</button>
        <div class="filters__body" id="filters-body">
          <div class="filter-group column-modules">
            {{ column_left }}
          </div>
        </div>
      </aside>
      {% endif %}

      <div>
        {% if products %}
        <div class="catalog-toolbar">
          <span class="catalog-toolbar__count">{{ results }}</span>
          <div class="catalog-toolbar__sort">
            <label for="sort">Сортировка</label>
            <select class="select" id="sort" data-go-on-change>
              {% for sorts_item in sorts %}
              <option value="{{ sorts_item.href }}"{% if sorts_item.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts_item.text }}</option>
              {% endfor %}
            </select>
            <div class="view-toggle" role="group" aria-label="Вид списка">
              <button type="button" data-view="grid" aria-pressed="true" aria-label="Плиткой"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/></svg></button>
              <button type="button" data-view="list" aria-pressed="false" aria-label="Списком"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
            </div>
          </div>
        </div>

        <div class="product-grid" data-product-grid>
          {% for product in products %}
{# КАРТОЧКА: начало — собирается tools/make-cards.py, руками не править #}
          <article class="product-card reveal">
            <div class="product-card__media">
              {% if product.special %}<div class="product-card__badges"><span class="badge badge--sale">Скидка</span></div>{% endif %}
              <a class="product-card__photo" href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy" decoding="async"></a>
              <div class="product-card__tools">
                <button class="card-tool" type="button" data-add="fav" data-product-id="{{ product.product_id }}" aria-label="В избранное"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-9.4A3.9 3.9 0 0 1 12 7.2 3.9 3.9 0 0 1 19 10.6c0 5-7 9.4-7 9.4Z"/></svg></button>
                <button class="card-tool" type="button" data-add="compare" data-product-id="{{ product.product_id }}" aria-label="К сравнению"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 20V11M12 20V4M18 20v-6"/></svg></button>
              </div>
            </div>
            <div class="product-card__body">
              <a class="product-card__title" href="{{ product.href }}">{{ product.name }}</a>
            </div>
            <div class="product-card__bottom">
              {% if product.special %}<span class="price">{{ product.special }}</span><s class="price-old">{{ product.price }}</s>{% else %}<span class="price">{{ product.price }}</span>{% endif %}
              <button class="btn btn--action product-card__buy" type="button" data-add="cart" data-product-id="{{ product.product_id }}" aria-label="В корзину"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9.5" cy="19.5" r="1.6"/><circle cx="17" cy="19.5" r="1.6"/><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h8.6a1 1 0 0 0 1-.8L20 8H6"/></svg><span>В корзину</span></button>
            </div>
          </article>
{# КАРТОЧКА: конец #}
          {% endfor %}
        </div>

        {{ pagination }}
        {% else %}
        <div class="empty">
          <h2>Сейчас скидок нет</h2>
          <p>Акции у нас бывают регулярно — загляните позже или спросите по телефону <a class="tel-inline" href="tel:+79638300999">8-963-830-09-99</a>: иногда цену снижают на месте, не вынося в акцию.</p>
          <p class="row-actions"><a class="btn btn--action" href="{{ continue }}">В каталог</a></p>
        </div>
        {% endif %}
      </div>

    </div>

    {{ content_bottom }}
  </div>
{{ footer }}

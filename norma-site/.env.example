# Настройки приёма заявок. Скопируйте этот файл в .env и заполните.
# На GitHub Pages (превью) их можно не задавать: форма честно покажет
# телефон и мессенджеры вместо ложного «заявка отправлена».

# Куда форма отправляет заявку. На своём хостинге с PHP — это /api/submit.php
PUBLIC_LEAD_ENDPOINT=/api/submit.php

# Пароль формы. Такой же нужно вписать в public/api/submit.php → FORM_TOKEN.
# Секретом не является (виден в коде страницы), но отсекает ботов.
PUBLIC_LEAD_TOKEN=norma-lead

# Адрес сайта и путь. Для боевого домена:
#   SITE_URL=https://ваш-домен.ru
#   BASE_PATH=/
# Для превью на GitHub Pages:
#   SITE_URL=https://caesart966-web.github.io
#   BASE_PATH=/first_reposirtory/norma/
#   PUBLIC_NOINDEX=1
SITE_URL=https://example.ru
BASE_PATH=/

# 1 — закрыть сайт от поисковиков (для черновика и превью). Пусто — открыть.
PUBLIC_NOINDEX=

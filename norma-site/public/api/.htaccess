# Журнал заявок и служебные файлы этой папки нельзя читать из браузера.
# Сам обработчик submit.php остаётся доступным.
#
# Это ВТОРОЙ рубеж, а не единственный: .htaccess действует только на Apache,
# а многие хостинги отдают статику через nginx и этот файл не читают.
# Поэтому журнал заодно назван leads.log.php и начинается с «<?php exit; ?>» —
# такой файл не отдаст содержимое ни при каком сервере.
<FilesMatch "^leads\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(jsonl|log)$">
  Require all denied
</FilesMatch>

---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Calculator from '../components/Calculator.astro'
import ComparisonTable from '../components/ComparisonTable.astro'
import RegistryCheck from '../components/RegistryCheck.astro'
import SpecialOffer from '../components/SpecialOffer.astro'
import WhyMe from '../components/WhyMe.astro'
import ServicesGrid from '../components/ServicesGrid.astro'
import LeadForm from '../components/LeadForm.astro'
import Icon from '../components/Icon.astro'
import { SITE, href } from '../config/site'
import { REGIONS } from '../config/regions'
import { partnersOf } from '../config/partners'
import { LAW, TERMS, FUNDS } from '../config/facts'
import { FEES, FEES_NOTE, money } from '../config/fees'

// Порядок работы.
//
// У каждого шага сказано не только сколько он длится, но и ЧЬЁ это время.
// Без этого шаги читались как одна очередь и складывались в 5–10 дней —
// притом что в шапке сайта стоит «выписка за 2–3 дня». Посетитель,
// который умеет считать, ловил сайт на расхождении, а расхождение здесь
// дороже, чем на любом другом сайте: весь текст держится на том, что
// цифры можно проверить.
//
// Расхождения на самом деле нет: два-три дня — это последний отрезок,
// от подачи до выписки. Но читателю это надо показать, а не объяснять
// в примечании. Поэтому подпись «чьё время» и строка с итогом под лентой.
// Города для блока «География». Порядок — как в regions.ts: Петербург,
// Москва, Ростов-на-Дону. Раньше здесь была сортировка по алфавиту,
// и она была обоснована: городов было тридцать три, и любой другой
// порядок выдумывал бы рейтинг. Для троих алфавит не значит ничего,
// а порядок из конфигурации хотя бы один — и правится в одном месте.
const cities = REGIONS

const steps = [
  {
    t: 'Разбор ситуации',
    d: 'Смотрю, что за работы, с кем договор и на какую сумму. Если членство не требуется — говорю об этом сразу и работу не начинаю.',
    time: '15–30 минут',
    who: 'моё время',
  },
  {
    t: 'Подбор СРО и проверка',
    d: 'Подбираю СРО под ваш регион и уровень ответственности, проверяю её в госреестре и показываю выписку вам. Для строителей действует региональный принцип, для проектировщиков и изыскателей — нет.',
    time: '1–2 дня',
    who: 'моё время',
  },
  {
    t: 'Подготовка документов',
    d: 'Заявление и все бумаги по комплекту оформляю я, и это бесплатно. Но пока от вас не пришли устав, выписка и документы по специалистам, собирать нечего — поэтому срок здесь задаёте вы. Прислали всё сразу — уложимся в день. Если чего-то не хватает или непонятно, где брать, — не бросаю на этом месте: скажу, где заказать, помогу восстановить и оформить.',
    time: '2–5 дней',
    who: 'зависит от вас',
  },
  {
    t: 'Подача, взносы и выписка',
    d: `Подаю документы в СРО. Взносы вы переводите напрямую на её счёт, минуя меня. Дальше решение о приёме и выписка из реестра: от подачи до готовой выписки проходит ${TERMS.extract}, а когда у вас горит — бывает и ${TERMS.extractRush}. По закону у СРО есть на рассмотрение ${TERMS.law} — этот срок остаётся её правом, и обещать за неё я не могу. Но с полным комплектом документов до него не доходит.`,
    time: `${TERMS.extract}`,
    who: 'время СРО',
    law: LAW.term,
  },
]

// Разбивка взносов за первый год — строка таблицы «Стоимость» на главной.
//
// Каждая ячейка считается из FUNDS (компенсационные фонды, размеры в законе)
// и FEES (взносы конкретных СРО, закон их не устанавливает). Руками сюда
// не вписано ни одного числа: суммы обязаны сходиться с первым экраном
// и со страницей «Стоимость», а один раз они уже разошлись.
const feeCell = (v: string, cls?: string) => ({ v, cls })
const feeRows = (() => {
  const b = FEES.build
  const d = FEES.design
  const bFund = FUNDS.buildHarm[0]
  const dFund = FUNDS.designHarm[0]
  const bYear = b.memberMonth * 12
  const dYear = d.memberMonth * 12
  const insurance = (f: typeof b) =>
    f.insuranceFirstYear ? feeCell('по ставке страховщика') : feeCell(money(0), 'free-v')
  return [
    {
      t: 'Предельный размер обязательств',
      d: 'первый уровень ответственности, самый массовый',
      build: feeCell(bFund.limit),
      design: feeCell(dFund.limit),
    },
    {
      t: 'Компенсационный фонд возмещения вреда',
      d: 'однократно, размер установлен законом',
      build: feeCell(bFund.amount),
      design: feeCell(dFund.amount),
    },
    {
      t: 'Вступительный взнос',
      d: 'разовый, устанавливает СРО',
      build: feeCell(money(b.entry), b.entry === 0 ? 'free-v' : undefined),
      design: feeCell(money(d.entry), d.entry === 0 ? 'free-v' : undefined),
    },
    {
      t: 'Членские взносы за первый год',
      d: `${money(b.memberMonth)} в месяц, со второго года по ставке СРО`,
      build: feeCell(money(bYear)),
      design: feeCell(money(dYear)),
    },
    {
      t: 'Целевой взнос в национальное объединение',
      d: 'устанавливает СРО',
      build: feeCell(`${money(b.target)} в ${b.union}`),
      design: feeCell(`${money(d.target)} в ${d.union}`),
    },
    {
      t: 'Страхование ответственности',
      d: b.insuranceFirstYear ? 'требуется с первого года' : 'в первый год не требуется',
      build: insurance(b),
      design: insurance(d),
    },
    {
      t: 'Всего за первый год',
      d: '',
      total: true,
      build: feeCell(money(bFund.amountNum + b.entry + bYear + b.target)),
      design: feeCell(money(dFund.amountNum + d.entry + dYear + d.target)),
    },
  ]
})()

const faq = [
  {
    q: 'Существуют ли ещё допуски СРО?',
    a: 'Нет. Свидетельства о допуске к работам отменены с 1 июля 2017 года законом 372-ФЗ. Право выполнять работы подтверждается самим членством в СРО и выпиской из реестра членов. Если вам предлагают «оформить допуск СРО» — это либо разговорный оборот, либо признак того, что человек не следит за законодательством.',
  },
  {
    q: 'Правда ли, что порог для строителей — 3 млн ₽?',
    a: 'Нет, это устаревшая информация. Порог поднят до 10 млн ₽ законом 124-ФЗ с 1 мая 2022 года. Цифру в 3 млн до сих пор пишет примерно половина сайтов по теме — это самый простой способ проверить, следит ли площадка за изменениями.',
  },
  {
    q: 'Можно ли вступить в СРО другого региона?',
    a: 'Для строителей — по общему правилу нет: СРО должна быть зарегистрирована в том же субъекте РФ, что и компания. Если подходящей СРО в вашем регионе нет, допускается вступление в СРО соседнего субъекта. А вот для проектировщиков и изыскателей региональной привязки не существует вовсе — они выбирают СРО в любом регионе. Эту разницу путают даже крупные площадки.',
  },
  {
    q: 'Сколько времени занимает вступление?',
    a: `По закону у СРО есть на рассмотрение заявления ${TERMS.law}, и этот срок остаётся её правом. На практике с правильно собранным комплектом документов от подачи до готовой выписки из реестра проходит ${TERMS.extract}. Если у вас горит — скажите сразу: подам в тот же день и попрошу рассмотреть вне очереди, и тогда бывает и ${TERMS.extractRush}. Но именно бывает: обещать за СРО её собственное решение я не стану, и разница между «бывает за день» и «гарантируем за день» здесь принципиальная.`,
  },
  {
    q: 'Какие взносы придётся платить и когда?',
    a: 'При вступлении — взнос в компенсационный фонд возмещения вреда (обязателен всем) и вступительный взнос СРО. Для участия в конкурентных закупках дополнительно нужен взнос в компенсационный фонд обеспечения договорных обязательств. Дальше идут членские взносы — в первый год 5 000 ₽ в месяц, платить можно за месяц, квартал, полгода или год. Со второго года они не исчезают, это регулярный платёж, и я говорю об этом сразу. Полная разбивка со ссылками на нормы — на странице «Стоимость».',
  },
  {
    q: 'У меня нет двух специалистов для НРС. Что делать?',
    a: 'Помогу найти и трудоустроить специалистов, отвечающих требованиям, и подготовлю документы для внесения их в реестр. Обратите внимание на формулировки конкурентов: «предоставим специалистов» означает фиктивное трудоустройство — это серая схема, при проверке она приводит к исключению из СРО. Специалисты должны реально работать в вашей компании.',
  },
  {
    q: 'Чем вы отличаетесь от других?',
    a: 'Тем, что говорю «вам это не нужно», когда это действительно так, и показываю норму, на которую опираюсь. И тем, что все цифры на этом сайте сверены с действующей редакцией Градостроительного кодекса — дата сверки указана внизу каждой страницы.',
  },
]

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const howToSchema = {
  '@type': 'HowTo',
  name: 'Как вступить в СРО',
  description: 'Порядок вступления в саморегулируемую организацию строителей, проектировщиков или изыскателей.',
  step: steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.t,
    text: s.d,
  })),
}
---

<Base
  title="Вступление в СРО — строителям и проектировщикам | НОРМА"
  description="От подачи до выписки из реестра 2–3 дня, подготовка документов и сопровождение бесплатно. Калькулятор покажет, нужна ли вам СРО, — со ссылкой на статью закона."
  schema={[faqSchema, howToSchema]}
>
  <Hero />

  <Calculator />

  <SpecialOffer />

  <!-- Кому нужна / кому нет -->
  <section class="section section--paper section--split" id="komu" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Без умолчаний</span>
        <h2>Кому нужна СРО, <em>а кому нет</em></h2>
        <p>
          Оба столбца одинаково важны. Правый — тот, который обычно прячут:
          на нём не заработать, но именно он экономит компаниям сотни тысяч рублей.
        </p>
      </div>
      <div class="sbody">
        <div class="rv"><ComparisonTable brief /></div>
        <p class="more rv">
          <a href={href('/komu-nuzhna-sro/')}>Каждый случай подробно: что считается договором, где проходит порог →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Стоимость: тизер -->
  <section class="section section--dark" id="stoimost-teaser" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Стоимость</span>
        <h2>Открыто: из чего складываются <em>расходы</em></h2>
        <p>
          Платите вы только установленные законом и СРО взносы — и платите их
          напрямую в СРО, минуя меня.
        </p>
      </div>

      {/* РАЗБИВКА — ОДНОЙ ТАБЛИЦЕЙ, А НЕ ДВУМЯ ОДИНАКОВЫМИ КАРТОЧКАМИ.
          Карточки «Строителям» и «Проектировщикам» отличались двумя числами
          из шести и на телефоне вставали одна под другой: 1310 px, полтора
          экрана на то, чтобы прочитать один и тот же список дважды, —
          и сравнить суммы было нельзя, они не помещались в поле зрения
          вместе. Таблица показывает те же шесть строк один раз, а ниже
          600 px разворачивается в карточки по СТРОКЕ: сверху взнос,
          под ним обе суммы с подписями. Сравнение появилось, высота
          вдвое меньше.
          Все суммы считаются из FUNDS и FEES — руками сюда не вписывается
          ни одна, иначе заводится вторая точка правды. */}
      <div class="cost-split">
      <div class="tbl-wrap dark rv">
        <table class="data fees-tbl">
          <thead>
            <tr>
              <th scope="col">Взнос</th>
              <th scope="col">Строителям</th>
              <th scope="col">Проектировщикам и изыскателям</th>
            </tr>
          </thead>
          <tbody>
            {feeRows.map((row) => (
              <tr class={row.total ? 'tr-total' : undefined}>
                <td class="strong">
                  {row.t}
                  {row.d && <small>{row.d}</small>}
                </td>
                <td class:list={[row.build.cls, row.total && 'tot']} data-label="Строителям">{row.build.v}</td>
                <td class:list={[row.design.cls, row.total && 'tot']} data-label="Проектировщикам и изыскателям">{row.design.v}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="pcard pcard--warn rv">
        <span class="ptag ptag--warn">Идёте на торги</span>
        <h3>Нужен второй взнос — КФ ОДО</h3>
        <p class="psub">Компенсационный фонд обеспечения договорных обязательств</p>
        <ul>
          <li><span>Строителям, первый уровень<small>сверх взноса выше, не вместо</small></span><b>{FUNDS.buildContract[0].amount}</b></li>
          <li><span>Проектировщикам и изыскателям<small>первый уровень</small></span><b>{FUNDS.designContract[0].amount}</b></li>
        </ul>
        <p class="pnote">
          Без этого взноса заявку на конкурентных закупках отклонят. Именно о нём
          молчат сайты с обещанием «без скрытых платежей».
        </p>
        {/* Кнопка вела на #torgi — якорь, которого на странице нет.
            Внешне работала: нажатие просто ничего не делало, и поймать
            это глазами нельзя. Ведёт в разбор, который и обещает. */}
        <a class="btn btn--ghost-dark" href={href('/baza-znaniy/otkaz-na-torgah/')}>Три причины отказа на торгах</a>
      </div>
      </div>

      <p class="fees-note rv">{FEES_NOTE}</p>

      <div class="cost-cta rv">
        <a class="btn btn--acc" href={href('/stoimost/#kalkulyator')}>Посчитать свой уровень</a>
        <a class="cost-cta-more" href={href('/stoimost/')}>Все уровни ответственности →</a>
      </div>
    </div>
  </section>

  <!-- Как проходит вступление -->
  <section class="section section--split" id="process" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Порядок работы</span>
        <h2>Как проходит <em>вступление</em></h2>
        <p>Сроки реальные, а не рекламные: там, где закон даёт два месяца, я так и пишу.</p>
      </div>

      <div class="sbody">
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="rv">
            <span class="sn">{i + 1}</span>
            <div class="sc">
              <div class="sc-top">
                <h3>{s.t}</h3>
                <span class="stime">{s.time}</span>
                <span class="swho">{s.who}</span>
              </div>
              <p>{s.d}</p>
              {s.law && <span class="law">{s.law}</span>}
            </div>
          </li>
        ))}
      </ol>

      <!-- Абзац существует ради одного: свести 5–10 дней здесь с «выпиской
           за 2–3 дня» в шапке сайта. Всё остальное, что тут стояло раньше,
           страница уже говорит — «помогу собрать недостающее» шагом 3,
           а разницу между «бывает за день» и «гарантируем за день» —
           вопросом «Сколько времени занимает вступление» ниже. -->
      <p class="steps-total rv">
        <b>Итого от первого разговора до выписки — 5–10 дней.</b> Два-три дня из них
        занимает последний шаг: от подачи документов до готовой выписки. Остальное —
        подбор СРО и сбор бумаг, и здесь темп задаёте вы. Рекламного «вступления
        за один день» не обещаю: один день <b>бывает</b>, но решение принимает СРО,
        и срок на него — её, а не мой.
      </p>
      </div>
    </div>
  </section>

  <RegistryCheck />

  <!-- География: раздел «Города».
       Стоит на главной, а не только в подвале и в меню: городские страницы
       отвечают на запросы вида «вступить в СРО в Москве», и без входящей
       ссылки с самой сильной страницы сайта они остаются на отшибе.
       Заодно это единственное место на главной, где сказано, что регион
       вообще имеет значение — и только для строителей. -->
  <section class="section section--split" id="goroda" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">География</span>
        <h2>Ваш город <em>и ваш регион</em></h2>
        <p>
          Работаю по всей России: документы электронные, приезжать никуда не нужно.
          Но у строителей регион решает — саморегулируемая организация должна быть
          зарегистрирована в том же субъекте РФ, что и компания.
        </p>
        <span class="law">{LAW.membership}</span>
      </div>
      <div class="sbody">
        <p class="geo-lead rv">
          У проектировщиков и изыскателей такой привязки нет вовсе: они выбирают
          организацию в любом регионе страны. Разницу путают даже крупные площадки —{' '}
          <a href={href('/baza-znaniy/regionalnyy-princip/')}>разбор нормы со ссылками</a>.
        </p>

        {/* Три города, где есть партнёрские СРО, — карточками, а не строчками
            в списке: их трое, и каждый говорит своё. Список-реестр из тридцати
            трёх городов, стоявший здесь раньше, для троих выглядел бы обрезанным
            и наводил на мысль, что остальные потерялись. */}
        <ul class="geo-cards rv">
          {cities.map((r) => {
            const n = partnersOf(r.slug).length
            return (
              <li>
                <a href={href(`/sro/${r.slug}/`)}>
                  <span class="gc-city">{r.city}</span>
                  <span class="gc-sub">{r.subject} · код {r.code}</span>
                  <span class="gc-n">
                    {n} {n === 1 ? 'партнёрская СРО' : n < 5 ? 'партнёрские СРО' : 'партнёрских СРО'}
                  </span>
                  <span class="gc-go">Разбор по городу →</span>
                </a>
              </li>
            )
          })}
        </ul>

        {/* Главное, что должен унести человек не из этих трёх городов.
            Раньше на его вопрос отвечал список из тридцати трёх городов;
            теперь — эта строка, и она обязана быть заметной, иначе
            раздел читается как «работаю только в трёх городах». */}
        <div class="geo-rest rv">
          <p>
            <b>Остальные регионы — так же.</b> Партнёрские организации у меня
            в трёх городах, а для компании из любого другого субъекта я подбираю
            СРО отдельно — и называю её по имени и с регистрационным номером
            до того, как вы что-то подпишете. Фраза «работаю по всей России»
            выше — не оборот речи: приезжать никуда не нужно ни вам, ни мне,
            документы электронные.
          </p>
          <p class="geo-rest-more">
            <a href={href('/sro/')}>Как это работает в вашем регионе →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <WhyMe />

  <ServicesGrid compact title="Что я делаю" />

  <!-- FAQ -->
  <section class="section section--paper section--split" id="faq" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Вопросы</span>

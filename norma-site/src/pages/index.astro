</Base>

<style>
  /* Честный блок */

  .more { margin-top: 18px; font-size: 15px; font-weight: 600; }

  /* География. Три города — карточками на линейках, а не облаком тегов
     и не списком-реестром: реестр из трёх строк выглядит обрезанным
     списком, будто остальные потерялись. Тонкие линейки — та же графика,
     что у таблиц на «Стоимости». */
  .geo-lead { max-width: 68ch; color: var(--muted); }
  .geo-cards {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .geo-cards li { border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); }
  .geo-cards li:last-child { border-right: 0; }
  .geo-cards a {
    display: grid;
    align-content: start;
    gap: 3px;
    padding: 18px 20px 18px 0;
    text-decoration: none;
    color: var(--ink);
    height: 100%;
  }
  .geo-cards li:not(:first-child) a { padding-left: 20px; }
  .gc-city { font-family: var(--font-head); font-size: 21px; line-height: 1.15; }
  .gc-sub { font-size: 13px; color: var(--muted); }
  .gc-n {
    margin-top: 7px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--acc-deep);
  }
  .gc-go {
    margin-top: 10px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--acc-deep);
  }
  .geo-cards a:hover .gc-go { text-decoration: underline; }

  /* Строка для всех остальных регионов. Она заметная нарочно: раньше
     на вопрос «а мой город?» отвечал список из тридцати трёх городов,
     теперь отвечает только этот абзац, и потеряться ему нельзя. */
  .geo-rest {
    margin-top: 22px;
    padding: 18px 20px;
    background: var(--paper-2);
    border-left: 3px solid var(--acc);
    border-radius: 0 var(--r-s) var(--r-s) 0;
  }
  .geo-rest p { margin: 0; font-size: 15px; line-height: 1.65; color: var(--muted); }
  .geo-rest b { color: var(--ink); }
  .geo-rest-more { margin-top: 10px !important; font-weight: 600; }
  .geo-rest-more a { color: var(--acc-deep); text-decoration: none; }
  .geo-rest-more a:hover { text-decoration: underline; }

  @media (max-width: 599px) {
    .geo-cards li { border-right: 0; }
    .geo-cards a, .geo-cards li:not(:first-child) a { padding: 16px 0; }
  }
  .geo-cities {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0 26px;
    border-top: 1px solid var(--line);
  }
  .geo-cities li { border-bottom: 1px solid var(--line); }
  .geo-cities a {
    display: block;
    padding: 10px 2px;
    font-size: 15px;
    color: var(--ink);
    text-decoration: none;
  }
  .geo-cities a:hover { color: var(--acc-deep); }

  /* На телефоне список встаёт в две колонки и получается семнадцать строк.
     Поэтому строки здесь ниже: 38 px вместо 40 — всё ещё больше нормы
     в 24 px для попадания пальцем, но блок короче почти на экран. */
  @media (max-width: 599px) {
    .geo-cities { gap: 0 18px; }
    .geo-cities a { padding: 8px 2px; font-size: 14.5px; }
  }

  /* Стоимость-тизер: таблица разбивки плюс карточка-предупреждение о КФ ОДО.
     Цвета тёмной таблицы — общие, в global.css. Здесь только то, чего
     у обычной table.data нет: подпись под названием взноса и строка итога. */
  .fees-tbl td.strong small {
    display: block;
    margin-top: 3px;
    font-weight: 400;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--on-dark-muted);
  }
  /* Названию взноса — половина ширины, суммам хватает четверти: они короткие.
     По умолчанию колонки делились поровну, и «Предельный размер обязательств»
     ломался на две строки рядом с «до 90 млн ₽» — строка вырастала вдвое
     из-за пустоты справа. */
  /* Только пока таблица — таблица. Ниже 600 px строка разворачивается
     в карточку, ячейки становятся блоками, и заданная ширина зажимает
     их в 46 % экрана: раздел вырос с 2,75 до 3,58 экрана телефона,
     то есть правка «чтобы не переносилось» на компьютере сломала
     ровно то, ради чего таблица и затевалась. */
  @media (min-width: 600px) {
    .fees-tbl th:first-child, .fees-tbl td:first-child { width: 46%; }
    .fees-tbl th:not(:first-child), .fees-tbl td:not(:first-child) { width: 27%; }
  }
  .fees-tbl .tr-total td { border-top: 1px solid var(--dark-line); }
  .fees-tbl td.tot { color: var(--acc-bright); font-weight: 600; font-size: 17px; }
  .fees-tbl td { font-variant-numeric: lining-nums tabular-nums; }
  /* Зелёный «0 ₽» на графите: обычный --good здесь не читается. */
  .fees-tbl .free-v { color: var(--good-bright); }

  @media (max-width: 599px) {
    /* В карточке строки название взноса — заголовок, и подпись под ним
       не должна тянуть карточку вверх: у первой ячейки свои отступы. */
    .fees-tbl td.strong small { margin-top: 2px; }
    .fees-tbl td.tot { font-size: 18px; }
  }

  /* Таблица и предупреждение про КФ ОДО — рядом, пока хватает ширины.
     Когда карточка встала ПОД таблицу на всех экранах, раздел на компьютере
     вырос с 1181 до 1479 px: выигрыш от таблицы съела пустота справа от неё.
     Ниже 900 px они всё равно идут друг за другом, и это правильно:
     таблица к этой ширине уже развернулась в карточки по строкам.
     Отступ сверху — под ярлык «Идёте на торги»: он вынесен за верхний
     край карточки на 40 px и без запаса налезал бы на соседа. */
  .cost-split { display: grid; gap: 16px; align-items: start; }
  .pcard--warn { margin-top: 56px; }
  @media (min-width: 900px) {
    .cost-split { grid-template-columns: minmax(0, 1.9fr) minmax(270px, 1fr); gap: 26px; }
    .pcard--warn { margin-top: 44px; }
  }

  .pcard {
    background: var(--card);
    color: var(--ink);
    border-radius: var(--r-l);
    padding: 26px 24px 24px;
    display: grid;
    gap: 12px;
    align-content: start;
    /* Замер ширины карточки для правила ниже. Считаем в em, поэтому если
       посетитель увеличил размер текста в браузере, карточка «сужается»
       в этих единицах и строки перестраиваются, а не вылезают за край. */
    container-type: inline-size;
  }
  .ptag {
    justify-self: center;
    margin-top: -40px;
    background: var(--acc-btn);
    color: #fff;
    font-weight: 700;
    font-size: 13.5px;
    padding: 8px 20px;
    border-radius: 999px;
    text-align: center;
  }
  .ptag--warn { background: #B4231F; }
  .pcard h3 { font-size: 19px; margin: 4px 0 0; text-align: center; }
  .psub { font-size: 13.5px; color: var(--muted); text-align: center; margin-bottom: 6px; }
  .pcard ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .pcard li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: baseline; font-size: 15px; }
  .pcard li span { display: grid; gap: 2px; }
  .pcard li small { color: var(--muted); font-size: 12.5px; line-height: 1.4; }
  .pcard li > b { font-variant-numeric: lining-nums tabular-nums; white-space: nowrap; font-size: 16px; }
  .free-v { color: var(--good); }
  .warn-v { color: #B4231F; font-weight: 600; font-size: 14px !important; }
  .muted-v { color: var(--muted); font-weight: 500; font-size: 14px !important; }
  .ptotal { border-top: 1px solid var(--line); padding-top: 14px; }
  .ptotal > b { color: var(--acc-deep); font-size: 22px !important; }

  /* Крупный текст: название и сумма встают друг под другом.
     Иначе на узкой колонке длинное слово не помещается рядом с цифрой. */
  @container (max-width: 13em) {
    .pcard li { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .pcard li > b { justify-self: start; }
  }
  .pnote { font-size: 13.5px; color: var(--muted); line-height: 1.55; }
  .pcard .btn { justify-self: stretch; margin-top: 4px; }
  .pcard--warn { background: var(--dark-2); color: var(--on-dark); }
  .pcard--warn h3 { color: #fff; }
  .pcard--warn .psub, .pcard--warn li small, .pcard--warn .pnote { color: var(--on-dark-muted); }
  .pcard--warn li > b { color: #fff; }

  .cost-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .cost-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--dark-line);
    border-radius: var(--r-l);
    padding: 22px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .cost-card--accent { border-color: color-mix(in srgb, var(--acc-bright) 45%, transparent); background: color-mix(in srgb, var(--acc-bright) 7%, transparent); }
  .cc-ic {
    width: 38px; height: 38px;
    border-radius: var(--r-s);
    background: color-mix(in srgb, var(--acc-bright) 15%, transparent);
    color: var(--acc-bright);
    display: grid; place-items: center;
  }
  .cost-card h3 { color: #fff; font-size: 16.5px; }
  .cost-card p { color: var(--on-dark-muted); font-size: 14.5px; }
  .cost-card p b { color: #fff; }
  .cost-card .law { justify-self: start; }
  .cost-cta { display: flex; align-items: center; gap: 16px 22px; flex-wrap: wrap; margin-top: 22px; }
  .cost-cta span { color: var(--on-dark-muted); font-size: 14px; }
  .cost-cta-more {
    color: var(--acc-bright);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    /* Поле промаха: строка 20 px, норма попадания пальцем — 24. */
    padding: 6px 0;
  }
  .cost-cta-more:hover { text-decoration: underline; }

  /* Шаги */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .steps li { display: grid; grid-template-columns: 50px 1fr; gap: 20px; align-items: start; }
  .sn {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--acc-soft);
    color: var(--acc-deep);
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 17px;
    display: grid; place-items: center;
    position: relative;
    z-index: 1;
  }
  /* Первый шаг залит акцентом — глаз сразу находит начало ленты */
  .steps li:first-child .sn { background: var(--acc-btn); border-color: var(--acc-btn); color: #fff; }
  .steps li:not(:last-child) .sn::after {
    content: '';
    position: absolute;
    top: 46px; bottom: -30px;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: var(--line);
    z-index: 0;
  }
  .sc { padding-bottom: 26px; }
  .sc-top { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 6px; }
  .sc-top h3 { font-size: 18px; }
  .stime {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--acc-deep);
    background: var(--acc-soft);
    padding: 2px 9px;
    border-radius: 6px;
    white-space: nowrap;
  }
  .sc p { color: var(--muted); font-size: 15.5px; max-width: 74ch; }
  /* Подпись «чьё время» намеренно тише срока: срок — цифра, которую ищут,
     а подпись объясняет, почему цифры не складываются в одну очередь. */
  .swho {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--muted);
    white-space: nowrap;
  }
  .steps-total {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 15.5px;
    max-width: 74ch;
  }
  .steps-total b { color: var(--ink); }

  /* Статьи */
  .go { display: inline-flex; align-items: center; gap: 6px; font-size: 14.5px; font-weight: 600; color: var(--acc-deep); }

  /* Оговорка под ценами: обязательна везде, где показаны суммы СРО. */
  .fees-note {
    margin-top: 26px;
    max-width: 82ch;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--on-dark-muted);
  }

  /* FAQ.
     Раскрывается плавно, без JavaScript: interpolate-size разрешает браузеру
     анимировать переход к height: auto, который раньше был неанимируемым.
     Там, где браузер этого не умеет (пока это Safari), ответ просто
     появляется сразу — как и было. Ключевое слово allow-discrete нужно,
     чтобы вместе с высотой доехала и прозрачность: без него содержимое
     мигает в первом же кадре. */
  .faq { display: grid; gap: 10px; max-width: 900px; }
  .faq details {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    overflow: hidden;
    transition: border-color var(--t-mid) var(--ease);
  }
  .faq details:hover { border-color: color-mix(in srgb, var(--acc) 35%, var(--line)); }
  .faq details[open] { border-color: color-mix(in srgb, var(--acc) 45%, var(--line)); }
  .faq summary {
    padding: 18px 22px;
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: center;
    transition: color var(--t-fast) var(--ease);
  }
  .faq summary:hover { color: var(--acc-deep); }
  .faq summary::-webkit-details-marker { display: none; }
  /* Знак «плюс» из двух линеек. При раскрытии вертикальная линейка
     схлопывается по высоте, а знак доворачивается на пол-оборота —
     получается настоящий переход «плюс → минус», а не подмена одного
     символа другим рывком. Схлопывание делается анимацией background-size:
     у фоновых слоёв размер анимируется независимо. */
  .faq summary::after {
    content: '';
    width: 14px;
    height: 14px;
    flex: none;
    background-image:
      linear-gradient(var(--acc-deep), var(--acc-deep)),
      linear-gradient(var(--acc-deep), var(--acc-deep));
    background-position: center, center;
    background-repeat: no-repeat;
    background-size: 14px 1.5px, 1.5px 14px;
    transition:
      background-size var(--t-mid) var(--ease),
      transform var(--t-mid) var(--ease);
  }
  .faq details[open] summary::after {
    background-size: 14px 1.5px, 1.5px 0;
    transform: rotate(180deg);
  }

  /* Ответ выезжает плавно и без единой строки JavaScript.
     ::details-content — это само содержимое <details>, к которому раньше
     нельзя было обратиться из стилей; вместе с interpolate-size (задан
     в global.css на :root) браузер умеет анимировать переход к height: auto,
     который десятилетиями был неанимируемым. Где этого ещё нет (Safari),
     ответ просто раскрывается сразу — как и раньше. */
  .faq details::details-content {
    height: 0;
    overflow: hidden;
    transition:
      height var(--t-mid) var(--ease),
      content-visibility var(--t-mid) allow-discrete;
  }
  .faq details[open]::details-content { height: auto; }

  .faq .fa { padding: 0 22px 20px; }
  .faq .fa p { color: var(--muted); font-size: 15.5px; max-width: 76ch; }

  /* Контакты */
  .contacts-cta { background: var(--paper); }
  .cc-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; align-items: start; }
  .side {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-l);
    padding: 26px;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .side h3 { font-size: 17px; }
  .big-phone {
    font-family: var(--font-mono);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.2;
  }
  .big-phone:hover { color: var(--acc-deep); }
  .mail { color: var(--muted); text-decoration: none; font-size: 15px; }
  .mail:hover { color: var(--acc-deep); }
  .msg-list { display: grid; gap: 8px; }
  .msg-list a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-s);
  }
  .msg-list a:hover { border-color: var(--acc-btn); color: var(--acc-deep); }

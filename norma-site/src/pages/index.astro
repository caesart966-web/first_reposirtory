  }
  .gc-go { margin-top: 10px; font-size: 13.5px; font-weight: 600; color: var(--acc-deep); }
  .geo-cards li:hover .gc-go { text-decoration: underline; }

  /* Рейка заголовка — сетка, и чип без этого растягивался во всю её ширину. */
  #goroda .s-head .law { justify-self: start; }

  .geo-rest {
    margin-top: 22px;
    padding: 16px 20px;
    background: var(--card);
    border-left: 3px solid var(--acc);
    border-radius: 0 var(--r-s) var(--r-s) 0;
  }
  .geo-rest p { margin: 0; font-size: 15px; line-height: 1.65; color: var(--muted); }
  .geo-rest b { color: var(--ink); }
  .geo-rest-more { margin-top: 8px !important; font-weight: 600; }
  .geo-rest-more a { color: var(--acc-deep); text-decoration: none; }
  .geo-rest-more a:hover { text-decoration: underline; }

  @media (max-width: 599px) {
    .geo-cards li { border-right: 0; }
    .geo-cards .gc, .geo-cards li:not(:first-child) .gc { padding: 15px 0; }
  }

  @media (max-width: 640px) {
    .s4-cta .btn { width: 100%; }
  }
</style>

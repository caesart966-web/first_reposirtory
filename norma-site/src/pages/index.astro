---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Calculator from '../components/Calculator.astro'
import TenderRejects from '../components/TenderRejects.astro'
import ComparisonTable from '../components/ComparisonTable.astro'
import RegistryCheck from '../components/RegistryCheck.astro'
import BonusOffer from '../components/BonusOffer.astro'
import WhyMe from '../components/WhyMe.astro'
import ServicesGrid from '../components/ServicesGrid.astro'
import LeadForm from '../components/LeadForm.astro'
import Icon from '../components/Icon.astro'
import { getCollection } from 'astro:content'
import { SITE, href } from '../config/site'
import { LAW, TERMS } from '../config/facts'

const articles = (await getCollection('articles'))
  .sort((a, b) => (b.data.updated ?? b.data.published).getTime() - (a.data.updated ?? a.data.published).getTime())
  .slice(0, 3)

const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })

const steps = [
  {
    t: 'Разбор ситуации',
    d: 'Смотрю, что за работы, с кем договор и на какую сумму. Если членство не требуется — говорю об этом сразу и работу не начинаю.',
    time: '15–30 минут',
  },
  {
    t: 'Подбор СРО и проверка',
    d: 'Подбираю СРО под ваш регион и уровень ответственности, проверяю её в госреестре и показываю выписку вам. Для строителей действует региональный принцип, для проектировщиков и изыскателей — нет.',
    time: '1–2 дня',
  },
  {
    t: 'Подготовка документов',
    d: 'Собираю комплект: заявление, учредительные документы, документы по специалистам НРС, справки. Это моя часть работы, и она бесплатна.',
    time: '2–5 дней',
  },
  {
    t: 'Подача и решение СРО',
    d: `Заявление рассматривается ${TERMS.law} по закону. На практике при готовом комплекте решение принимается за считаные дни.`,
    time: 'до 2 месяцев по закону',
  },
  {
    t: 'Взносы и выписка',
    d: `Взносы вы переводите напрямую в СРО. После оплаты компенсационного фонда получаю выписку из реестра — за ${TERMS.extract}.`,
    time: TERMS.extract,
  },
]

const faq = [
  {
    q: 'Существуют ли ещё допуски СРО?',
    a: 'Нет. Свидетельства о допуске к работам отменены с 1 июля 2017 года законом 372-ФЗ. Право выполнять работы подтверждается самим членством в СРО и выпиской из реестра членов. Если вам предлагают «оформить допуск СРО» — это либо разговорный оборот, либо признак того, что человек не следит за законодательством.',
  },
  {
    q: 'Правда ли, что порог для строителей — 3 млн ₽?',
    a: 'Нет, это устаревшая информация. Порог поднят до 10 млн ₽ законом 124-ФЗ с 1 мая 2022 года. Цифру в 3 млн до сих пор пишет примерно половина сайтов по теме — это самый простой способ проверить, следит ли площадка за изменениями.',
  },
  {
    q: 'Можно ли вступить в СРО другого региона?',
    a: 'Для строителей — по общему правилу нет: СРО должна быть зарегистрирована в том же субъекте РФ, что и компания. Если подходящей СРО в вашем регионе нет, допускается вступление в СРО соседнего субъекта. А вот для проектировщиков и изыскателей региональной привязки не существует вовсе — они выбирают СРО в любом регионе. Эту разницу путают даже крупные площадки.',
  },
  {
    q: 'Сколько времени занимает вступление?',
    a: `По закону заявление рассматривается ${TERMS.law}. На практике, когда документы подготовлены правильно, решение принимается за несколько дней, а выписку из реестра я получаю за ${TERMS.extract} после решения и оплаты взноса.`,
  },
  {
    q: 'Какие взносы придётся платить и когда?',
    a: 'При вступлении — взнос в компенсационный фонд возмещения вреда (обязателен всем) и вступительный взнос СРО. Для участия в конкурентных закупках дополнительно нужен взнос в компенсационный фонд обеспечения договорных обязательств. Дальше ежегодно платятся членские взносы — они не исчезают со второго года, это регулярный платёж, и я говорю об этом сразу. Полная разбивка со ссылками на нормы — на странице «Стоимость».',
  },
  {
    q: 'У меня нет двух специалистов для НРС. Что делать?',
    a: 'Помогу найти и трудоустроить специалистов, отвечающих требованиям, и подготовлю документы для внесения их в реестр. Обратите внимание на формулировки конкурентов: «предоставим специалистов» означает фиктивное трудоустройство — это серая схема, при проверке она приводит к исключению из СРО. Специалисты должны реально работать в вашей компании.',
  },
  {
    q: 'Чем вы отличаетесь от других?',
    a: 'Тем, что говорю «вам это не нужно», когда это действительно так, и показываю норму, на которую опираюсь. И тем, что все цифры на этом сайте сверены с действующей редакцией Градостроительного кодекса — дата сверки указана внизу каждой страницы.',
  },
]

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const howToSchema = {
  '@type': 'HowTo',
  name: 'Как вступить в СРО',
  description: 'Порядок вступления в саморегулируемую организацию строителей, проектировщиков или изыскателей.',
  step: steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.t,
    text: s.d,
  })),
}
---

<Base
  title="Вступление в СРО — строителям и проектировщикам | НОРМА"
  description="Выписка из реестра за 24 часа, подготовка документов и сопровождение бесплатно. Калькулятор покажет, нужна ли вам СРО, — со ссылкой на статью закона."
  schema={[faqSchema, howToSchema]}
>
  <Hero />

  <!-- Честность как позиция, а не строчка в подвале -->
  <section class="section section--tight honest">
    <div class="wrap">
      <div class="honest-in rv">
        <span class="hi"><Icon name="scales" size={24} /></span>
        <div>
          <h2>Половине обратившихся СРО <em>не нужна</em>. Я говорю об этом первым</h2>
          <p>
            Требование о членстве привязано к тому, <b>с кем заключён договор</b>, а не только
            к его сумме. Субподрядчику, работающему от генподрядчика, членство не требуется
            ни при какой цене договора — но на этом зарабатывают целые компании.
            Проверьте свою ситуацию за две минуты, прежде чем кому-либо платить.
          </p>
          <div class="honest-cta">
            <a class="btn btn--acc" href="#calc">Проверить свою ситуацию</a>
            <a class="btn btn--ghost" href={href('/komu-nuzhna-sro/')}>Кому нужна СРО, а кому нет</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Calculator />

  <TenderRejects />

  <!-- Кому нужна / кому нет -->
  <section class="section" id="komu" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Без умолчаний</span>
        <h2>Кому нужна СРО, <em>а кому нет</em></h2>
        <p>
          Оба столбца одинаково важны. Правый — тот, который обычно прячут:
          на нём не заработать, но именно он экономит компаниям сотни тысяч рублей.
        </p>
      </div>
      <div class="rv"><ComparisonTable compact /></div>
      <p class="more rv">
        <a href={href('/komu-nuzhna-sro/')}>Полный разбор всех случаев со ссылками на нормы →</a>
      </p>
    </div>
  </section>

  <!-- Стоимость: тизер -->
  <section class="section section--dark" id="stoimost-teaser" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Стоимость</span>
        <h2>Открыто: из чего складываются <em>расходы</em></h2>
        <p>
          Мои услуги — подготовка документов и сопровождение — стоят 0 ₽. Платите вы только
          установленные законом и СРО взносы, и платите их напрямую в СРО, минуя меня.
        </p>
      </div>

      <div class="price-cards">
        <div class="pcard rv">
          <span class="ptag">Строителям</span>
          <h3>Первый уровень ответственности</h3>
          <p class="psub">Договоры до 90 млн ₽</p>
          <ul>
            <li><span>Компенсационный фонд возмещения вреда<small>однократно, по закону</small></span><b>100 000 ₽</b></li>
            <li><span>Вступительный взнос<small>устанавливает СРО</small></span><b class="muted-v">по тарифам</b></li>
            <li><span>Членские взносы<small>ежегодно, и со второго года тоже</small></span><b class="warn-v">по тарифам</b></li>
            <li><span>Подготовка документов и сопровождение<small>моя работа</small></span><b class="free-v">0 ₽</b></li>
            <li class="ptotal"><span>Установлено законом</span><b>100 000 ₽</b></li>
          </ul>
          <a class="btn btn--acc" href={href('/stoimost/')}>Все уровни и суммы</a>
        </div>

        <div class="pcard rv">
          <span class="ptag">Проектировщикам и изыскателям</span>
          <h3>Первый уровень ответственности</h3>
          <p class="psub">Договоры до 25 млн ₽</p>
          <ul>
            <li><span>Компенсационный фонд возмещения вреда<small>однократно, по закону</small></span><b>50 000 ₽</b></li>
            <li><span>Вступительный взнос<small>устанавливает СРО</small></span><b class="muted-v">по тарифам</b></li>
            <li><span>Членские взносы<small>ежегодно, и со второго года тоже</small></span><b class="warn-v">по тарифам</b></li>
            <li><span>Подготовка документов и сопровождение<small>моя работа</small></span><b class="free-v">0 ₽</b></li>
            <li class="ptotal"><span>Установлено законом</span><b>50 000 ₽</b></li>
          </ul>
          <a class="btn btn--acc" href={href('/stoimost/')}>Все уровни и суммы</a>
        </div>

        <div class="pcard pcard--warn rv">
          <span class="ptag ptag--warn">Идёте на торги</span>
          <h3>Нужен второй взнос — КФ ОДО</h3>
          <p class="psub">Компенсационный фонд обеспечения договорных обязательств</p>
          <ul>
            <li><span>Строителям, первый уровень<small>сверх взноса выше, не вместо</small></span><b>200 000 ₽</b></li>
            <li><span>Проектировщикам и изыскателям<small>первый уровень</small></span><b>150 000 ₽</b></li>
          </ul>
          <p class="pnote">
            Без этого взноса заявку на конкурентных закупках отклонят. Именно о нём
            молчат сайты с обещанием «без скрытых платежей».
          </p>
          <a class="btn btn--ghost-dark" href="#torgi">Три причины отказа на торгах</a>
        </div>
      </div>

      <div class="cost-cta rv">
        <a class="btn btn--acc" href={href('/stoimost/')}>Полная разбивка с суммами по уровням</a>
        <span>Все суммы — со ссылками на статьи закона</span>
      </div>
    </div>
  </section>

  <BonusOffer />

  <!-- Как проходит вступление -->
  <section class="section" id="process" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Порядок работы</span>
        <h2>Как проходит <em>вступление</em></h2>
        <p>Сроки реальные, а не рекламные: там, где закон даёт два месяца, я так и пишу.</p>
      </div>

      <ol class="steps">
        {steps.map((s, i) => (
          <li class="rv">
            <span class="sn">{i + 1}</span>
            <div class="sc">
              <div class="sc-top">
                <h3>{s.t}</h3>
                <span class="stime">{s.time}</span>
              </div>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <RegistryCheck />

  <WhyMe />

  <ServicesGrid />

  <!-- База знаний -->
  {articles.length > 0 && (
    <section class="section section--tight kb">
      <div class="wrap">
        <div class="s-head rv">
          <span class="eyebrow">База знаний</span>
          <h2>Свежие <em>разборы</em></h2>
          <p>У каждой статьи — дата публикации и дата последней проверки. В теме, где нормы меняются каждый год, статья без даты не стоит ничего.</p>
        </div>
        <div class="grid-3">
          {articles.map((a) => (
            <a class="card art rv" href={href(`/baza-znaniy/${a.id}/`)}>
              <div class="art-dates">
                <time datetime={a.data.published.toISOString().slice(0, 10)}>{fmt(a.data.published)}</time>
                {a.data.updated && <span class="upd">обновлено {fmt(a.data.updated)}</span>}
              </div>
              <h3>{a.data.title}</h3>
              <p>{a.data.excerpt}</p>
              <span class="go">Читать <Icon name="arrow" size={15} /></span>
            </a>
          ))}
        </div>
        <p class="more rv"><a href={href('/baza-znaniy/')}>Все статьи базы знаний →</a></p>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section" id="faq" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Вопросы</span>
        <h2>Частые <em>вопросы</em></h2>
      </div>
      <div class="faq rv">
        {faq.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary>{f.q}</summary>
            <div class="fa"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Контакты -->
  <section class="section contacts-cta" id="zayavka" data-anchor>
    <div class="wrap">
      <div class="cc-grid">
        <div class="rv">
          <LeadForm />
        </div>
        <aside class="rv side">
          <h3>Или свяжитесь напрямую</h3>
          <a class="big-phone" href={SITE.phoneHref} data-goal="click_phone">{SITE.phone}</a>
          <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <div class="msg-list">
            <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" data-goal="click_whatsapp">
              <Icon name="whatsapp" size={18} /> WhatsApp
            </a>
            <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" data-goal="click_telegram">
              <Icon name="telegram" size={18} /> Telegram
            </a>
            {SITE.maxLink && (
              <a href={SITE.maxLink} target="_blank" rel="noopener noreferrer">
                <Icon name="phone" size={18} /> MAX
              </a>
            )}
          </div>
          <p class="side-note">
            {SITE.geo}. Работаю дистанционно: личная встреча для вступления в СРО не нужна,
            документы подписываются электронно или пересылаются.
          </p>
          <div class="checked">
            <span class="stamp">Проверено · {SITE.checkedDate}</span>
            <p>Все нормы и суммы на сайте сверены с действующей редакцией Градостроительного кодекса РФ.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Честный блок */
  .honest { background: var(--card); border-bottom: 1px solid var(--line); }
  .honest-in { display: grid; grid-template-columns: 56px 1fr; gap: 20px; align-items: start; }
  .hi {
    width: 52px; height: 52px;
    border-radius: 14px;
    background: var(--acc-soft);
    color: var(--acc-deep);
    display: grid; place-items: center;
  }
  .honest h2 { font-size: clamp(21px, 2.8vw, 28px); margin-bottom: 10px; }
  .honest p { color: var(--muted); font-size: 16px; max-width: 74ch; }
  .honest p b { color: var(--ink); }
  .honest-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 18px; }

  .more { margin-top: 18px; font-size: 15px; font-weight: 600; }

  /* Стоимость-тизер: карточки в стиле образца */
  .price-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; align-items: start; }
  .pcard {
    background: var(--card);
    color: var(--ink);
    border-radius: var(--r-l);
    padding: 26px 24px 24px;
    display: grid;
    gap: 12px;
    align-content: start;
    /* Замер ширины карточки для правила ниже. Считаем в em, поэтому если
       посетитель увеличил размер текста в браузере, карточка «сужается»
       в этих единицах и строки перестраиваются, а не вылезают за край. */
    container-type: inline-size;
  }
  .ptag {
    justify-self: center;
    margin-top: -40px;
    background: var(--acc-btn);
    color: #fff;
    font-weight: 700;
    font-size: 13.5px;
    padding: 8px 20px;
    border-radius: 999px;
    text-align: center;
  }
  .ptag--warn { background: #B4231F; }
  .pcard h3 { font-size: 19px; margin: 4px 0 0; text-align: center; }
  .psub { font-size: 13.5px; color: var(--muted); text-align: center; margin-bottom: 6px; }
  .pcard ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .pcard li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: baseline; font-size: 15px; }
  .pcard li span { display: grid; gap: 2px; }
  .pcard li small { color: var(--muted); font-size: 12.5px; line-height: 1.4; }
  .pcard li > b { font-variant-numeric: lining-nums tabular-nums; white-space: nowrap; font-size: 16px; }
  .free-v { color: var(--good); }
  .warn-v { color: #B4231F; font-weight: 600; font-size: 14px !important; }
  .muted-v { color: var(--muted); font-weight: 500; font-size: 14px !important; }
  .ptotal { border-top: 1px solid var(--line); padding-top: 14px; }
  .ptotal > b { color: var(--acc-deep); font-size: 22px !important; }

  /* Крупный текст: название и сумма встают друг под другом.
     Иначе на узкой колонке длинное слово не помещается рядом с цифрой. */
  @container (max-width: 13em) {
    .pcard li { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .pcard li > b { justify-self: start; }
  }
  .pnote { font-size: 13.5px; color: var(--muted); line-height: 1.55; }
  .pcard .btn { justify-self: stretch; margin-top: 4px; }
  .pcard--warn { background: var(--navy-2); color: var(--on-navy); }
  .pcard--warn h3 { color: #fff; }
  .pcard--warn .psub, .pcard--warn li small, .pcard--warn .pnote { color: var(--on-navy-muted); }
  .pcard--warn li > b { color: #fff; }

  .cost-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .cost-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--navy-line);
    border-radius: var(--r-l);
    padding: 22px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .cost-card--accent { border-color: color-mix(in srgb, var(--acc-bright) 45%, transparent); background: color-mix(in srgb, var(--acc-bright) 7%, transparent); }
  .cc-ic {
    width: 38px; height: 38px;
    border-radius: var(--r-s);
    background: color-mix(in srgb, var(--acc-bright) 15%, transparent);
    color: var(--acc-bright);
    display: grid; place-items: center;
  }
  .cost-card h3 { color: #fff; font-size: 16.5px; }
  .cost-card p { color: var(--on-navy-muted); font-size: 14.5px; }
  .cost-card p b { color: #fff; }

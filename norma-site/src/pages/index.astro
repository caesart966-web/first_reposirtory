  }
  .geo-cards li:not(:first-child) .gc { padding-left: 20px; }
  .gc-city { font-family: var(--font-head); font-size: 21px; line-height: 1.15; }
  .gc-sub { font-size: 13px; color: var(--muted); }
  .gc-n {

---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Calculator from '../components/Calculator.astro'
import LeadForm from '../components/LeadForm.astro'
import Icon from '../components/Icon.astro'
import BrandIcon from '../components/BrandIcon.astro'
import DirIcon from '../components/DirIcon.astro'
import { SITE, href } from '../config/site'
import { dirIconOf } from '../config/services'
import { REGIONS } from '../config/regions'
import { PARTNERS, partnerFeeKind, partnersOf } from '../config/partners'
import { LAW, TERMS } from '../config/facts'
import { FEES, money } from '../config/fees'

// ГЛАВНАЯ — ПЯТЬ РАЗДЕЛОВ, А НЕ ДВЕНАДЦАТЬ.
//
// Заказчик: «начальная страница сильно перегружена, много текста; надо
// упростить и сделать максимально удобной подачу заявки». Замер до правки:
// 25,7 экрана телефона и 2 200 слов, форма заявки — на 21-м экране.
//
// Правило, записанное в CLAUDE.md после прошлой попытки, — начинать
// с вопроса «какой раздел убираем целиком», а не подрезать абзацы.
// Убраны целиком пять разделов, и у каждого есть своя страница, где он
// сказан полнее, чем здесь:
//   • красный блок «Разбор предложения» — на «Стоимости» (#predlozhenie);
//     на главной он повторял карточку первого экрана теми же пятью
//     пунктами и занимал два с половиной экрана телефона;
//   • таблица «Кому нужна СРО» — страница /komu-nuzhna-sro/ в главном
//     меню, и на тот же вопрос отвечает калькулятор;
//   • «Проверьте СРО в реестре» — /proverit-sro/, ссылка в подвале;
//   • «Почему через меня» — страница «Обо мне» в главном меню;
//   • «Что я делаю» (список услуг) — «Услуги» в меню и полный список
//     в подвале.
// Остальное сжато: разбивка взносов стала ценой первого года, порядок
// работы встал рядом с формой как «что будет после заявки».
//
// Форма поднята к калькулятору и стала короче: на виду имя и телефон,
// остальное — в «Уточнить задачу» (LeadForm.astro).

// ЧЕТЫРЕ ШАГА ВСТУПЛЕНИЯ — по образцу, который заказчик прислал сам
// (сро.онлайн, «МРЦС», 28.09.2026): консультация, документы, оплата взносов,
// приём в члены. Взяты порядок и названия шагов; текст свой — в первом лице,
// без «приезжайте к нам в офис» (офиса нет) и без «наших экспертов».
//
// СРОКОВ У ШАГОВ НЕТ — решение заказчика. Раньше у каждого шага стояло,
// сколько он длится и чьё это время, а внизу — «итого 5–10 дней». Срок
// вступления по-прежнему назван там, где о нём спрашивают: вопрос «Сколько
// времени занимает вступление?» ниже, со статьёй закона.
//
// Номер шага — не украшение: шаги действительно идут по порядку, и оплата
// не раньше документов. Текст шага уходит в микроразметку HowTo как есть.
const steps: { t: string; d: string; law?: string; more?: { label: string; url: string } }[] = [
  {
    t: 'Консультация',
    d: 'По телефону или в мессенджере, бесплатно. Разберу ситуацию и скажу, нужна ли вам СРО вообще, — если нет, на этом всё.',
  },
  {
    t: 'Подготовка документов',
    d: 'Вы присылаете сканы документов компании и специалистов, я сам заполняю все формы для СРО и собираю комплект.',
  },
  {
    t: 'Оплата взносов',
    d: 'Все платежи вы переводите напрямую на расчётный счёт СРО — не через меня.',
  },
  {
    t: 'Приём в члены СРО',
    // Последняя фраза — с сайта СРО «СОМ» (прислал заказчик 28.09.2026):
    // у них четвёртый шаг кончается «зайдите в реестр НОСТРОЙ, внесите ИНН
    // и убедитесь, что вы состоите». Для этого сайта это главный довод
    // целиком — «проверьте меня», — поэтому ссылка ведёт в разбор того,
    // что должно появиться в реестре, а не просто на реестр.
    d: 'Сведения о компании вносятся в единый реестр членов СРО — НОСТРОЙ или НОПРИЗ, — и вы получаете выписку из реестра. Реестр открытый: запись о компании вы проверите сами, по\u00a0ИНН.',
    law: LAW.membership,
    more: { label: 'Что проверить в реестре', url: '/proverit-sro/#posle' },
  },
]

// Что человек получит в ответ на заявку — список у формы. Идея — с сайта
// СРО «СОМ» («расчёт до рубля», «проверка специалистов», «анализ рисков
// отказа»); каждый пункт здесь — обещание, которое сайт уже даёт: ответ
// «не нужна» со ссылкой на норму (калькулятор), условия СРО с номером
// в реестре до подписи (раздел «География»), проверка специалистов
// по образованию и стажу (услуга НРС).
const formPoints = [
  { b: 'Нужна ли вам СРО', t: 'ответ со ссылкой на норму закона. Если не нужна, так и скажу.' },
  { b: 'Суммы по конкретной СРО', t: 'с её номером в реестре, до того как вы что-то подпишете.' },
  { b: 'Проверку специалистов', t: 'подходят ли они для национального реестра по образованию и стажу.' },
]
// «4 шага», «5 шагов» — числом из списка, а не словом в тексте.
const stepsWord = (n: number) =>
  n % 10 === 1 && n % 100 !== 11 ? 'шаг' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 'шага' : 'шагов'

// ТРИ НАПРАВЛЕНИЯ — сразу под первым экраном, как в том же образце:
// человек находит своё («я проектировщик») до калькулятора и цен.
// Работы перечислены только те, про которые на сайте уже сказано, что им
// нужно членство, — со страниц услуг. «Стройконтроль» и «технадзор»
// из образца сюда не перенесены: сайт нигде не утверждает, что им нужна
// СРО, и утверждать это здесь, мимо страниц с нормами, было бы новым
// фактом без статьи. Фотографий нет нарочно: у образца это стоковые
// краны и каски, а стоковых касок на этом сайте быть не должно. Значки —
// те, что прислал заказчик, обведены в вектор (DirIcon.astro); какой
// услуге какой — поле dirIcon в services.ts, одно на весь сайт.
// У строителей в списке работ стоит снос, а порог у сноса свой — 1 млн ₽
// (ст. 55.31 ГрК РФ, как в калькуляторе и сравнительной таблице). Пока
// в подписи стояли одни 10 млн, карточка обещала их и для сноса: сайт
// спорил сам с собой, и это заметил аудит 29.09.2026. Тогда же добавлен
// капремонт многоквартирного дома — при любой сумме (ч. 7 ст. 166 ЖК РФ).
const dirs = [
  {
    slug: 'sro-stroiteley',
    icon: dirIconOf('sro-stroiteley'),
    t: 'СРО строителей',
    works: ['строительство', 'реконструкция', 'капитальный ремонт', 'снос объектов капитального строительства', 'функции технического заказчика'],
    note: 'Нужна, если по прямому договору больше 10 млн ₽, по договору на снос — больше 1 млн ₽, на капремонте многоквартирного дома — при любой сумме. СРО — вашего субъекта РФ.',
  },
  {
    slug: 'sro-proektirovshchikov',
    icon: dirIconOf('sro-proektirovshchikov'),
    t: 'СРО проектировщиков',
    works: ['подготовка проектной документации', 'архитектурно-строительное проектирование'],
    note: 'Нужна при любой сумме прямого договора. Регион не важен: СРО — любого субъекта.',
  },
  {
    slug: 'sro-izyskateley',
    icon: dirIconOf('sro-izyskateley'),
    t: 'СРО изыскателей',
    works: ['инженерно-геодезические изыскания', 'инженерно-геологические', 'инженерно-гидрометеорологические', 'инженерно-экологические', 'инженерно-геотехнические'],
    note: 'Нужна при любой сумме прямого договора. Регион не важен: СРО — любого субъекта.',
  },
]

// Сколько городов с партнёрскими СРО — словом, но из данных: «двадцать
// четыре разбора» на странице 404 однажды уже разошлись с сайтом.
const partnerCities = REGIONS.filter((r) => partnersOf(r.slug).length > 0).length
const IN_N = ['', 'одном', 'двух', 'трёх', 'четырёх', 'пяти', 'шести', 'семи', 'восьми', 'девяти', 'десяти']
const inCities = `в ${IN_N[partnerCities] ?? partnerCities} ${partnerCities === 1 ? 'городе' : 'городах'}`

// Членские первого года для ответа в вопросах — из FEES, не словами: блока
// «Сколько стоит первый год», где это число стояло, на главной больше нет
// (убран по просьбе заказчика 28.09.2026, разбивка — на «Стоимости»).
const memberFirst =
  FEES.build.memberMonth === FEES.design.memberMonth
    ? `${money(FEES.build.memberMonth)} в месяц`
    : `${money(FEES.build.memberMonth)} в месяц строителям и ${money(FEES.design.memberMonth)} проектировщикам`

// Вступительный взнос в ответе — из тех же FEES, что карточка условий
// на первом экране. Раньше ответ говорил «платится вступительный взнос СРО»
// в двух экранах от строки «Вступительный взнос — 0 ₽», и аудит 29.09.2026
// прочитал это противоречием. Оговорка про СРО, которые взнос всё же берут
// (у них он отмечен в карточке), появляется сама — по данным partners.ts.
const entryFirst =
  FEES.build.entry === FEES.design.entry
    ? money(FEES.build.entry)
    : `${money(FEES.build.entry)} строителям и ${money(FEES.design.entry)} проектировщикам`
const entryDiffers = PARTNERS.some(
  (p) => p.reg && p.fees?.entry !== undefined && p.fees.entry !== FEES[partnerFeeKind(p.reg)].entry,
)

const faq = [
  {
    q: 'Существуют ли ещё допуски СРО?',
    a: 'Нет. Свидетельства о допуске к работам отменены с 1 июля 2017 года законом 372-ФЗ. Право выполнять работы подтверждается самим членством в СРО и выпиской из реестра членов. Если вам предлагают «оформить допуск СРО» — это либо разговорный оборот, либо признак того, что человек не следит за законодательством.',
  },
  {
    q: 'Правда ли, что порог для строителей — 3 млн ₽?',
    a: 'Нет, это устаревшая информация. Порог поднят до 10 млн ₽ законом 124-ФЗ с 1 мая 2022 года. Цифра в 3 млн до сих пор встречается на сайтах по теме — по ней проще всего проверить, следит ли площадка за изменениями.',
  },
  {
    q: 'Можно ли вступить в СРО другого региона?',
    a: 'Для строителей — по общему правилу нет: СРО должна быть зарегистрирована в том же субъекте РФ, что и компания. Если подходящей СРО в вашем регионе нет, допускается вступление в СРО соседнего субъекта. А вот для проектировщиков и изыскателей региональной привязки не существует вовсе — они выбирают СРО в любом регионе. Эту разницу путают даже крупные площадки.',
  },
  {
    q: 'Сколько времени занимает вступление?',
    a: `По закону у СРО есть на рассмотрение заявления ${TERMS.law}, и этот срок остаётся её правом. На практике с правильно собранным комплектом документов от подачи до готовой выписки из реестра проходит ${TERMS.extract}. Если у вас горит — скажите сразу: подам в тот же день и попрошу рассмотреть вне очереди, и тогда бывает и ${TERMS.extractRush}. Но именно бывает: обещать за СРО её собственное решение я не стану, и разница между «бывает за день» и «гарантируем за день» здесь принципиальная.`,
  },
  {
    q: 'Какие взносы придётся платить и когда?',
    a: `При вступлении — взнос в компенсационный фонд возмещения вреда (обязателен всем). Вступительный взнос в моих условиях — ${entryFirst}${entryDiffers ? '; если СРО его всё же берёт, это отмечено в её карточке на странице «Партнёрские СРО»' : ''}. Для участия в конкурентных закупках дополнительно нужен взнос в компенсационный фонд обеспечения договорных обязательств. Дальше идут членские взносы — в первый год ${memberFirst}, платить можно за месяц, квартал, полгода или год. Со второго года они не исчезают, это регулярный платёж, и я говорю об этом сразу. Полная разбивка со ссылками на нормы — на странице «Стоимость».`,
  },
  {
    q: 'У меня нет двух специалистов для НРС. Что делать?',
    a: 'Помогу найти и трудоустроить специалистов, отвечающих требованиям, и подготовлю документы для внесения их в реестр. Обратите внимание на формулировки конкурентов: «предоставим специалистов» означает фиктивное трудоустройство — это серая схема, при проверке она приводит к исключению из СРО. Специалисты должны реально работать в вашей компании.',
  },
  {
    q: 'Чем вы отличаетесь от других?',
    a: 'Тем, что говорю «вам это не нужно», когда это действительно так, и показываю норму, на которую опираюсь. И тем, что устаревших норм на этом сайте нет: все нормы сверены с действующей редакцией Градостроительного кодекса — дата сверки указана внизу каждой страницы.',
  },
]

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const howToSchema = {
  '@type': 'HowTo',
  name: 'Как вступить в СРО',
  description: 'Порядок вступления в саморегулируемую организацию строителей, проектировщиков или изыскателей.',
  step: steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.t,
    text: s.d,
  })),
}
---

<Base
  title="Вступление в СРО — строителям и проектировщикам | НОРМА"
  description="От подачи до выписки из реестра — 2–3 дня, документы и сопровождение бесплатно. Проверьте, нужна ли вам СРО: ответ со ссылкой на закон."
  schema={[faqSchema, howToSchema]}
>
  <Hero />

  <!-- Три направления: строители, проектировщики, изыскатели -->
  <section class="section section--paper dirs-sec" id="napravleniya" data-anchor>
    <div class="wrap">
      <ul class="dirs">
        {dirs.map((d) => (
          <li class="dir rv">
            <div class="dir-in stretch">
              <span class="dir-ico"><DirIcon name={d.icon} /></span>
              <h2 class="dir-t"><a class="stretch-link" href={href(`/uslugi/${d.slug}/`)}>{d.t}</a></h2>
              <ul class="dir-works">
                {d.works.map((w) => <li><Icon name="check" size={15} />{w}</li>)}
              </ul>
              <p class="dir-note">{d.note}</p>
              <span class="dir-go" aria-hidden="true">Подробнее <Icon name="arrow" size={15} /></span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Calculator />

  <!-- Четыре шага вступления -->
  <section class="section" id="process" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Порядок вступления</span>
        <h2>{steps.length} {stepsWord(steps.length)} <em>для вступления в СРО</em></h2>
        <p>
          Чтобы не ошибиться в документах и не затянуть вступление, начните с бесплатной
          консультации: позвоните по номеру <a class="s4-tel" href={SITE.phoneHref} data-goal="click_phone">{SITE.phone}</a> или
          напишите в мессенджер.
        </p>
      </div>
      <ol class="steps4">
        {steps.map((s, i) => (
          <li class="rv">
            <div class="s4-head" aria-hidden="true">
              <span class="s4-num">{i + 1}</span>
              <span class="s4-line"></span>
            </div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            {s.law && <span class="law">{s.law}</span>}
            {s.more && (
              <a class="s4-link" href={href(s.more.url)}>
                {s.more.label} <Icon name="arrow" size={14} />
              </a>
            )}
          </li>
        ))}
      </ol>
      {/* Ссылка на полный разбор пути — статью «Как вступить в СРО».
          Четыре шага здесь — что происходит с заявкой; статья — что
          решаете вы на каждом шаге, со статьями кодекса. Она же отвечает
          на запрос «как вступить в СРО», и ссылка с главной — её вес. */}
      <div class="s4-cta rv">
        <a class="btn btn--acc btn--lg" href="#zayavka">Начать с консультации</a>
        <a class="s4-more" href={href('/baza-znaniy/kak-vstupit-v-sro/')}>
          Как вступить в СРО: подробная инструкция <Icon name="arrow" size={15} class="s4-arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- Заявка -->
  <section class="section section--paper apply" id="zayavka" data-anchor>
    <div class="wrap apply-one">
      <div class="apply-form rv">
        <LeadForm
          who
          subtitle="Достаточно имени и телефона — остальное спрошу сам. В ответ вы получите:"
          points={formPoints}
        />
        {/* Прямые каналы — строкой под формой, а не отдельной карточкой:
            на телефоне те же каналы и так стоят столбиком справа, а почты
            там нет. */}
        <p class="apply-direct">
          <span>Или напрямую:</span>
          <a class="ad-phone" href={SITE.phoneHref} data-goal="click_phone">
            <BrandIcon name="phone" size={18} idp="apply" /> {SITE.phone}
          </a>
          <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" data-goal="click_whatsapp">
            <BrandIcon name="whatsapp" size={18} idp="apply" /> WhatsApp
          </a>
          <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" data-goal="click_telegram">
            <BrandIcon name="telegram" size={18} idp="apply" /> Telegram
          </a>
          {SITE.maxLink && (
            <a href={SITE.maxLink} target="_blank" rel="noopener noreferrer" data-goal="click_max">
              <BrandIcon name="max" size={18} idp="apply" /> MAX
            </a>
          )}
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </div>

    </div>
  </section>

  <!-- Вопросы -->
  <section class="section section--split" id="faq" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Вопросы</span>
        <h2>Частые <em>вопросы</em></h2>
      </div>
      <div class="faq rv sbody">
        {faq.map((f) => (
          <details name="faq">
            <summary>{f.q}</summary>
            <div class="fa"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- География: раздел «Города».
       Стоит на главной, а не только в подвале: городские страницы отвечают
       на запросы вида «вступить в СРО в Москве», и без входящей ссылки
       с самой сильной страницы сайта они остаются на отшибе. И это место,
       где сказано, что регион имеет значение — и только для строителей. -->
  <section class="section section--paper section--split" id="goroda" data-anchor>
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">География</span>
        <h2>Ваш город <em>и ваш регион</em></h2>
        <p>
          Работаю по всей России, документы электронные — приезжать никуда не нужно.
          Но у строителей регион решает: СРО должна быть зарегистрирована в том же
          субъекте РФ, что и компания.
        </p>
        <span class="law">{LAW.membership}</span>
      </div>
      <div class="sbody">
        <ul class="geo-cards rv">
          {REGIONS.map((r) => {
            const n = partnersOf(r.slug).length
            return (
              <li class="stretch">
                <div class="gc">
                  <a class="gc-city stretch-link" href={href(`/sro/${r.slug}/`)}>{r.city}</a>
                  <span class="gc-sub">{r.subject} · код {r.code}</span>
                  <span class="gc-n">
                    {n} {n === 1 ? 'партнёрская СРО' : n < 5 ? 'партнёрские СРО' : 'партнёрских СРО'}
                  </span>
                  <span class="gc-go" aria-hidden="true">Разбор по городу →</span>
                </div>
              </li>
            )
          })}
        </ul>

        {/* Главное, что должен унести человек не из этих городов. Строка
            обязана быть заметной, иначе раздел читается как «работаю только
            в трёх городах», и посетитель из четвёртого уходит. */}
        <div class="geo-rest rv">
          <p>
            <b>Остальные регионы — так же.</b> Партнёрские СРО у меня {inCities};
            для компании из любого другого субъекта подбираю организацию отдельно
            и называю её с регистрационным номером до того, как вы что-то подпишете.
          </p>
          <p class="geo-rest-more">
            <a href={href('/sro/')}>Как это работает в вашем регионе →</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Заявка ──
     Одна колонка: шаги вступления стоят над формой отдельной секцией
     и отвечают на вопрос «что будет, когда я нажму кнопку» до неё. */
  .apply-one { max-width: 780px; }
  .apply-direct {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin-top: 16px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .apply-direct a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    /* Поле нажатия выше строки — как у ссылок в подвале. */
    padding-block: 6px;
    margin-block: -6px;
  }
  .apply-direct a:hover { color: var(--acc-deep); text-decoration: underline; }
  /* Значки — те же круги, что на нижней панели; красный круг телефона —
     цветом текста, сургучом. */
  .apply-direct :global(svg) { flex: none; color: var(--acc-btn); }
  .ad-phone { font-variant-numeric: lining-nums tabular-nums; }

  /* ── Четыре шага ──
     Раскладка — по образцу заказчика: крупная цифра и линия к следующему
     шагу, в ряд. Линия — та же размерная линия с засечками, что делит
     секции сайта (цитата из чертежа), а не декоративная полоска: шаги
     и правда отмеряют путь от консультации до выписки. На телефоне шаги
     встают столбиком, и линия там не нужна. */
  .steps4 {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 28px 30px;
  }
  @media (min-width: 900px) {
    .steps4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .steps4 li { display: grid; align-content: start; gap: 8px; }
  .s4-head { display: flex; align-items: center; gap: 14px; margin-bottom: 6px; }
  .s4-num {
    font-family: var(--font-head);
    font-size: 64px;
    font-weight: 400;
    line-height: 0.9;
    color: var(--acc);
    font-variant-numeric: lining-nums;
  }
  .s4-line { position: relative; flex: 1; height: 1px; background: var(--muted); opacity: 0.45; }
  .s4-line::before,
  .s4-line::after {
    content: '';
    position: absolute;
    top: -5px;
    width: 1px;
    height: 11px;
    background: inherit;
  }
  .s4-line::before { left: 0; }
  .s4-line::after { right: 0; }
  .steps4 li:last-child .s4-line { display: none; }
  .steps4 h3 { margin: 0; font-size: 18px; }
  .steps4 p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.6; max-width: 40ch; }
  .steps4 .law { justify-self: start; margin-top: 4px; }
  /* Высота не меньше 32 px: строка в 22 px — мелкая цель для пальца,
     и test-a11y её роняет. Ссылка короткая и в одну строку, поэтому
     flex здесь безопасен (у .s4-more ниже — наоборот, см. комментарий). */
  .s4-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 32px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--acc-deep);
    text-decoration: none;
  }
  .s4-link:hover { text-decoration: underline; }
  .s4-tel { font-weight: 600; white-space: nowrap; }
  .s4-cta { margin-top: 34px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; }
  /* Строчный текст, а не flex: на телефоне ссылка переносится на две
     строки, и во flex-ряду стрелка уезжала к правому краю экрана,
     отдельно от слов. В строке она идёт сразу за последним словом. */
  .s4-more { font-weight: 600; line-height: 1.5; color: var(--acc-deep); text-decoration: none; }
  .s4-more:hover { text-decoration: underline; }
  .s4-more :global(.s4-arrow) { display: inline-block; vertical-align: -2px; margin-left: 4px; }
  /* На телефоне цифра встаёт слева от текста, а не над ним: шаг занимает
     вдвое меньше высоты, и форма заявки под шагами не уезжает вниз.
     Линия к следующему шагу здесь не нужна — шаги и так идут столбиком. */
  @media (max-width: 899px) {
    .steps4 { gap: 22px; }
    .steps4 li { grid-template-columns: 46px minmax(0, 1fr); column-gap: 14px; row-gap: 5px; }
    .s4-head { grid-row: 1 / span 3; margin: 0; align-items: flex-start; }
    .s4-line { display: none; }
    .s4-num { font-size: 46px; }
    .steps4 h3, .steps4 p, .steps4 .law, .steps4 .s4-link { grid-column: 2; }
  }

  /* ── Три направления ──
     Сразу под первым экраном: карточка целиком — ссылка на страницу услуги.
     Значок вместо фотографии: у образца здесь стоковые краны и каски.
     Секция на тёплом листе (section--paper): белые карточки на нём видны,
     а размерная линия-разделитель не встаёт над тёмным калькулятором —
     правило в global.css рисует её между двумя белыми секциями. */
  .dirs-sec { padding-top: 34px; }
  .dirs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 18px;
  }
  .dir-in {
    height: 100%;
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 12px;
    padding: 24px 22px 20px;
    background: var(--card, var(--paper));
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--t-fast) var(--ease);
  }
  .dir-in:hover { border-color: var(--acc); }
  .dir-ico { color: var(--acc); display: inline-flex; }
  .dir-t { margin: 0; font-size: 22px; }
  /* align-content: start — иначе строка сетки карточки растягивает список,
     и два пункта у проектировщиков разъезжаются на всю высоту соседей. */
  .dir-works { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; align-content: start; }
  /* «Инженерно-гидрометеорологические» — одно слово шире узкой карточки
     при крупном шрифте (режим «версия для ПК» на телефоне): без переноса
     оно распирало страницу на 15 px, поймал test-widths. */
  .dir-works li { display: grid; grid-template-columns: 15px minmax(0, 1fr); gap: 9px; align-items: start; font-size: 15px; line-height: 1.45; hyphens: auto; overflow-wrap: anywhere; }
  .dir-works :global(svg) { margin-top: 3px; color: var(--good, var(--acc)); }
  .dir-note { margin: 4px 0 0; padding-top: 12px; border-top: 1px solid var(--line); font-size: 14px; line-height: 1.55; color: var(--muted); }
  .dir-go { display: inline-flex; align-items: center; gap: 6px; font-size: 14.5px; font-weight: 600; color: var(--acc-deep); }
  .dir-in:hover .dir-go { text-decoration: underline; }
  /* На телефоне виды работ идут строкой, а не столбиком: три карточки
     подряд иначе занимали полтора экрана и отодвигали калькулятор. */
  @media (max-width: 599px) {
    .dirs { gap: 12px; }
    .dir-in { padding: 18px 18px 16px; gap: 10px; }
    .dir-t { font-size: 20px; }
    .dir-works { display: flex; flex-wrap: wrap; gap: 4px 14px; }
    .dir-works li { display: inline-flex; gap: 6px; font-size: 14.5px; }
    .dir-works :global(svg) { margin-top: 2px; flex: none; }
    .dir-note { padding-top: 10px; }
  }

  /* ── Вопросы ──
     Раскрываются плавно, без JavaScript: interpolate-size (в global.css)
     разрешает браузеру анимировать переход к height: auto. Там, где браузер
     этого не умеет, ответ просто появляется сразу. Все вопросы закрыты:
     ответы длинные, а заказчик просил меньше текста на главной. */
  .faq { display: grid; gap: 10px; max-width: 900px; }
  .faq details {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    overflow: hidden;
    transition: border-color var(--t-mid) var(--ease);
  }
  .faq details:hover { border-color: color-mix(in srgb, var(--acc) 35%, var(--line)); }
  .faq details[open] { border-color: color-mix(in srgb, var(--acc) 45%, var(--line)); }
  .faq summary {
    padding: 17px 22px;
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: center;
    transition: color var(--t-fast) var(--ease);
  }
  .faq summary:hover { color: var(--acc-deep); }
  .faq summary::-webkit-details-marker { display: none; }
  /* Знак «плюс» из двух линеек: при раскрытии вертикальная схлопывается,
     знак доворачивается на пол-оборота — настоящий переход «плюс → минус». */
  .faq summary::after {
    content: '';
    width: 14px;
    height: 14px;
    flex: none;
    background-image:
      linear-gradient(var(--acc-deep), var(--acc-deep)),
      linear-gradient(var(--acc-deep), var(--acc-deep));
    background-position: center, center;
    background-repeat: no-repeat;
    background-size: 14px 1.5px, 1.5px 14px;
    transition:
      background-size var(--t-mid) var(--ease),
      transform var(--t-mid) var(--ease);
  }
  .faq details[open] summary::after {
    background-size: 14px 1.5px, 1.5px 0;
    transform: rotate(180deg);
  }
  .faq details::details-content {
    height: 0;
    overflow: hidden;
    transition:
      height var(--t-mid) var(--ease),
      content-visibility var(--t-mid) allow-discrete;
  }
  .faq details[open]::details-content { height: auto; }
  .faq .fa { padding: 0 22px 20px; }
  .faq .fa p { color: var(--muted); font-size: 15.5px; max-width: 76ch; }

  /* ── География ──
     Три города — карточками на линейках, а не списком-реестром: реестр
     из трёх строк выглядит обрезанным, будто остальные потерялись. */
  .geo-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    border-top: 1px solid var(--line);
  }
  .geo-cards li { border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); }
  .geo-cards li:last-child { border-right: 0; }
  .geo-cards .gc {

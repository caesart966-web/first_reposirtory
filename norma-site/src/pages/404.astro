---
// Страница «не найдено».
//
// На GitHub Pages и на большинстве хостингов файл 404.html подставляется
// автоматически. Без него посетитель с битой ссылкой видит стандартную
// страницу ошибки хостинга: чужое оформление, английский текст и ни одной
// ссылки обратно на сайт. Для сайта, который продаёт аккуратность,
// это плохое первое впечатление.
//
// Здесь вместо извинений — работающие ходы: калькулятор, разделы, телефон.
// Человек попал сюда не по своей вине, и его задача никуда не делась.
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import HeadPhoto from '../components/HeadPhoto.astro'
import { href, SITE } from '../config/site'

const WAYS = [
  {
    t: 'Нужна ли вам СРО',
    d: 'Четыре вопроса и ответ со ссылкой на норму — включая ответ «не нужна».',
    url: '/#calc',
    icon: 'check',
  },
  {
    t: 'Сколько это стоит',
    d: 'Открытая разбивка всех взносов по уровням ответственности.',
    url: '/stoimost/',
    icon: 'ruble',
  },
  {
    t: 'Услуги',
    d: 'Вступление в СРО, специалисты НРС, лицензии, охрана труда.',
    url: '/uslugi/',
    icon: 'doc',
  },
  {
    t: 'База знаний',
    d: 'Двадцать четыре разбора: пороги, взносы, отказы, проверки.',
    url: '/baza-znaniy/',
    icon: 'book',
  },
]
---

<Base
  title="Страница не найдена | НОРМА"
  description="Такой страницы на сайте нет. Вот что есть: калькулятор «нужна ли вам СРО», разбивка стоимости, услуги и база знаний."
  noindex
>
  <section class="section page-head">
    <HeadPhoto position="70% 40%" />
    <div class="wrap">
      <span class="eyebrow">Ошибка 404</span>
      <h1>Такой страницы нет</h1>
      <p class="lead">
        Ссылка устарела или в адресе опечатка. Ничего страшного — вот всё, за чем
        обычно приходят.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="ways">
        {WAYS.map((w) => (
          <a class="way rv" href={href(w.url)}>
            <span class="way-ic"><Icon name={w.icon} size={20} /></span>
            <b>{w.t}</b>
            <span class="way-d">{w.d}</span>
            <span class="way-go">Открыть <Icon name="arrow" size={14} /></span>
          </a>
        ))}
      </div>

      <div class="lost rv">
        <p>
          Искали что-то конкретное и не нашли? Напишите или позвоните — отвечу лично
          и подскажу, где это на сайте или чего на нём пока нет.
        </p>
        <div class="lost-actions">
          <a class="btn btn--acc" href={SITE.phoneHref} data-goal="click_phone">{SITE.phone}</a>
          <a class="btn btn--ghost" href={href('/kontakty/')}>Все способы связи</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { background: var(--dark); color: var(--on-dark); padding-bottom: 46px; }
  .page-head .eyebrow { color: var(--acc-bright); }
  .page-head h1 { color: #fff; margin: 12px 0 16px; }
  .page-head .lead { color: var(--on-dark-muted); max-width: 54ch; }

  .ways { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
  .way {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 24px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  }
  .way:hover { border-color: var(--acc); transform: translateY(-2px); }
  .way-ic {
    width: 40px; height: 40px;
    display: grid; place-items: center;
    border-radius: var(--r-s);
    background: var(--acc-soft);
    color: var(--acc-deep);
    margin-bottom: 4px;
  }
  .way b { font-size: 17px; }
  .way-d { color: var(--muted); font-size: 14.5px; line-height: 1.55; }
  .way-go { color: var(--acc-deep); font-weight: 600; font-size: 14.5px; display: inline-flex; align-items: center; gap: 6px; }

  .lost {
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 16px;
    max-width: 68ch;
  }
  .lost p { color: var(--muted); }
  .lost-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (prefers-reduced-motion: reduce) {
    .way { transition: none; }
    .way:hover { transform: none; }
  }
</style>

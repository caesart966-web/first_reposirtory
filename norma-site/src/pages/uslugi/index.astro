---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import LeadForm from '../../components/LeadForm.astro'
import { byGroup } from '../../config/services'
import { href, SITE } from '../../config/site'

const sro = byGroup('sro')
const people = byGroup('people')
---

<Base
  title="Услуги — вступление в СРО, НРС, НОК, лицензии | НОРМА"
  description="Направления работы: вступление в СРО строителей, проектировщиков и изыскателей, внесение специалистов в НРС, НОК, получение лицензий. Подготовка документов бесплатно."
  breadcrumbs={[{ label: 'Главная', url: href('/') }, { label: 'Услуги' }]}
>
  <section class="section page-head">
    <div class="wrap">
      <span class="eyebrow">Направления</span>
      <h1>Услуги</h1>
      <p class="lead">
        Каждая страница — с нормами, сроками и составом документов. Подготовка документов
        и сопровождение стоят <b>0 ₽</b>: вы оплачиваете только взносы и пошлины, и напрямую
        получателю, минуя меня.
      </p>
      <div class="head-tags">
        <span class="stamp">Сверено с законом · {SITE.checkedDate}</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="group rv">
        <div class="g-head">
          <h2>Членство в СРО</h2>
          <p>
            Три направления, три разные саморегулируемые организации. У строителей действует
            порог по сумме договора и региональный принцип; у проектировщиков и изыскателей —
            ни того, ни другого.
          </p>
        </div>
        <div class="grid-3">
          {sro.map((s) => (
            <a class="card srv" href={href(`/uslugi/${s.slug}/`)}>
              <span class="ic"><Icon name={s.icon} size={20} /></span>
              <h3>{s.title}</h3>
              <p>{s.excerpt}</p>
              <span class="go">Подробнее <Icon name="arrow" size={15} /></span>
            </a>
          ))}
        </div>
      </div>

      <div class="group rv">
        <div class="g-head">
          <h2>Специалисты и разрешения</h2>
          <p>
            Без двух специалистов в национальном реестре членство в СРО невозможно, а истёкшая
            оценка квалификации выводит компанию из соответствия требованиям незаметно для неё самой.
          </p>
        </div>
        <div class="grid-3">
          {people.map((s) => (
            <a class="card srv" href={href(`/uslugi/${s.slug}/`)}>
              <span class="ic"><Icon name={s.icon} size={20} /></span>
              <h3>{s.title}</h3>
              <p>{s.excerpt}</p>
              <span class="go">Подробнее <Icon name="arrow" size={15} /></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="honest rv">
        <span class="h-ic"><Icon name="scales" size={26} /></span>
        <div>
          <span class="eyebrow">Как я работаю</span>
          <h2>Сначала проверяю, нужна ли услуга вообще</h2>
          <p>
            Разбор ситуации предшествует любому оформлению. Если по вашим договорам членство
            не требуется — я говорю об этом и работу не начинаю. Это не благотворительность:
            компания, которой не продали ненужное, возвращается тогда, когда оно понадобится
            по-настоящему.
          </p>
          <div class="h-cta">
            <a class="btn btn--acc" href={href('/#calc')}>Проверить за две минуты</a>
            <a class="btn btn--ghost-dark" href={href('/komu-nuzhna-sro/')}>Кому нужна СРО, а кому нет</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <LeadForm
        title="Не знаете, что именно вам нужно?"
        subtitle="Опишите работы и договоры — разберу и назову только то, что действительно требуется по закону."
      />
    </div>
  </section>
</Base>

<style>
  .page-head { background: var(--navy); color: var(--on-navy); padding-bottom: 40px; }
  .page-head .eyebrow { color: var(--acc-bright); }
  .page-head h1 { color: #fff; margin: 12px 0 16px; }
  .page-head .lead { color: var(--on-navy-muted); }
  .page-head .lead b { color: #fff; }
  .head-tags { margin-top: 20px; }

  .group + .group { margin-top: 44px; }
  .g-head { margin-bottom: 22px; max-width: 72ch; }
  .g-head h2 { font-size: 24px; margin-bottom: 8px; }
  .g-head p { color: var(--muted); font-size: 15.5px; }

  .srv { display: grid; gap: 10px; align-content: start; }
  .srv h3 { font-size: 18px; margin: 0; }
  .ic { width: 40px; height: 40px; border-radius: var(--r-s); background: var(--acc-soft); color: var(--acc-deep); display: grid; place-items: center; }
  .go { display: inline-flex; align-items: center; gap: 6px; font-size: 14.5px; font-weight: 600; color: var(--acc-deep); }

  .honest { display: grid; grid-template-columns: 52px 1fr; gap: 20px; align-items: start; }
  .h-ic { width: 48px; height: 48px; border-radius: 13px; background: rgba(53, 214, 204, 0.15); color: var(--acc-bright); display: grid; place-items: center; }
  .honest h2 { color: #fff; margin: 10px 0 12px; max-width: 26ch; }
  .honest p { color: var(--on-navy-muted); font-size: 16px; max-width: 74ch; }
  .h-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 18px; }

  .narrow { max-width: 780px; }

  @media (max-width: 640px) {
    .honest { grid-template-columns: 1fr; }
    .h-cta .btn { width: 100%; }
  }
</style>

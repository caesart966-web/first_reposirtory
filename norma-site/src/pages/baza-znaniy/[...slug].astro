---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import ShareLinks from '../../components/ShareLinks.astro'
import { getCollection, render } from 'astro:content'
import { href, SITE } from '../../config/site'
import { SEO } from '../../config/seo'

export async function getStaticPaths() {
  const articles = await getCollection('articles')
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }))
}

const { article } = Astro.props
const { Content, headings } = await render(article)

// Содержание разбора — из подзаголовков второго уровня самой статьи
// (30.09.2026, «чтобы клиент не запутался»). Статья на телефоне — до десяти
// экранов, а приходят с одним вопросом; по оглавлению видно, есть ли
// ответ и где он. Короче четырёх разделов оглавление не нужно — такая
// статья видна целиком за пару экранов. Якоря — те же id, что markdown
// ставит заголовкам; их сверяет check-html, отступ под шапку даёт h2[id]
// в global.css.
const toc = headings.filter((h) => h.depth === 2)
const razdelov = (n: number) =>
  n % 10 === 1 && n % 100 !== 11 ? 'раздел' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'раздела' : 'разделов'
// Тот же адрес, что в canonical (Base.astro), — его и отдают «Поделиться».
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString()

// Ссылки внутри текста статьи чинятся здесь, а не в самих статьях.
//
// В чём была беда. Ссылки, поставленные компонентами, проходят через
// href() и получают подпапку, в которой живёт сайт. Ссылки, написанные
// в markdown, через href() не проходят: «/proverit-sro/» так и уходит
// в разметку и на боевом адресе ведёт в корень домена, где ничего нет.
// На локальном превью подпапки нет, поэтому проверка ссылок молчала,
// а заказчик получил страницу «Site not found» от GitHub. Битых ссылок
// набралось двадцать девять.
//
// Чинить в самих статьях нельзя: подпапка зависит от того, куда собирают,
// и автор статьи её знать не обязан. Поэтому правим готовую разметку —
// один раз на сборке, для всех статей сразу, включая те, что напишут
// потом. Трогаем только ссылки от корня: внешние (со схемой), якорные
// и относительные остаются как есть.
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const withBase = (html: string) =>
  base ? html.replace(/(href|src)="\/(?!\/)/g, `$1="${base}/`) : html

// Подписи столбцов переносятся в сами ячейки — атрибутом data-label.
//
// Зачем. На телефоне таблица из статьи разворачивается в карточки (правила
// внизу файла), и каждой ячейке нужна своя подпись: «ООО», «ИП», «Документ».
// В markdown таких атрибутов не напишешь, а требовать их от автора статьи
// нельзя — он пишет обычную таблицу в три палочки. Поэтому подписи
// проставляются на сборке: столько же, сколько ячеек в строке, по порядку.
//
// Заодно это работает для статей, которые напишут потом: ничего
// дописывать в них не придётся.
const withLabels = (html: string) =>
  html.replace(/<table(\s[^>]*)?>[\s\S]*?<\/table>/g, (table) => {
    const head = table.match(/<thead>([\s\S]*?)<\/thead>/)
    if (!head) return table
    // Текст шапки уже экранирован разметкой, остаётся снять теги
    // и закрыть кавычку — иначе она оборвала бы сам атрибут.
    const heads = [...head[1].matchAll(/<th[^>]*>([\s\S]*?)<\/th>/g)].map((m) =>
      m[1].replace(/<[^>]+>/g, '').trim().replace(/"/g, '&quot;'),
    )
    if (heads.length < 2) return table
    return table.replace(/<tbody>[\s\S]*?<\/tbody>/, (tbody) =>
      tbody.replace(/<tr>[\s\S]*?<\/tr>/g, (row) => {
        let i = 0
        return row.replace(/<td(\s[^>]*)?>/g, (td, attrs: string | undefined) => {
          const label = heads[i++]
          return label ? `<td${attrs ?? ''} data-label="${label}">` : td
        })
      }),
    )
  })

// Готовая разметка статьи лежит в самой записи коллекции. Если её вдруг
// не окажется — рисуем обычным компонентом: лучше ссылки без подпапки,
// чем пустая страница.
const rendered = (article as { rendered?: { html?: string } }).rendered?.html

const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })

// Другие статьи — чтобы читатель не уходил после одной страницы.
//
// Берём СОСЕДЕЙ ПО РАЗДЕЛУ, идущих следом по порядку, и замыкаем список
// в кольцо. Раньше здесь стояли две самые свежие статьи — одни и те же
// на всех двадцати шести страницах. Стоило это дорого и сразу в двух местах.
//
// Читателю: со статьи про порог 10 млн предлагалось «Как СРО проверяет
// своих членов» — тема из другого конца базы знаний. Соседи по разделу
// продолжают тот же разговор.
//
// Поисковику: внутренние ссылки — сигнал важности страницы, и он весь
// стекался в две статьи (по 26 входящих ссылок), пока двенадцать других
// имели ровно одну — со страницы списка. Кольцо по разделу даёт каждой
// статье по две входящих, и ни одна не остаётся тупиком.
const all = await getCollection('articles')
const others = (() => {
  const ring = all
    .filter((a) => a.data.group === article.data.group)
    .sort((a, b) => a.data.order - b.data.order)
  const at = ring.findIndex((a) => a.id === article.id)
  const picked = []
  if (at >= 0) {
    for (let step = 1; step < ring.length && picked.length < 2; step++) {
      picked.push(ring[(at + step) % ring.length])
    }
  }
  // В разделе меньше трёх статей — добираем из остальных, по порядку,
  // чтобы и здесь блок не оказался пустым.
  if (picked.length < 2) {
    const rest = all
      .filter((a) => a.id !== article.id && !picked.some((p) => p.id === a.id))
      .sort((a, b) => a.data.order - b.data.order)
    picked.push(...rest.slice(0, 2 - picked.length))
  }
  return picked
})()

// Названия разделов базы знаний — теми же словами, что и на странице списка.
// Уходят в разметку (articleSection) и в Open Graph.
const SECTIONS: Record<string, string> = {
  need: 'Нужна ли вам СРО',
  money: 'Деньги',
  membership: 'Членство',
  check: 'Проверяемость',
}

const published = article.data.published.toISOString()
const modified = (article.data.updated ?? article.data.published).toISOString()
const section = SECTIONS[article.data.group]
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString()

const articleSchema = {
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: article.data.title,
  description: article.data.description,
  datePublished: published,
  dateModified: modified,
  // Узел владельца объявлен в разметке организации (Base.astro, founder).
  author: { '@id': new URL('/', Astro.site).toString() + '#person' },
  publisher: { '@id': new URL('/', Astro.site).toString() + '#org' },
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  isPartOf: { '@id': `${pageUrl}#webpage` },
  image: new URL(href(SEO.ogImage), Astro.site).toString(),
  articleSection: section,
  inLanguage: 'ru-RU',
}
---

<Base
  title={`${article.data.metaTitle ?? article.data.title} | НОРМА`}
  description={article.data.description}
  schema={[articleSchema]}
  article={{ published, modified, section }}
  breadcrumbs={[
    { label: 'Главная', url: href('/') },
    { label: 'База знаний', url: href('/baza-znaniy/') },
    { label: article.data.title },
  ]}
>
  <article class="art">
    {/* Полоса прочитанного — тонкая красная линия по верхнему краю окна
        (06.10.2026, «живой» сайт). Чистый CSS, без скрипта: анимация
        привязана к прокрутке страницы. Где браузер так не умеет
        (Firefox), полосы нет вовсе — ничего не ломается. */}
    <div class="read-bar" aria-hidden="true"></div>
    <header class="art-head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Хлебные крошки" data-nosearch>
          <a href={href('/')}>Главная</a>
          <span aria-hidden="true">/</span>
          <a href={href('/baza-znaniy/')}>База знаний</a>
        </nav>
        <h1>{article.data.title}</h1>
        <div class="meta">
          <time datetime={article.data.published.toISOString().slice(0, 10)}>
            Опубликовано {fmt(article.data.published)}
          </time>
          {article.data.updated && (
            <span class="upd">
              <Icon name="check" size={14} />
              Сверено с законом {fmt(article.data.updated)}
            </span>
          )}
        </div>
      </div>
    </header>

    <div class="wrap art-body">
      <div class="art-main">
        {toc.length >= 4 && (
          <details class="toc" open data-nosearch>
            <summary>Содержание · {toc.length} {razdelov(toc.length)}</summary>
            <ul>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ul>
          </details>
        )}
        <div class="prose">
          {rendered ? <Fragment set:html={withLabels(withBase(rendered))} /> : <Content />}
        </div>
        {/* Разбор пересылают бухгалтеру или партнёру — адрес уходит вместе
            с названием. В подвале у статей этой строки нет: вторая такая же
            внизу страницы была бы повтором (Footer.astro, проп share). */}
        <ShareLinks url={canonicalUrl} title={article.data.title} label="Поделиться разбором" />
      </div>

      <aside class="art-side" data-nosearch>
        {article.data.relatedService && (
          <div class="side-card side-card--acc">
            <span class="sc-label">По этой теме</span>
            <h2>{article.data.relatedService.label}</h2>
            <p>Разбор нормы — это половина дела. Вторая половина — правильно оформленные документы.</p>
            <a class="btn btn--acc" href={href(article.data.relatedService.url)}>Перейти к услуге</a>
          </div>
        )}

        <div class="side-card">
          <span class="sc-label">Быстрая проверка</span>
          <h2>Нужна ли СРО именно вам</h2>
          <p>Четыре вопроса, ответ со ссылкой на норму. Если членство не требуется — так и напишем.</p>
          <a class="btn btn--ghost" href={href('/#calc')}>Открыть калькулятор</a>
        </div>

        <div class="side-card side-card--quiet">
          <span class="sc-label">Связаться</span>
          <a class="side-phone" href={SITE.phoneHref} data-goal="click_phone">{SITE.phone}</a>
          <p>{SITE.geoShort}. Отвечаю лично.</p>
          <div class="side-msgs">
            <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" data-goal="click_whatsapp">WhatsApp</a>
            <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" data-goal="click_telegram">Telegram</a>
            {SITE.maxLink && (
              <a href={SITE.maxLink} target="_blank" rel="noopener noreferrer" data-goal="click_max">MAX</a>
            )}
          </div>
        </div>
      </aside>
    </div>

    {others.length > 0 && (
      <section class="section next" data-nosearch>
        <div class="wrap">
          <h2>Читайте дальше</h2>
          <div class="grid-2">
            {others.map((a) => (
              <div class="card card--link next-card">
                <span class="nc-date">{fmt(a.data.updated ?? a.data.published)}</span>
                <h3><a class="stretch-link" href={href(`/baza-znaniy/${a.id}/`)}>{a.data.title}</a></h3>
                <p>{a.data.excerpt}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .art-head { background: var(--dark); color: var(--on-dark); padding: 34px 0 40px; }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--on-dark-muted); margin-bottom: 18px; flex-wrap: wrap; }
  /* Поле промаха, а не размер шрифта: строка крошек набрана мелко
     и должна такой остаться, но пальцем в 21 px не попадают. Отступ
     сверху и снизу растит область нажатия до 33 px, отрицательное поле
     возвращает строку на место — внешне не меняется ничего. */
  .crumbs a {
    color: var(--on-dark-muted);
    text-decoration: none;
    padding-block: 6px;
    margin-block: -6px;
  }
  .crumbs a:hover { color: var(--acc-bright); }
  .art-head h1 { color: #fff; max-width: 24ch; }
  .meta { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 18px; font-family: var(--font-mono); font-size: 12px; color: var(--on-dark-muted); }
  .upd { display: inline-flex; align-items: center; gap: 6px; color: var(--acc-bright); }

  .art-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 40px; padding-top: 40px; padding-bottom: 20px; align-items: start; }
  .art-main { display: grid; gap: 28px; min-width: 0; }
  .toc {
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    background: var(--paper-2);
    padding: 4px 20px;
  }
  /* Знак «плюс/минус» — тот же, что у вопросов на главной: у раскрывающихся
     блоков сайта один приём, а не системный треугольник браузера. */
  .toc summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
  }
  .toc summary::-webkit-details-marker { display: none; }
  .toc summary::after {
    content: '';
    width: 14px;
    height: 14px;
    flex: none;
    background-image:
      linear-gradient(var(--acc-deep), var(--acc-deep)),
      linear-gradient(var(--acc-deep), var(--acc-deep));
    background-position: center, center;
    background-repeat: no-repeat;
    background-size: 14px 1.5px, 1.5px 14px;
  }
  .toc[open] summary::after { background-size: 14px 1.5px, 1.5px 0; }
  .toc ul { list-style: none; margin: 0 0 12px; padding: 0; display: grid; }
  .toc li + li { border-top: 1px solid var(--line); }
  .toc a {
    display: block;
    padding: 9px 0;
    color: var(--acc-deep);
    font-size: 15px;
    line-height: 1.4;
    text-decoration: none;
  }
  .toc a:hover { text-decoration: underline; }
  .art-main :global(.share) { padding-top: 18px; border-top: 1px solid var(--line); }

  .read-bar { display: none; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .read-bar {
        display: block;
        position: fixed;
        inset: 0 0 auto 0;
        height: 3px;
        /* Над шапкой (у неё 50): полоса лежит по её верхней кромке. */
        z-index: 60;
        background: var(--acc-btn);
        transform-origin: 0 50%;
        transform: scaleX(0);
        animation: read-bar linear both;
        pointer-events: none;
      }
      /* Шкала времени — отдельным правилом, и это не прихоть. Сборщик
         (lightningcss) склеивает animation и animation-timeline одного
         правила в одно сокращение «animation: … scroll(root)», а Chrome
         такое сокращение не принимает и выбрасывает целиком: полоса
         стояла на нуле. Отдельное правило с селектором посильнее
         не склеивается и перебивает сброс шкалы из сокращения. */
      .art .read-bar {
        animation-timeline: scroll(root block);
        animation-duration: auto;
      }
    }
  }
  @keyframes read-bar { to { transform: scaleX(1); } }

  /* Статья набирается антиквой: её читают целиком, а не просматривают. */
  .prose {
    max-width: 68ch;
    min-width: 0;
    font-family: var(--font-head);
    font-size: 17.5px;
    line-height: 1.7;
  }
  .prose :global(p) { margin: 0 0 20px; }
  /* Буквица — первая буква разбора крупно, сургучом, на три строки:
     так открывают главу в книге и раздел в старом своде законов
     (06.10.2026, «красивый, живой»). Только у абзаца, с которого
     статья начинается: у таблицы или списка буквицы не бывает. */
  .prose > :global(p:first-child)::first-letter {
    float: left;
    font-size: 3.55em;
    line-height: 0.8;
    font-weight: 700;
    margin: 0.07em 0.1em 0 0;
    color: var(--acc-deep);
  }
  .prose :global(h2) { font-size: 25px; margin: 36px 0 14px; }
  .prose :global(h3) { font-size: 19px; margin: 28px 0 10px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 20px; padding-left: 24px; display: grid; gap: 8px; }
  .prose :global(li) { line-height: 1.65; }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(a) { color: var(--acc-deep); }
  .prose :global(blockquote) {
    margin: 0 0 20px;
    padding: 14px 20px;
    border-left: 3px solid var(--acc);
    background: var(--acc-soft);
    border-radius: 0 var(--r-s) var(--r-s) 0;
  }
  /* ── Таблицы в статьях ──
     Разметка статей — обычный markdown, и таблица приходит из него голым
     <table>: без рамки, без шапки, без полосок между строками. На телефоне
     это читалось не как таблица, а как текст, случайно разложенный
     столбиками. Оформление повторяет table.data с остальных страниц сайта,
     но без жёсткой минимальной ширины: в статьях таблицы узкие — две-три
     колонки коротких значений, — и общий минимум в 560 px гнал бы их
     в горизонтальную прокрутку на ровном месте.
     Первая колонка — подпись строки, поэтому она набрана полужирным:
     в сравнительной таблице глаз идёт по ней. */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    overflow: hidden;
    background: var(--card);
    margin: 0 0 24px;
    font-size: 14.5px;
    line-height: 1.5;
  }
  .prose :global(thead th) {
    text-align: left;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
    padding: 11px 14px;
    vertical-align: bottom;
  }
  /* Первый столбец шапки часто пустой — это угол сравнительной таблицы,
     и подчёркивать его нечем. */
  .prose :global(thead th:empty) { background: var(--paper-2); }
  .prose :global(tbody td) {
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    color: var(--muted);
  }
  .prose :global(tbody tr:last-child td) { border-bottom: 0; }
  .prose :global(tbody td:first-child) { font-weight: 600; color: var(--ink); }
  /* На узком экране полей меньше: 14 px с каждой стороны на телефоне
     съедали треть колонки.
     table-layout: fixed — обязательно, а не для красоты. При обычной
     раскладке ширину таблицы определяет самое длинное неразрывное
     содержимое ячеек, и заголовок «Проектировщики и изыскатели» растягивал
     её до 399 px на экране в 390: правый столбец обрезался, а страница
     получала горизонтальную прокрутку. С фиксированной раскладкой колонки
     делят ширину поровну, а текст переносится. */
  /* На телефоне таблица разворачивается в карточки — тот же приём, что
     у table.data на остальных страницах сайта.
     Так вышло не сразу. Сначала колонки просто делили ширину поровну
     (table-layout: fixed) и текст переносился по буквам, потому что
     словаря русских переносов в браузере может не быть. На трёх колонках
     в 390 px это давало «предпринима|теля», «компенсацио|нный»
     и «рассмотрени|я» — сравнительную таблицу в таком виде не читают,
     её разгадывают. Ширины взять неоткуда: колонке достаётся сотня
     пикселей, а слова в русском длиннее.
     Поэтому строка становится карточкой: первая ячейка — её заголовок,
     остальные идут парами «подпись сверху, значение под ней». Подпись
     берётся из data-label, который проставляется на сборке (см. верх
     файла), а шапка прячется — дублировать её незачем. */
  @media (max-width: 599px) {
    .prose :global(table) { display: block; font-size: 15px; }
    /* Шапку убираем из виду, но оставляем в разметке: она нужна тем,
       кто читает страницу голосом. */
    .prose :global(thead) {
      position: absolute;
      width: 1px; height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .prose :global(tbody), .prose :global(tbody tr) { display: block; }
    .prose :global(tbody tr) { border-bottom: 1px solid var(--line); padding-bottom: 10px; }
    .prose :global(tbody tr:last-child) { border-bottom: 0; }
    .prose :global(tbody td) {
      display: block;
      border-bottom: 0;
      padding: 2px 14px 6px;
      /* Страховка на случай длинной неразрывной строки: во всю ширину
         карточки такое почти не встречается, но реестровый номер или
         адрес разорвать всё равно лучше, чем вылезти за край. */
      overflow-wrap: break-word;
    }
    /* Подпись столбца над значением. Набор повторяет шапку на компьютере:
       мелкий капс в разрядку — читатель узнаёт в ней ту же самую шапку. */
    .prose :global(tbody td::before) {
      content: attr(data-label);
      display: block;
      /* Шрифт интерфейса, а не антиква статьи: подпись — служебная надпись,
         как в шапке таблицы на компьютере, и набрана она должна быть тем же. */
      font-family: var(--font-body);
      font-size: 11.5px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-weight: 500;
      color: var(--muted);
      margin-bottom: 1px;
    }
    /* Первая ячейка — заголовок карточки, а не пара «подпись — значение». */
    .prose :global(tbody td:first-child) {
      font-weight: 600;
      font-size: 16px;
      color: var(--ink);
      padding-top: 12px;
      padding-bottom: 2px;
    }
    .prose :global(tbody td:first-child::before) { content: none; }
  }


---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import { getCollection, render } from 'astro:content'
import { href, SITE } from '../../config/site'

export async function getStaticPaths() {
  const articles = await getCollection('articles')
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }))
}

const { article } = Astro.props
const { Content } = await render(article)

// Ссылки внутри текста статьи чинятся здесь, а не в самих статьях.
//
// В чём была беда. Ссылки, поставленные компонентами, проходят через
// href() и получают подпапку, в которой живёт сайт. Ссылки, написанные
// в markdown, через href() не проходят: «/proverit-sro/» так и уходит
// в разметку и на боевом адресе ведёт в корень домена, где ничего нет.
// На локальном превью подпапки нет, поэтому проверка ссылок молчала,
// а заказчик получил страницу «Site not found» от GitHub. Битых ссылок
// набралось двадцать девять.
//
// Чинить в самих статьях нельзя: подпапка зависит от того, куда собирают,
// и автор статьи её знать не обязан. Поэтому правим готовую разметку —
// один раз на сборке, для всех статей сразу, включая те, что напишут
// потом. Трогаем только ссылки от корня: внешние (со схемой), якорные
// и относительные остаются как есть.
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const withBase = (html: string) =>
  base ? html.replace(/(href|src)="\/(?!\/)/g, `$1="${base}/`) : html

// Подписи столбцов переносятся в сами ячейки — атрибутом data-label.
//
// Зачем. На телефоне таблица из статьи разворачивается в карточки (правила
// внизу файла), и каждой ячейке нужна своя подпись: «ООО», «ИП», «Документ».
// В markdown таких атрибутов не напишешь, а требовать их от автора статьи
// нельзя — он пишет обычную таблицу в три палочки. Поэтому подписи
// проставляются на сборке: столько же, сколько ячеек в строке, по порядку.
//
// Заодно это работает для статей, которые напишут потом: ничего
// дописывать в них не придётся.
const withLabels = (html: string) =>
  html.replace(/<table(\s[^>]*)?>[\s\S]*?<\/table>/g, (table) => {
    const head = table.match(/<thead>([\s\S]*?)<\/thead>/)
    if (!head) return table
    // Текст шапки уже экранирован разметкой, остаётся снять теги
    // и закрыть кавычку — иначе она оборвала бы сам атрибут.
    const heads = [...head[1].matchAll(/<th[^>]*>([\s\S]*?)<\/th>/g)].map((m) =>
      m[1].replace(/<[^>]+>/g, '').trim().replace(/"/g, '&quot;'),
    )
    if (heads.length < 2) return table
    return table.replace(/<tbody>[\s\S]*?<\/tbody>/, (tbody) =>
      tbody.replace(/<tr>[\s\S]*?<\/tr>/g, (row) => {
        let i = 0
        return row.replace(/<td(\s[^>]*)?>/g, (td, attrs: string | undefined) => {
          const label = heads[i++]
          return label ? `<td${attrs ?? ''} data-label="${label}">` : td
        })
      }),
    )
  })

// Готовая разметка статьи лежит в самой записи коллекции. Если её вдруг
// не окажется — рисуем обычным компонентом: лучше ссылки без подпапки,
// чем пустая страница.
const rendered = (article as { rendered?: { html?: string } }).rendered?.html

const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })

// Другие статьи — чтобы читатель не уходил после одной страницы.
const others = (await getCollection('articles'))
  .filter((a) => a.id !== article.id)
  .sort((a, b) => (b.data.updated ?? b.data.published).getTime() - (a.data.updated ?? a.data.published).getTime())
  .slice(0, 2)

const articleSchema = {
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.published.toISOString(),
  dateModified: (article.data.updated ?? article.data.published).toISOString(),
  author: { '@type': 'Person', name: 'Багишев Алихан Ахадович' },
  publisher: { '@id': new URL('/', Astro.site).toString() + '#org' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: 'ru-RU',
}
---

<Base
  title={`${article.data.metaTitle ?? article.data.title} | НОРМА`}
  description={article.data.description}
  schema={[articleSchema]}
  breadcrumbs={[
    { label: 'Главная', url: href('/') },
    { label: 'База знаний', url: href('/baza-znaniy/') },
    { label: article.data.title },
  ]}
>
  <article class="art">
    <header class="art-head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Хлебные крошки">
          <a href={href('/')}>Главная</a>
          <span aria-hidden="true">/</span>
          <a href={href('/baza-znaniy/')}>База знаний</a>
        </nav>
        <h1>{article.data.title}</h1>
        <div class="meta">
          <time datetime={article.data.published.toISOString().slice(0, 10)}>
            Опубликовано {fmt(article.data.published)}
          </time>
          {article.data.updated && (
            <span class="upd">
              <Icon name="check" size={14} />
              Сверено с законом {fmt(article.data.updated)}
            </span>
          )}
        </div>
      </div>
    </header>

    <div class="wrap art-body">
      <div class="prose">
        {rendered ? <Fragment set:html={withLabels(withBase(rendered))} /> : <Content />}
      </div>

      <aside class="art-side">
        {article.data.relatedService && (
          <div class="side-card side-card--acc">
            <span class="sc-label">По этой теме</span>
            <h2>{article.data.relatedService.label}</h2>
            <p>Разбор нормы — это половина дела. Вторая половина — правильно оформленные документы.</p>
            <a class="btn btn--acc" href={href(article.data.relatedService.url)}>Перейти к услуге</a>
          </div>
        )}

        <div class="side-card">
          <span class="sc-label">Быстрая проверка</span>
          <h2>Нужна ли СРО именно вам</h2>
          <p>Четыре вопроса, ответ со ссылкой на норму. Если членство не требуется — так и напишем.</p>
          <a class="btn btn--ghost" href={href('/#calc')}>Открыть калькулятор</a>
        </div>

        <div class="side-card side-card--quiet">
          <span class="sc-label">Связаться</span>
          <a class="side-phone" href={SITE.phoneHref} data-goal="click_phone">{SITE.phone}</a>
          <p>{SITE.geoShort}. Отвечаю лично.</p>
          <div class="side-msgs">
            <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" data-goal="click_whatsapp">WhatsApp</a>
            <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" data-goal="click_telegram">Telegram</a>
          </div>
        </div>
      </aside>
    </div>

    {others.length > 0 && (
      <section class="section next">
        <div class="wrap">
          <h2>Читайте дальше</h2>
          <div class="grid-2">
            {others.map((a) => (
              <a class="card next-card" href={href(`/baza-znaniy/${a.id}/`)}>
                <span class="nc-date">{fmt(a.data.updated ?? a.data.published)}</span>
                <h3>{a.data.title}</h3>
                <p>{a.data.excerpt}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .art-head { background: var(--dark); color: var(--on-dark); padding: 34px 0 40px; }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--on-dark-muted); margin-bottom: 18px; flex-wrap: wrap; }
  .crumbs a { color: var(--on-dark-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--acc-bright); }
  .art-head h1 { color: #fff; max-width: 24ch; }
  .meta { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 18px; font-family: var(--font-mono); font-size: 12px; color: var(--on-dark-muted); }
  .upd { display: inline-flex; align-items: center; gap: 6px; color: var(--acc-bright); }

  .art-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 40px; padding-top: 40px; padding-bottom: 20px; align-items: start; }

  /* Статья набирается антиквой: её читают целиком, а не просматривают. */
  .prose {
    max-width: 68ch;
    min-width: 0;
    font-family: var(--font-head);
    font-size: 17.5px;
    line-height: 1.7;
  }
  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(h2) { font-size: 25px; margin: 36px 0 14px; }
  .prose :global(h3) { font-size: 19px; margin: 28px 0 10px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 20px; padding-left: 24px; display: grid; gap: 8px; }
  .prose :global(li) { line-height: 1.65; }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(a) { color: var(--acc-deep); }
  .prose :global(blockquote) {
    margin: 0 0 20px;
    padding: 14px 20px;
    border-left: 3px solid var(--acc);
    background: var(--acc-soft);
    border-radius: 0 var(--r-s) var(--r-s) 0;
  }
  /* ── Таблицы в статьях ──
     Разметка статей — обычный markdown, и таблица приходит из него голым
     <table>: без рамки, без шапки, без полосок между строками. На телефоне
     это читалось не как таблица, а как текст, случайно разложенный
     столбиками. Оформление повторяет table.data с остальных страниц сайта,
     но без жёсткой минимальной ширины: в статьях таблицы узкие — две-три
     колонки коротких значений, — и общий минимум в 560 px гнал бы их
     в горизонтальную прокрутку на ровном месте.
     Первая колонка — подпись строки, поэтому она набрана полужирным:
     в сравнительной таблице глаз идёт по ней. */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    overflow: hidden;
    background: var(--card);
    margin: 0 0 24px;
    font-size: 14.5px;
    line-height: 1.5;
  }
  .prose :global(thead th) {
    text-align: left;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
    padding: 11px 14px;
    vertical-align: bottom;
  }
  /* Первый столбец шапки часто пустой — это угол сравнительной таблицы,
     и подчёркивать его нечем. */
  .prose :global(thead th:empty) { background: var(--paper-2); }
  .prose :global(tbody td) {
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    color: var(--muted);
  }
  .prose :global(tbody tr:last-child td) { border-bottom: 0; }
  .prose :global(tbody td:first-child) { font-weight: 600; color: var(--ink); }
  /* На узком экране полей меньше: 14 px с каждой стороны на телефоне
     съедали треть колонки.
     table-layout: fixed — обязательно, а не для красоты. При обычной
     раскладке ширину таблицы определяет самое длинное неразрывное
     содержимое ячеек, и заголовок «Проектировщики и изыскатели» растягивал
     её до 399 px на экране в 390: правый столбец обрезался, а страница
     получала горизонтальную прокрутку. С фиксированной раскладкой колонки
     делят ширину поровну, а текст переносится. */
  /* На телефоне таблица разворачивается в карточки — тот же приём, что
     у table.data на остальных страницах сайта.
     Так вышло не сразу. Сначала колонки просто делили ширину поровну
     (table-layout: fixed) и текст переносился по буквам, потому что
     словаря русских переносов в браузере может не быть. На трёх колонках
     в 390 px это давало «предпринима|теля», «компенсацио|нный»
     и «рассмотрени|я» — сравнительную таблицу в таком виде не читают,
     её разгадывают. Ширины взять неоткуда: колонке достаётся сотня
     пикселей, а слова в русском длиннее.
     Поэтому строка становится карточкой: первая ячейка — её заголовок,
     остальные идут парами «подпись сверху, значение под ней». Подпись
     берётся из data-label, который проставляется на сборке (см. верх
     файла), а шапка прячется — дублировать её незачем. */
  @media (max-width: 599px) {
    .prose :global(table) { display: block; font-size: 15px; }
    /* Шапку убираем из виду, но оставляем в разметке: она нужна тем,
       кто читает страницу голосом. */
    .prose :global(thead) {
      position: absolute;
      width: 1px; height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .prose :global(tbody), .prose :global(tbody tr) { display: block; }
    .prose :global(tbody tr) { border-bottom: 1px solid var(--line); padding-bottom: 10px; }
    .prose :global(tbody tr:last-child) { border-bottom: 0; }
    .prose :global(tbody td) {
      display: block;
      border-bottom: 0;
      padding: 2px 14px 6px;
      /* Страховка на случай длинной неразрывной строки: во всю ширину
         карточки такое почти не встречается, но реестровый номер или
         адрес разорвать всё равно лучше, чем вылезти за край. */
      overflow-wrap: break-word;
    }
    /* Подпись столбца над значением. Набор повторяет шапку на компьютере:
       мелкий капс в разрядку — читатель узнаёт в ней ту же самую шапку. */
    .prose :global(tbody td::before) {
      content: attr(data-label);
      display: block;
      /* Шрифт интерфейса, а не антиква статьи: подпись — служебная надпись,
         как в шапке таблицы на компьютере, и набрана она должна быть тем же. */
      font-family: var(--font-body);
      font-size: 11.5px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-weight: 500;
      color: var(--muted);
      margin-bottom: 1px;
    }
    /* Первая ячейка — заголовок карточки, а не пара «подпись — значение». */
    .prose :global(tbody td:first-child) {
      font-weight: 600;
      font-size: 16px;
      color: var(--ink);
      padding-top: 12px;
      padding-bottom: 2px;
    }
    .prose :global(tbody td:first-child::before) { content: none; }
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 5px;
  }

  .art-side { display: grid; gap: 14px; position: sticky; top: 96px; }
  .side-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-l);
    padding: 22px;
    display: grid;
    gap: 10px;
  }
  .side-card--acc { background: var(--acc-soft); border-color: color-mix(in srgb, var(--acc) 30%, transparent); }
  .side-card--quiet { background: var(--dark); border-color: var(--dark-line); color: var(--on-dark); }
  .sc-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .side-card--quiet .sc-label { color: var(--on-dark-muted); }
  .side-card h2 { font-size: 17px; }
  .side-card--quiet h2 { color: #fff; }
  .side-card p { font-size: 14px; color: var(--muted); }
  .side-card--quiet p { color: var(--on-dark-muted); }
  .side-card .btn { justify-self: start; }

  .side-phone { font-family: var(--font-mono); font-size: 19px; color: #fff; text-decoration: none; }
  .side-phone:hover { color: var(--acc-bright); }
  .side-msgs { display: flex; gap: 14px; }
  .side-msgs a { color: var(--acc-bright); font-size: 14px; text-decoration: none; }

  .next { background: var(--card); border-top: 1px solid var(--line); }
  .next h2 { font-size: 22px; margin-bottom: 18px; }
  .next-card { display: grid; gap: 8px; align-content: start; }
  .nc-date { font-family: var(--font-mono); font-size: 11.5px; color: var(--muted); }
  .next-card h3 { font-size: 17px; margin: 0; }

  @media (max-width: 900px) {
    .art-body { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .art-side { position: static; }
  }
</style>

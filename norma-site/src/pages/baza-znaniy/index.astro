---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import { getCollection } from 'astro:content'
import { href, SITE } from '../../config/site'
import HeadPhoto from '../../components/HeadPhoto.astro'

// Список разложен по разделам, а не по дате.
//
// По дате он и был, и это сломалось ровно тогда, когда статей стало
// двадцать четыре: написанные в один день встали в порядке имён файлов,
// а четыре сильнейшие — про порог 10 млн, отменённые допуски, субподряд
// и отказ на торгах — уехали в самый низ просто потому, что написаны
// раньше. Человек, пришедший с вопросом «нужна ли мне СРО», видел первой
// статью про исключение из СРО.
//
// Даты со страниц никуда не делись: они стоят у каждой статьи и работают
// как знак свежести. Но порядок задаёт польза, а не хронология.
const GROUPS = [
  { id: 'need', t: 'Нужна ли вам СРО', d: 'С этого стоит начать: половине обратившихся членство не требуется.' },
  { id: 'money', t: 'Деньги', d: 'Взносы, уровни ответственности и то, что нельзя вернуть.' },
  { id: 'membership', t: 'Членство', d: 'Приём, отказ, выход, исключение — и что из этого следует.' },
  { id: 'check', t: 'Проверяемость', d: 'Что видно в реестрах и как проверить себя и подрядчика.' },
] as const

const all = await getCollection('articles')
const grouped = GROUPS.map((g) => ({
  ...g,
  items: all
    .filter((a) => a.data.group === g.id)
    .sort((a, b) => a.data.order - b.data.order),
})).filter((g) => g.items.length > 0)

const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })

// Состав базы знаний машинным списком — в том же порядке, что и на странице:
// разметка не должна расходиться с тем, что видит человек.
const articlesList = {
  '@type': 'ItemList',
  name: 'База знаний о СРО',
  itemListElement: grouped.flatMap((g) => g.items).map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.data.title,
    url: new URL(href(`/baza-znaniy/${a.id}/`), Astro.site).toString(),
  })),
}
---

<Base
  title="База знаний о СРО — разборы норм с датами проверки | НОРМА"
  description="Разборы норм о СРО, НРС и НОК: порог 10 млн, субподряд, отмена допусков, причины отказа на торгах. У каждой статьи указаны дата публикации и дата последней сверки с законом."
  breadcrumbs={[
    { label: 'Главная', url: href('/') },
    { label: 'База знаний' },
  ]}
  pageType="CollectionPage"
  schema={[articlesList]}
>
  <section class="section page-head">
    <HeadPhoto position="68% 62%" />
    <div class="wrap">
      <span class="eyebrow">База знаний</span>
      <h1>Разборы норм — с датами, а не «вообще»</h1>
      <p class="lead">
        В этой теме законодательство меняется каждый год, а статьи живут в поиске десятилетиями.
        Поэтому у каждого материала здесь стоят <b>две даты</b>: когда он написан и когда в последний
        раз сверен с действующей редакцией закона. Если даты нет — читать такой текст опасно,
        неважно, чей это сайт.
      </p>
      <div class="stamp-row">
        {/* «Все материалы сверены» здесь было неверно ровно в тот момент,
            когда дату на печати подняли: у статей даты свои, и часть из них
            осталась прежней. Абзац выше как раз обещает две даты у каждого
            материала — значит, общий штамп не должен говорить за них. */}
        <span class="stamp">Нормы сверены · {SITE.checkedDate}</span>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      {grouped.map((g) => (
      <div class="grp">
        <div class="grp-head rv">
          <h2>{g.t}</h2>
          <p>{g.d}</p>
        </div>
      <div class="list">
        {g.items.map((a) => (
          <article class="row rv">
            <div class="dates">
              <time datetime={a.data.published.toISOString().slice(0, 10)}>
                Опубликовано {fmt(a.data.published)}
              </time>
              {a.data.updated && (
                <time class="upd" datetime={a.data.updated.toISOString().slice(0, 10)}>
                  Проверено {fmt(a.data.updated)}
                </time>
              )}
            </div>
            <h3><a href={href(`/baza-znaniy/${a.id}/`)}>{a.data.title}</a></h3>
            <p>{a.data.excerpt}</p>
            <div class="row-foot">
              <a class="go" href={href(`/baza-znaniy/${a.id}/`)}>Читать разбор <Icon name="arrow" size={15} /></a>
              {a.data.relatedService && (
                <a class="rel" href={href(a.data.relatedService.url)}>
                  Услуга: {a.data.relatedService.label}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
      </div>
      ))}

      <div class="ask rv">
        <div>
          <h2>Не нашли свой случай?</h2>
          <p>Опишите ситуацию — разберу и отвечу лично. Если членство вам не нужно, я так и скажу.</p>
        </div>
        <a class="btn btn--acc" href={href('/kontakty/')}>Задать вопрос</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Класс общий для всех тёмных шапок сайта — не переименовывайте его
     по вкусу отдельной страницы. Общие правила (штамп «Проверено»,
     отмена размерной линии под шапкой) написаны на .page-head, и стоит
     завести здесь своё имя, как страница молча теряет их. Один раз так
     уже вышло: штамп на этой странице читался 2.9:1 при норме 4.5. */
  .page-head { background: var(--dark); color: var(--on-dark); padding-bottom: 44px; }
  .page-head .eyebrow { color: var(--acc-bright); }
  .page-head h1 { color: #fff; margin: 12px 0 16px; max-width: 20ch; }
  .page-head .lead { color: var(--on-dark-muted); }
  .page-head .lead b { color: #fff; }
  .stamp-row { margin-top: 22px; }

  .list { display: grid; }
  /* Раздел списка. Заголовок стоит в собственной строке над своими
     статьями: подписей в две строки на весь список хватает, чтобы глаз
     находил границу темы. */
  .grp + .grp { margin-top: 46px; }
  .grp-head { padding-bottom: 6px; border-bottom: 2px solid var(--ink); }
  .grp-head h2 { font-size: clamp(22px, 2.4vw, 27px); }
  .grp-head p { color: var(--muted); font-size: 15px; margin-top: 6px; max-width: 62ch; }

  .row { padding: 28px 0; border-bottom: 1px solid var(--line); display: grid; gap: 8px; }
  .row h3 { font-family: var(--font-head); font-size: clamp(19px, 2vw, 23px); font-weight: 700; letter-spacing: -0.015em; }
  .row h3 a { color: var(--ink); text-decoration: none; }
  .row h3 a:hover { color: var(--acc-deep); }
  .row:first-child { padding-top: 0; }

  .dates { display: flex; gap: 14px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 11.5px; color: var(--muted); }
  .upd { color: var(--good); font-weight: 500; }

  .row h2 { font-size: clamp(20px, 2.6vw, 25px); }
  .row h2 a { color: var(--ink); text-decoration: none; }
  .row h2 a:hover { color: var(--acc-deep); }
  .row p { color: var(--muted); font-size: 15.5px; max-width: 78ch; }

  .row-foot { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; margin-top: 4px; }
  .go { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 15px; color: var(--acc-deep); text-decoration: none; }
  .rel {
    font-size: 13.5px;
    color: var(--muted);
    padding-block: 6px;
    margin-block: -6px;
  }

  .ask {
    margin-top: 32px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-l);
    padding: 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .ask h2 { font-size: 21px; margin-bottom: 6px; }
  .ask p { color: var(--muted); font-size: 15px; max-width: 56ch; }

  @media (max-width: 600px) {
    .ask .btn { width: 100%; }
  }
</style>

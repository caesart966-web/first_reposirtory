---
import Base from '../../layouts/Base.astro'
import LeadForm from '../../components/LeadForm.astro'
import { REGIONS } from '../../config/regions'
import { LAW } from '../../config/facts'
import { href, SITE } from '../../config/site'
import { partnersOf } from '../../config/partners'

// Оглавление городских страниц.
//
// Нужно не только человеку, но и поисковику: без него городские страницы
// висели бы без единой входящей ссылки, а страница без ссылок для робота
// почти не существует. Отсюда же на них ведут подвал и главное меню.
//
// Порядок — как в regions.ts. Раньше здесь была сортировка по алфавиту,
// и для тридцати трёх городов она была единственной, которую не пришлось
// бы обосновывать рейтингом. Городов осталось три, все с партнёрскими СРО;
// алфавит между ними ничего не значит, а порядок из конфигурации правится
// в одном месте.
const list = REGIONS

// Число городов считается, а не пишется словом: список пополняется,
// а написанное однажды число молча расходится с сайтом.
const n = REGIONS.length
const tail = n % 10
const ten = n % 100
const gorodov = ten >= 11 && ten <= 14 ? 'городов' : tail === 1 ? 'город' : tail >= 2 && tail <= 4 ? 'города' : 'городов'

const itemList = {
  '@type': 'ItemList',
  name: 'Вступление в СРО по городам',
  itemListElement: list.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `Вступление в СРО ${r.inCity}`,
    url: new URL(href(`/sro/${r.slug}/`), Astro.site).toString(),
  })),
}
---

<Base
  title="Вступление в СРО по городам — регион и выбор организации | НОРМА"
  description={`Какая СРО нужна компании из вашего региона: субъект РФ, региональный принцип для строителей и его отсутствие у проектировщиков. Партнёрские СРО в ${n} городах, работа по всей России.`}
  pageType="CollectionPage"
  schema={[itemList]}
  breadcrumbs={[{ label: 'Главная', url: href('/') }, { label: 'Города' }]}
>
  {/* Фотографии здесь нет — как и на самих городских страницах.
      Пробовал поставить: штамп «Сверено» пришёлся ровно на светлое пятно
      кадра и дал 2.13:1 при норме 4.5. Сдвигать кадр ради одной страницы
      смысла нет — семейство «Города» и так живёт без фотографий. */}
  <section class="section page-head">
    <div class="wrap">
      <span class="eyebrow">География</span>
      <h1>Вступление в СРО <em>по городам</em></h1>
      <p class="lead">
        Работаю по всей России дистанционно. Но у строителей есть региональная привязка:
        саморегулируемая организация должна быть зарегистрирована в том же субъекте РФ,
        что и компания. <b>У проектировщиков и изыскателей такой привязки нет вовсе.</b>
      </p>
      <div class="head-tags">
        <span class="stamp">Сверено с законом · {SITE.checkedDate}</span>
        <span class="law law--dark">{LAW.membership}</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="s-head rv">
        <span class="eyebrow">Где есть партнёры</span>
        <h2>Три города с <em>готовыми СРО</em></h2>
        <p>
          В этих трёх городах у меня есть партнёрские организации с регистрационными
          номерами: их можно открыть в государственном реестре до того, как вы
          что-то подпишете. По каждому городу — разбор субъекта и ошибки,
          которую в нём делают чаще всего.
        </p>
      </div>

      <div class="grid-3">
        {list.map((r) => {
          const k = partnersOf(r.slug).length
          return (
            <a class="card ccard rv" href={href(`/sro/${r.slug}/`)}>
              <h3>{r.city}</h3>
              <span class="csub">{r.subject}</span>
              <span class="ccode">код {r.code}</span>
              <span class="cn">
                {k} {k === 1 ? 'партнёрская СРО' : k < 5 ? 'партнёрские СРО' : 'партнёрских СРО'}
              </span>
            </a>
          )
        })}
      </div>

      {/* Главный абзац этой страницы — для тех, кто не из трёх городов,
          а таких большинство. Раньше их вопрос закрывал список из тридцати
          трёх городов; теперь закрывает только этот блок, поэтому он
          и оформлен заметно, а не примечанием мелким шрифтом. */}
      <div class="rest rv">
        <h3>А если ваш регион не в списке</h3>
        <p>
          <b>Работаю со всеми субъектами России.</b> Отсутствие города здесь означает
          ровно одно: у меня нет в нём заранее подобранной партнёрской организации.
          Это не отказ и не «дороже» — просто СРО вашего субъекта я подбираю
          под ваш случай отдельно и называю её по имени и с номером в реестре
          до подписания чего-либо.
        </p>
        <ul>
          <li>
            <b>Строителю</b> нужна СРО того же субъекта РФ, что и регистрация компании —
            это норма закона, и обойти её нельзя ни в каком регионе.
          </li>
          <li>
            <b>Проектировщику и изыскателю</b> регион не важен вовсе: им подходит
            организация из любого субъекта, в том числе петербургская из моего списка.
            Для них география вопроса не создаёт.
          </li>
        </ul>
        <p class="rest-go">
          <a href={href('/kontakty/#form')}>Написать, где зарегистрирована компания →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="zayavka" data-anchor>
    <div class="wrap narrow">
      <LeadForm
        title="Не нашли свой город — напишите"
        subtitle="Скажите, где зарегистрирована компания и что за работы. Отвечу, нужно ли вам членство, какая организация подойдёт по региону и во что это обойдётся."
      />
    </div>
  </section>
</Base>

<style>
  /* .head-tags описан на каждой странице отдельно, общего правила нет. */
  .head-tags { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 22px; align-items: center; }

  .ccard {
    display: grid;
    gap: 6px;
    align-content: start;
    text-decoration: none;
    color: var(--ink);
  }
  .ccard h3 { margin: 0; font-size: 21px; }
  .ccard:hover { border-color: var(--acc); }
  .csub { font-size: 14.5px; color: var(--muted); line-height: 1.45; }
  .ccode {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--acc-deep);
  }
  .cn {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--acc-deep);
  }

  /* Блок «а если вашего региона нет» — на тёплом листе и с красной
     линейкой слева: для большинства читателей он главный на странице,
     и примечанием мелким шрифтом ему быть нельзя. */
  .rest {
    margin-top: 34px;
    padding: 24px 26px;
    background: var(--paper-2);
    border-left: 3px solid var(--acc);
    border-radius: 0 var(--r-m) var(--r-m) 0;
    max-width: 80ch;
  }
  .rest h3 { margin: 0 0 10px; font-size: 19px; }
  .rest p { margin: 0; color: var(--muted); line-height: 1.7; }
  .rest b { color: var(--ink); }
  .rest ul {
    margin: 14px 0 0;
    padding-left: 22px;
    display: grid;
    gap: 9px;
    color: var(--muted);
    line-height: 1.65;
  }
  .rest-go { margin-top: 16px !important; font-weight: 600; }
  .rest-go a { color: var(--acc-deep); text-decoration: none; }
  .rest-go a:hover { text-decoration: underline; }

  @media (max-width: 599px) {
    .rest { padding: 20px; }
  }
</style>

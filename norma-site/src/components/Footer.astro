---
import { SITE, REGISTRIES, YANDEX_ORG, href } from '../config/site'
import { SERVICES } from '../config/services'
import { REGIONS } from '../config/regions'
import LogoMark from './LogoMark.astro'
import ShareLinks from './ShareLinks.astro'
import YandexRating from './YandexRating.astro'

interface Props {
  /** Название страницы — для ссылок «Поделиться». */
  title?: string
  /**
   * Строка «Поделиться страницей» внизу. У статей её нет: там своя, заметная,
   * сразу под текстом, и вторая такая же в подвале была бы повтором.
   * У 404 и поиска тоже нет — делиться там нечем.
   */
  share?: boolean
}
const { title = SITE.brand, share = true } = Astro.props
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString()

// Список услуг берётся из config/services.ts, а не переписан здесь руками:
// раньше он был копией и при добавлении услуги подвал молча отставал.
// У трёх видов СРО — полное название («Вступление в СРО строителей»), а не
// короткое: короткие стоят заголовками карточек на главной, и одинаковый
// текст двух ссылок второй аудит 28.09.2026 отметил повтором. Полное к тому
// же совпадает с H1 страницы, на которую ведёт. У остальных услуг полные
// названия длинные («Промышленная, пожарная безопасность и…») и разорвали
// бы колонку — у них повтора нет.
const services = SERVICES.map((s) => ({ label: s.dirIcon ? s.title : s.short, url: href(`/uslugi/${s.slug}/`) }))

const pages = [
  { label: 'Кому нужна СРО, а кому нет', url: href('/komu-nuzhna-sro/') },
  { label: 'Какие документы нужны', url: href('/dokumenty/') },
  { label: 'Как проверить СРО', url: href('/proverit-sro/') },
  // Подписи длиннее, чем в меню шапки, нарочно: одинаковый текст ссылки
  // дважды на странице аудит 28.09.2026 отметил повтором, а поисковику
  // «Стоимость вступления в СРО» говорит о странице больше, чем «Стоимость».
  { label: 'Стоимость вступления в СРО', url: href('/stoimost/') },
  { label: 'База знаний о СРО', url: href('/baza-znaniy/') },
  { label: 'Словарь терминов СРО', url: href('/slovar/') },
  { label: 'Вступление в СРО по городам', url: href('/sro/') },
  { label: 'Обо мне: как я работаю', url: href('/obo-mne/') },
  { label: 'Контакты и реквизиты', url: href('/kontakty/') },
  { label: 'Политика обработки данных', url: href('/politika/') },
]

const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div class="brand-col">
        <div class="logo">
          <LogoMark size={28} class="logo-mark" />
          <span class="logo-text"><span class="logo-name">{SITE.brand}</span>{' '}<small>{SITE.brandTag}</small></span>
        </div>
        <p class="tagline">
          Помощь во вступлении в СРО, внесении специалистов в НРС, прохождении НОК
          и получении лицензий. Если СРО вам не нужна — скажу прямо.
        </p>
        <a class="fphone" href={SITE.phoneHref}>{SITE.phone}</a>
        <a class="fmail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <div class="msgs">
          <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href={SITE.telegram} target="_blank" rel="noopener noreferrer">Telegram</a>
          {SITE.maxLink && <a href={SITE.maxLink} target="_blank" rel="noopener noreferrer" data-goal="click_max">MAX</a>}
        </div>
        {/* Рейтинг на Яндекс Картах (с 05.10.2026): значок — только после
            «Принять», до того ссылка на карточку того же размера
            (YandexRating.astro). «Оставить отзыв» ведёт прямо в форму —
            та же ссылка, что в QR на «Контактах». */}
        {YANDEX_ORG && (
          <div class="frate">
            <YandexRating tone="dark" />
            <a class="freview" href={SITE.reviewLink} target="_blank" rel="noopener noreferrer" data-goal="click_review">
              Оставить отзыв
            </a>
          </div>
        )}
      </div>

      <div>
        <h2>Услуги</h2>
        <ul>{services.map((s) => <li><a href={s.url}>{s.label}</a></li>)}</ul>
      </div>

      <div>
        <h2>Разделы</h2>
        <ul>{pages.map((p) => <li><a href={p.url}>{p.label}</a></li>)}</ul>
      </div>

      <div>
        <h2>Проверить СРО</h2>
        <ul>
          <li><a href={REGISTRIES.nostroy} target="_blank" rel="noopener noreferrer">reestr.nostroy.ru — строители</a></li>
          <li><a href={REGISTRIES.nopriz} target="_blank" rel="noopener noreferrer">nopriz.ru — проектировщики и изыскатели</a></li>
        </ul>
        <p class="note">
          Официальные реестры национальных объединений. Членство любой компании
          и статус любой СРО проверяются там бесплатно и за минуту. Меня в этих
          реестрах нет: я не саморегулируемая организация. Мои реквизиты — в ЕГРИП
          на сайте ФНС.
        </p>
      </div>
    </div>

    <!-- Полоса городов. Городов теперь три — те, где есть партнёрские
         СРО, — и полоса называет их прямо, а не просто перечисляет.
         Раньше здесь стояли все тридцать три: полоса давала каждой
         городской странице входящую ссылку со всех остальных страниц
         сайта. С тремя этот довод почти исчерпан, но строка остаётся
         полезной человеку: она отвечает на вопрос «а вы в моём городе?»
         на любой странице, не заставляя никуда ходить. -->
    <nav class="cities" aria-label="Города, где есть партнёрские СРО">
      <a class="cities-label" href={href('/partnery/')}>Партнёрские СРО:</a>
      {/* «в Москве», а не «Москва»: те же названия стоят заголовками
          карточек городов на главной, и одинаковый текст двух ссылок аудит
          отмечает повтором. «Партнёрские СРО: в Москве» и читается так. */}
      {REGIONS.map((r) => (
        <a href={href(`/sro/${r.slug}/`)}>{r.inCity}</a>
      ))}
      <a class="cities-all" href={href('/sro/')}>остальные регионы →</a>
    </nav>

    <div class="legal">
      <p>
        {SITE.legalName}. ИНН {SITE.inn}.{SITE.ogrnip && ` ОГРНИП ${SITE.ogrnip}.`} {SITE.geo}.
      </p>
      {/* От первого лица, как весь сайт: здесь в одном месте стояло «Мы
          не являемся…», и аудит 29.09.2026 это заметил. «Нормы закона
          сверены», а не «информация на сайте»: взносы и условия СРО законом
          не установлены, сверять их с кодексом нечего — так же подписана
          печать. */}
      <p class="disclaimer">
        Сайт носит информационный характер и не является публичной офертой.
        Я не являюсь саморегулируемой организацией и не выдаю документы о членстве:
        решение о приёме принимает СРО, взносы вносятся напрямую в неё.
        Нормы закона на сайте сверены с действующей редакцией Градостроительного кодекса РФ
        {' '}{SITE.checkedDate}.
      </p>
      {share && <ShareLinks url={pageUrl} title={title} tone="dark" />}
      <p class="copy">© {year} {SITE.brand}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: var(--on-dark-muted);
    padding: 48px 0 32px;
    font-size: 14.5px;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--dark-line);
  }

  .brand-col { display: grid; gap: 12px; align-content: start; }

  .logo { display: flex; align-items: center; gap: 12px; color: #fff; }
  /* :global обязателен — знак приходит из отдельного компонента, и обычное
     правило до него не достаёт: Astro привязывает стили к служебному атрибуту,
     которого у чужой разметки нет. Без этого знак остался бы белым. */
  .logo :global(.logo-mark) { color: var(--acc-bright); flex: none; display: block; }
  .logo-text { display: grid; line-height: 1.15; }
  .logo-name { font-family: var(--font-head); font-size: 17px; font-weight: 800; letter-spacing: 0.08em; }
  .logo-text small { font-size: 11px; color: var(--on-dark-muted); }

  .tagline { max-width: 40ch; }

  .fphone {
    font-family: var(--font-mono);
    font-size: 19px;
    color: #fff;
    text-decoration: none;
    font-weight: 500;
  }
  .fphone:hover { color: var(--acc-bright); }
  /* Ссылки в подвале — навигация, а не текст в абзаце: по стандарту
     доступности в них нужно попадать пальцем, поэтому высота от 24 px. */
  .fmail { color: var(--on-dark-muted); text-decoration: none; padding: 3px 0; display: inline-block; }
  .fmail:hover { color: var(--acc-bright); }

  .msgs { display: flex; gap: 14px; flex-wrap: wrap; }
  /* 4 px давали высоту нажатия 23 px — меньше нормы в 24. Восемь дают 31,
     а строка стоит там же: у .msgs есть свой gap, и вертикальный отступ
     ссылок на раскладку подвала не влияет. */
  .msgs a { color: var(--acc-bright); text-decoration: none; font-size: 14px; padding: 8px 0; }
  .msgs a:hover { text-decoration: underline; }

  .frate { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin-top: 6px; }
  .freview { color: var(--acc-bright); text-decoration: none; font-size: 14px; padding: 8px 0; }
  .freview:hover { text-decoration: underline; }

  /* Подписи колонок — h2, а не h3, и это не про размер шрифта.
     На странице 404 в теле нет ни одного h2: там заголовок, карточки
     ссылок и всё. Подвал с h3 давал последовательность h1 → h3 —
     пропуск уровня, по которому ходят с экранным диктором. С h2 порядок
     сходится и там, и на страницах с разделами. */
  h2 { color: #fff; font-size: 15px; font-weight: 700; margin-bottom: 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  ul a { color: var(--on-dark-muted); text-decoration: none; display: inline-block; padding: 4px 0; }
  ul a:hover { color: var(--acc-bright); }

  .note { margin-top: 12px; font-size: 12.5px; line-height: 1.5; max-width: 34ch; }

  .legal { padding-top: 24px; display: grid; gap: 10px; font-size: 13px; }
  .disclaimer { max-width: 88ch; line-height: 1.55; }
  /* Не приглушаем сильнее: на тёмном фоне более бледный серый
     не проходит по контрасту для мелкого текста. */
  .copy { color: var(--on-dark-muted); }

  /* Полоса городов над реквизитами. Мелкая, в одну-две строки:
     это навигация, а не витрина. Разделители — точки, чтобы полоса
     читалась строкой, а не списком кнопок. */
  .cities {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin-top: 40px;
    padding-top: 26px;
    border-top: 1px solid var(--dark-line);
    font-size: 13.5px;
  }
  .cities-label { color: var(--on-dark-muted); }
  .cities a {
    color: var(--on-dark-muted);
    text-decoration: none;
    /* Поле промаха: строка мелкая, а попадать в неё нужно пальцем. */
    padding-block: 6px;
    margin-block: -6px;
  }
  .cities a:hover { color: var(--acc-bright); }
  .cities-all { color: var(--acc-bright) !important; }

</style>

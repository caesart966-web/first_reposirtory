---
interface Props {
  size?: number
  class?: string
}
const { size = 32, class: className = '' } = Astro.props

// Фирменный знак: монограмма «Н» с засечками, в которой одновременно
// читается латинская N. Заказчик выбрал её из своего набора логотипов.
//
// Знак перерисован контурами, а не вставлен картинкой. Причины:
// • он остаётся резким на любом экране и при любом размере;
// • весит около 600 байт вместо десятков килобайт;
// • красится через currentColor, поэтому в тёмной шапке он светлый,
//   в подвале — акцентный, на печати — чёрный. Одна и та же разметка.
//
// Геометрия снята с оригинала: пропорции, наклон диагонали (45°),
// ширина стоек и вылет засечек соответствуют исходному рисунку.
---

<svg
  viewBox="0 0 100 100"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  <!-- Левая стойка с засечками. Нижняя засечка общая со средней стойкой:
       так в оригинале, и именно она связывает монограмму в одно целое. -->
  <path
    d="M0 0h31.3v2.8l-9.9 2v90.4l21.1 1.8V100H0.4v-3l9.2-1.8V4.8L0 2.8z"
  />
  <!-- Средняя стойка: срезана под тем же углом, что и диагональ. -->
  <path d="M31.8 46.5 42.5 57.2V98h-10.7z" />
  <!-- Диагональ. Не касается стоек: просвет вокруг неё и делает
       из двух букв одну монограмму, а не тесно составленные литеры. -->
  <path d="M31.8 19.5 69.5 57v16.3L31.8 36z" />
  <!-- Правая стойка с засечками. -->
  <path
    d="M68.7 0h30.9v2.8l-9.8 2v90.4l9.3 1.8V100H68.7v-3l9.3-1.8V4.8l-9.3-2z"
  />
</svg>

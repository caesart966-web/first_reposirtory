  /* ── Чертёж ──
     Стоит справа и намеренно уходит за край экрана: рисунок должен
     читаться как фрагмент большого листа, а не как иконка в рамке. */
  .draft {
    position: absolute;
    z-index: -1;
    right: -60px;
    bottom: 96px;
    width: min(600px, 54vw);
    color: var(--ink);
    opacity: 0.2;
    pointer-events: none;
  }
  .draft .crane { color: var(--acc); opacity: 0.85; }

  /* Линии рисуются по очереди. Приём: длина штриха равна длине самой
     линии, и она сдвинута на всю длину — линия не видна; анимация
     сводит сдвиг к нулю, и линия «выезжает» из точки.
     Значения 1200 хватает на самый длинный путь; для коротких линий
     запас невиден, потому что за пределами пути штрих не рисуется. */
  .draft path {

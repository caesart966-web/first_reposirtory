---
import { SITE, href } from '../config/site'
import { LAW, TERMS } from '../config/facts'
import Icon from './Icon.astro'
import Seal from './Seal.astro'
import { OFFER } from '../config/offer'

// Первый экран — лист бумаги, а не заставка.
//
// Здесь стояло фоновое видео; заказчик попросил его убрать и пересобрать
// сайт в белом. Заменять видео другой картинкой не стали: на сайте про
// документы уместнее чертёж, чем съёмка. Поэтому фон — не изображение,
// а рисунок в разметке:
//
//   1. Сетка миллиметровки. Очень светлая, две частоты линий, как на
//      бумаге для чертежей. Даёт странице фактуру листа, а не пустоту.
//   2. Контур дома с краном, вычерченный тонкой линией. Рисуется при
//      загрузке — линии проявляются по очереди, как под рейсшиной.
//      Это вся «строительная» тема первого экрана; стоковой фотографии
//      с каской на сайте нет и быть не должно.
//   3. Красная печать «сверено» — единственное яркое пятно на белом.
//
// Всё это весит несколько килобайт разметки вместо восьмисот килобайт
// видео и рисуется мгновенно.
//
// Числа внизу набраны как строка сметы: подпись капсом, значение крупно,
// у двух — чип со статьёй закона. С первого экрана видно, что цифры
// на сайте не с потолка.

const stats = [
  { v: TERMS.extract, d: `от подачи документов до выписки из реестра, ${TERMS.extractTypical}` },
  { v: '0 ₽', d: 'подготовка документов и сопровождение — мои услуги' },
  { v: '10', unit: 'млн ₽', d: 'порог, с которого строителю нужно членство', law: LAW.build },
  { v: '≤ 2', unit: 'мес.', d: 'срок рассмотрения по закону; с готовыми документами — дни', law: LAW.term },
]
---

<section class="hero">
  <div class="grid-bg" aria-hidden="true"></div>

  {SITE.heroPhoto && (
    <div
      class="photo"
      aria-hidden="true"
      style={`background-image: url(${href(`/img/${SITE.heroPhoto}`)})`}
    ></div>
  )}

  <!-- Чертёж: дом в лесах и башенный кран. Линии рисуются по очереди при
       загрузке страницы — см. .draft path в стилях ниже. Кран выделен
       красным: на белой странице чертёж целиком серым читался как водяной
       знак, а одна красная деталь превращает его в рисунок. -->
  <svg class="draft" viewBox="0 0 520 420" fill="none" aria-hidden="true" focusable="false">
    <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <path class="d1" d="M60 400h420" />
      <path class="d2" d="M120 400V190l120-64 120 64v210" />
      <path class="d3" d="M120 190h240M120 244h240M120 298h240M120 352h240" />
      <path class="d4" d="M180 244v108M240 190v210M300 244v108" />
      <path class="d5" d="M240 126 120 190M240 126l120 64" />
    </g>
    <g class="crane" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path class="d6" d="M410 400V96h-14v304M396 96h96M492 96v34M492 96 396 76M410 96v-14" />
      <path class="d7" d="M470 96v52m-10-52 10 52h-20l10-52" />
      <path class="d8" d="M396 130l14-34M396 164l14-34M396 198l14-34" />
    </g>
  </svg>

  <div class="wrap hero-in">
    <div class="hero-text">
      <span class="geo"><i></i>{SITE.geoShort}</span>

      <h1 class="page-title">
        Вступление в <em>СРО</em> без устаревших норм
      </h1>

      <p class="hero-lead">
        Строителям, проектировщикам и изыскателям — по всей России.
        Скажу сразу, нужно ли вам членство, и покажу норму, на которой
        это основано. Если не нужно — так и скажу, до оплаты.
      </p>

      <div class="cta">
        <a class="btn btn--acc btn--lg" href="#calc">Проверить, нужна ли СРО</a>
        <a class="btn btn--ghost btn--lg" href={href('/stoimost/')}>Узнать стоимость</a>
      </div>
      <p class="note">2 минуты · 4 вопроса · ответ со ссылкой на закон</p>

    </div>

    {/* Главное предложение сайта. Оформлено как бланк: тонкая рамка,
        подпись капсом сверху, печать в углу. На компьютере занимает
        правую колонку, на телефоне встаёт под кнопками. */}
    <aside class="hero-offer rv">
      <span class="ho-tag">Условия, которых нет больше нигде</span>
      <p class="ho-title">Первый год — <b>только обязательные взносы</b></p>
      <ul class="ho-list">
        {OFFER.map((p) => (
          <li><Icon name="check" size={15} /> {p.short}</li>
        ))}
      </ul>
      <a class="ho-go" href={href('/#predlozhenie')}>
        Все пять условий <Icon name="arrow" size={15} />
      </a>
    </aside>

    {/* Печать стоит здесь, а не на карточке предложения, и это важно.
        Она говорит «сверено с Градостроительным кодексом» — а условия
        вступления в карточке не нормы закона, а условия конкретных СРО.
        Печать рядом с ними означала бы, что закон эти льготы гарантирует;
        он их не гарантирует.

        На телефоне блок идёт после карточки: он спокойный и серый, а до него
        должно попасться на глаза цветное. */}
    <div class="verify rv">
      <span class="v-seal"><Seal size={104} /></span>
      <p>
        Все цифры на сайте сверены с действующей редакцией
        Градостроительного кодекса, и рядом с каждой стоит статья.
        Дату сверки видно на печати — врать ею нельзя.
      </p>
    </div>
  </div>

  <div class="wrap">
    <ul class="stats">
      {stats.map((s) => (
        <li class="stat rv">
          {/* Пробел ставится явно: Astro съедает пробел перед строчным тегом,
              и число слипалось с единицей — «10млн ₽». Отступом в стилях это
              не лечится: при копировании текста и в программе чтения с экрана
              пробела всё равно бы не было. */}
          <span class="v">{s.unit ? <>{s.v}{' '}<em>{s.unit}</em></> : s.v}</span>
          <span class="d">{s.d}</span>
          {s.law && <span class="law">{s.law}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--paper);
    color: var(--ink);
    padding: 46px 0 0;
    overflow: hidden;
  }

  /* ── Фактура листа ──
     Две частоты линий, как на миллиметровке: частая сетка по 22 px и
     редкая по 110. Обе едва различимы — их задача не рисоваться,
     а убрать ощущение пустого белого экрана. Книзу сетка растворяется,
     чтобы не спорить со строкой цифр. */
  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px),
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 110px 110px, 110px 110px, 22px 22px, 22px 22px;
    opacity: 0.55;
    mask-image: linear-gradient(180deg, #000 0%, #000 52%, transparent 92%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 52%, transparent 92%);
    pointer-events: none;
  }

  /* ── Фотография ──
     Появляется, только если она задана в src/config/site.ts (heroPhoto).
     Обработка обязательна и не отключается: сайт белый, а любая фотография
     стройки — тёмная и пёстрая. Поэтому кадр обесцвечивается, слегка
     уводится в тёплый тон под сургучный акцент и растворяется в бумаге
     сверху, снизу и слева. Смысл в том, чтобы фотография читалась как
     фактура листа, а не как заставка: текст остаётся на белом и не требует
     ни пелены, ни тени под буквами.

     Слева она гаснет сильнее — там колонка с заголовком. */
  .photo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: 72% center;
    filter: grayscale(1) contrast(1.05) sepia(0.22);
    opacity: 0.5;
    mask-image:
      linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.35) 34%, #000 72%),
      linear-gradient(180deg, transparent 0%, #000 22%, #000 62%, transparent 96%);
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.35) 34%, #000 72%),
      linear-gradient(180deg, transparent 0%, #000 22%, #000 62%, transparent 96%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
    pointer-events: none;
  }
  /* Когда фотография есть, чертёж уходит: два рисунка на одном фоне
     спорят друг с другом. */
  .photo ~ .draft { display: none; }
  @media (max-width: 767px) {
    .photo {
      background-position: 60% center;
      opacity: 0.4;
      mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 46%, transparent 76%);
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 46%, transparent 76%);
    }
  }

  /* ── Чертёж ──
     Стоит справа и намеренно уходит за край экрана: рисунок должен
     читаться как фрагмент большого листа, а не как иконка в рамке. */
  .draft {
    position: absolute;
    z-index: -1;
    right: -60px;
    bottom: 96px;
    width: min(600px, 54vw);
    color: var(--ink);
    opacity: 0.2;
    pointer-events: none;
  }
  .draft .crane { color: var(--acc); opacity: 0.85; }

  /* Линии рисуются по очереди. Приём: длина штриха равна длине самой
     линии, и она сдвинута на всю длину — линия не видна; анимация
     сводит сдвиг к нулю, и линия «выезжает» из точки.
     Значения 1200 хватает на самый длинный путь; для коротких линий
     запас невиден, потому что за пределами пути штрих не рисуется. */
  .draft path {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: draw 1.5s var(--ease) forwards;
  }
  .d1 { animation-delay: 0.15s; }
  .d2 { animation-delay: 0.35s; }
  .d3 { animation-delay: 0.6s; }
  .d4 { animation-delay: 0.75s; }
  .d5 { animation-delay: 0.5s; }
  .d6 { animation-delay: 0.9s; }
  .d7 { animation-delay: 1.15s; }
  .d8 { animation-delay: 1.25s; }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .draft path { animation: none; stroke-dashoffset: 0; }
  }
  @media (max-width: 767px) {
    /* На телефоне чертёж уходит в верхний правый угол и становится
       фоном заголовка: места под него сбоку нет. */
    /* На телефоне чертёж встаёт за заголовком и работает как рисунок,
       а не как еле различимая подложка: ярче, и красный кран попадает
       в кадр. Книзу растворяется — иначе линии идут прямо по абзацу
       и мешают читать. */
    .draft {
      right: -14px;
      bottom: auto;
      top: 22px;
      width: 352px;
      opacity: 0.32;
      mask-image: linear-gradient(180deg, #000 52%, transparent 84%);
      -webkit-mask-image: linear-gradient(180deg, #000 52%, transparent 84%);
    }
  }

  /* ── Раскладка ── */

  .hero-in {
    padding-bottom: 42px;
    display: grid;
    gap: 34px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .hero { padding-top: 66px; }
    .hero-in {
      grid-template-columns: minmax(0, 1fr) 384px;
      gap: 34px 60px;
      padding-bottom: 56px;
    }
    /* Строка со сверкой — под текстом, в той же левой колонке.
       Карточка предложения занимает правую колонку целиком. */
    .verify { grid-column: 1; }
    .hero-offer { grid-column: 2; grid-row: 1 / span 2; }
  }

  .geo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    justify-self: start;
    font-family: var(--font-body);
    font-size: 13.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--paper);
    padding: 5px 13px;
    border-radius: 999px;
    margin-bottom: 22px;
  }
  .geo i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acc);
    flex: none;
    /* Точка дышит: единственное движение на первом экране, которое
       не заканчивается. Медленно и почти незаметно — иначе она
       превращается в мигающий индикатор ошибки. */
    animation: pulse 3.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.8); }
  }

  .page-title {
    font-size: clamp(36px, 5.6vw, 62px);
    font-weight: 700;
    max-width: 15ch;
    letter-spacing: -0.025em;
  }

  .hero-lead {
    font-size: clamp(16.5px, 1.6vw, 19px);
    line-height: 1.62;
    color: var(--muted);
    max-width: 54ch;
    margin-top: 22px;
  }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .btn--lg { padding: 16px 28px; font-size: 16px; min-height: 54px; }
  .note { font-size: 13px; color: var(--muted); margin-top: 15px; }

  /* Строка о сверке: печать и объяснение рядом. Печать вынесена
     в отдельную обёртку — стили компонента живут в Seal.astro, а класс,
     переданный компоненту снаружи, до его корня не доходит. */
  .verify {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    margin-top: 4px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
    max-width: 54ch;
  }
  .v-seal { display: block; flex: none; }
  /* На телефоне печать мельче: при её обычном размере на текст рядом
     остаётся колонка шириной в двадцать восемь знаков. */
  @media (max-width: 560px) {
    .verify { gap: 14px; }
    .v-seal :global(.seal) { --seal-size: 82px; }
  }
  .verify p { font-size: 14px; line-height: 1.6; color: var(--muted); }

  /* ── Предложение как бланк ── */

  .hero-offer {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    padding: 26px 24px 22px;
    display: grid;
    gap: 13px;
    align-content: start;
    box-shadow: var(--shadow);
  }
  /* Красная линейка сверху — как поле бланка. */
  .hero-offer::before {
    content: '';
    position: absolute;
    left: -1px;
    right: -1px;
    top: -1px;
    height: 3px;
    background: var(--acc);
    border-radius: var(--r-m) var(--r-m) 0 0;
  }
  .ho-tag {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--acc-deep);
  }
  .ho-title { font-family: var(--font-head); font-size: 27px; line-height: 1.14; font-weight: 700; margin: 0; letter-spacing: -0.02em; }
  .ho-title b { color: var(--acc-deep); font-weight: 700; }
  .ho-list { list-style: none; margin: 2px 0 0; padding: 0; display: grid; gap: 9px; }
  .ho-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    font-size: 15px;
    color: var(--ink);
  }
  .ho-list :global(svg) { color: var(--good); margin-top: 3px; }
  .ho-go {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    justify-self: start;
    color: var(--acc-deep);
    font-weight: 600;
    font-size: 14.5px;
    text-decoration: none;
    padding: 8px 0 2px;
    transition: gap var(--t-fast) var(--ease);
  }
  .ho-go:hover { gap: 12px; text-decoration: underline; }

  /* ── Строка чисел ── */

  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }
  .stat {
    padding: 24px 22px 30px;
    border-left: 1px solid var(--line);
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .stat:first-child { border-left: 0; padding-left: 0; }
  .v {
    font-family: var(--font-head);
    font-size: 32px;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .v em { font-style: normal; color: var(--acc-deep); font-size: 21px; }
  .d { font-size: 13.5px; color: var(--muted); line-height: 1.45; }
  .stat .law { justify-self: start; margin-top: 7px; }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat { border-left: 0; padding: 20px 14px 20px 0; }
    .stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }

  @media (max-width: 560px) {
    .cta .btn { width: 100%; }
    .v { font-size: 26px; }
  }
</style>

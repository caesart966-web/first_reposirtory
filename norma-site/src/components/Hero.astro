---
import { SITE, REGISTRIES, href } from '../config/site'
import Icon from './Icon.astro'
import BrandIcon from './BrandIcon.astro'
import Seal from './Seal.astro'
import GiftIcon from './GiftIcon.astro'
import { GIFT_TAG, GIFTS, OFFER } from '../config/offer'
import { imageSize } from '../lib/image-size'
import { ABOUT } from '../config/about'

// Первый экран.
//
// С 7 октября 2026 года собран по образцу, который прислал заказчик
// («хочется именно визуально красивее»): белый лист, слева заголовок
// и кнопки, справа — чёткий кадр от самой шапки до края окна, и на нём
// карточки. Раньше фотография лежала за текстом бледной фактурой
// (36 % непрозрачности, обесцвеченная), и первый экран читался серым.
//
// Из образца взята раскладка, а не слова. Его «выписка — официальный
// документ о членстве», «с гарантией», «более 200 компаний», «опыт более
// 3 лет» и лицо, нарисованное нейросетью, здесь не стоят: первые два
// неправда, вторые два не совпадают с тем, что говорит заказчик, а чужое
// лицо под его именем — подлог. Лица здесь два: настоящая фотография
// владельца в карточке «отвечаю лично» и Фемида на кадре.
//
// Кадр на компьютере — на всю высоту первого экрана, и карточка условий
// стоит на нём, а не под ним; на 1366×768 она видна целиком. На телефоне
// 390×844 видны все пять строк (кадр там — полосой над карточкой,
// из-под неё видны 76 px).
//
// Строки чисел под первым экраном по-прежнему нет: четыре числа в ней
// повторяли соседей. Полоса доверия ниже — три пункта, и каждый уже сказан
// на сайте: сколько компаниям помог вступить (ABOUT.companies, то же число
// на «Обо мне»; 112 — слова заказчика 07.10.2026), статья у каждой нормы,
// взносы на счёт СРО (шаг 3 «4 шагов»). «Без поездок» отсюда ушло ради
// числа компаний: «по всей России» стоит в плашке над заголовком,
// «документы электронные» — в «Географии».

// Размер кадра — из самого файла: пропорция нужна браузеру до загрузки.
const photoSize = SITE.heroPhoto ? imageSize(`public/img/${SITE.heroPhoto}`) : null

// «Помог вступить 112 компаниям», но «21 компании»: число управляет падежом.
const n = ABOUT.companies
const companiesWord = n % 10 === 1 && n % 100 !== 11 ? 'компании' : 'компаниям'

// Число — отдельной частью строки: переносится целиком («Помог вступить /
// 112 компаниям») и выделено цветом, а текст строки остаётся одной фразой.
const TRUST: { icon: string; t: string; n?: string; d: string }[] = [
  { icon: 'building', t: 'Помог вступить', n: `${n} ${companiesWord}`, d: 'в СРО строителей, проектировщиков и изыскателей' },
  { icon: 'scales', t: 'Ответ со ссылкой на закон', d: 'у каждой нормы — статья кодекса' },
  { icon: 'wallet', t: 'Взносы — напрямую в СРО', d: 'на её счёт, не через меня' },
]
---

<section class="hero">
  <div class="hero-wash" aria-hidden="true"></div>

  <!-- Гильош — розетка, какую печатают на бланках, дипломах и марках.
       На белом листе даёт фактуру документа, а не пустоту; уходит
       за левый край и не заходит под заголовок (двойная маска). -->
  <svg class="rosette" viewBox="-260 -260 520 520" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="0.7">
      {Array.from({ length: 72 }, (_, i) => {
        const a = (i / 72) * Math.PI * 2
        return <circle cx={(Math.cos(a) * 118).toFixed(1)} cy={(Math.sin(a) * 118).toFixed(1)} r="126" />
      })}
    </g>
    <g fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.75">
      {Array.from({ length: 48 }, (_, i) => {
        const a = (i / 48) * Math.PI * 2
        return <circle cx={(Math.cos(a) * 74).toFixed(1)} cy={(Math.sin(a) * 74).toFixed(1)} r="78" />
      })}
    </g>
    <g fill="none" stroke="currentColor" stroke-width="0.9">
      <circle cx="0" cy="0" r="246" />
      <circle cx="0" cy="0" r="238" />
    </g>
  </svg>

  <!-- Чертёж: дом в лесах и башенный кран. Рисуется, только когда
       фотография не задана (SITE.heroPhoto пуст): линии проявляются
       по очереди, как под рейсшиной. -->
  {!SITE.heroPhoto && (
    <svg class="draft" viewBox="0 0 520 420" fill="none" aria-hidden="true" focusable="false">
      <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path class="d1" d="M60 400h420" />
        <path class="d2" d="M120 400V190l120-64 120 64v210" />
        <path class="d3" d="M120 190h240M120 244h240M120 298h240M120 352h240" />
        <path class="d4" d="M180 244v108M240 190v210M300 244v108" />
        <path class="d5" d="M240 126 120 190M240 126l120 64" />
      </g>
      <g class="crane" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path class="d6" d="M410 400V96h-14v304M396 96h96M492 96v34M492 96 396 76M410 96v-14" />
        <path class="d7" d="M470 96v52m-10-52 10 52h-20l10-52" />
        <path class="d8" d="M396 130l14-34M396 164l14-34M396 198l14-34" />
      </g>
    </svg>
  )}

  <div class="wrap hero-in">
    <div class="hero-text">
      <span class="geo"><i></i>{SITE.geoShort}</span>

      <h1 class="page-title">
        Вступление в <em>СРО</em> без устаревших норм
      </h1>

      <p class="hero-lead">
        Строителям, проектировщикам и изыскателям — по всей России.
        Если членство вам не нужно, скажу об этом до оплаты и покажу норму.
      </p>

      {/* Кнопки разные на телефоне и с 768 px, и это не прихоть.
          С 768 px в шапке стоит синяя «Оставить заявку», и первый экран
          ведёт к калькулятору: две одинаковые кнопки с одинаковой надписью
          в поле зрения разом уже были и убраны (Header.astro).
          На телефоне кнопки в шапке нет — она не помещается, — поэтому
          здесь первой стоит заявка, а калькулятор — второй.
          «Проверить, нужна ли СРО» — ОДНА кнопка, которая меняет вид:
          на телефоне она вторая и светлая, с 768 px — первая и синяя.
          Две кнопки, одна из которых прячется, — повтор ссылки для
          поисковика (аудит 28.09.2026). Первая кнопка на телефоне —
          «Получить консультацию», а не «Оставить заявку»: такая надпись
          уже у кнопки в шапке. */}
      <div class="cta">
        <a class="btn btn--acc btn--lg on-phone" href="#zayavka">Получить консультацию</a>
        <a class="btn btn--lg cta-calc" href="#calc">Проверить, нужна ли СРО <Icon name="arrow" size={18} class="cta-arrow" /></a>
        <a class="btn btn--ghost btn--lg on-wide" href={href('/stoimost/')}>Узнать стоимость</a>
      </div>

      {/* Прямые каналы — в первом экране, а не только на «Контактах»
          и в подвале: кто уже решил, тому калькулятор не нужен, ему нужно
          написать. На телефоне строки нет — там те же каналы стоят
          столбиком справа. */}
      <p class="direct">
        <span>Или напишите напрямую:</span>
        <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" data-goal="click_whatsapp">
          <BrandIcon name="whatsapp" size={18} idp="hero" /> WhatsApp
        </a>
        <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" data-goal="click_telegram">
          <BrandIcon name="telegram" size={18} idp="hero" /> Telegram
        </a>
        {SITE.maxLink && (
          <a href={SITE.maxLink} target="_blank" rel="noopener noreferrer" data-goal="click_max">
            <BrandIcon name="max" size={18} idp="hero" /> MAX
          </a>
        )}
      </p>
    </div>

    {/* Правая колонка: кадр, на нём карточка условий и карточка «отвечаю
        лично». Кадр — внутри колонки и выходит из неё вверх до шапки
        и вправо до края окна: так он всегда встаёт ровно над карточкой,
        какой бы ни была ширина окна. */}
    <div class="hero-side">
      {SITE.heroPhoto && (
        <div class="photo" aria-hidden="true" style={`--photo-pos: ${SITE.heroPhotoPosition || '50% 50%'}`}>
          <img
            src={href(`/img/${SITE.heroPhoto}`)}
            alt=""
            width={photoSize?.width}
            height={photoSize?.height}
            decoding="async"
            fetchpriority="high"
          />
        </div>
      )}

      {/* Главное предложение сайта — тариф: бирка на верхней кромке
          (тот же приём у «Подарка на выбор»), строки прайса — подпись
          слева, значение справа, льготы зелёным. Без .rv: первый экран
          виден сразу, а не после скрипта (замер 29.09.2026). */}
      <aside class="hero-offer">
        <span class="ho-tag">Условия вступления</span>
        <p class="ho-title">Первый год — <b>только обязательные взносы</b></p>
        <dl class="ho-list">
          {OFFER.map((p) => (
            <div class="ho-row">
              <dt>{p.label}</dt>
              <dd class={p.good ? 'good' : undefined}>{p.value}</dd>
            </div>
          ))}
        </dl>
        {/* Разбор пяти условий по пунктам живёт на «Стоимости». */}
        <a class="ho-go" href={href('/stoimost/#predlozhenie')}>
          Все пять условий <Icon name="arrow" size={15} />
        </a>
      </aside>

      {/* Кто ответит — лицом и именем (06.10.2026, «сделай сайт живым
          и доверительным»). На компьютере — карточкой у верхнего левого
          угла кадра; на телефоне — строкой под карточкой условий.
          Строка под именем — что сейчас быстрее, позвонить или написать,
          по московскому времени (lib/presence.ts). Без скрипта — режим
          из бланка контактов. Точка не мигает. Фото квадратом: заказчик
          просил, чтобы кадр был виден целиком. */}
      <a class="presence" href={href('/obo-mne/')}>
        {SITE.photo && (
          <img class="pr-photo" src={href(`/img/${SITE.photo}`)} width="44" height="44" alt="" decoding="async" />
        )}
        <span class="pr-txt">
          <span class="pr-name">{SITE.shortName} — отвечаю лично</span>
          <span class="pr-state" data-presence>
            <i aria-hidden="true"></i><span class="pr-state-text">Круглосуточно, без выходных</span>
          </span>
        </span>
        <span class="pr-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
      </a>
    </div>

    {/* ПОДАРОК НА ВЫБОР (28.09.2026): при вступлении один подарок —
        сайт, год без членских взносов или кэшбэк 30 000 ₽. Текст — GIFTS
        в config/offer.ts; там же записано, почему «год без членских»
        не спорит с «5 000 ₽ в месяц» в карточке: это выбор вместо двух
        других подарков. Поэтому бирка «Подарок на выбор» и «или» между
        строками обязательны. Отдельное предложение, а не шестое условие:
        ни чипа со статьёй, ни печати рядом.
        На компьютере — полосой во всю ширину под первым экраном, три
        подарка в ряд; на телефоне — сразу под карточкой условий.
        Ссылка — только у сайта: у «года» и «кэшбэка» своей страницы нет.
        «Или» — словом в разметке, а не `content:` в стилях: нарисованное
        стилями слово не видят поисковик, чтение без оформления и аудит,
        и для них окошко было бы тремя отдельными обещаниями (29.09.2026). */}
    <div class="hero-gift">
      <span class="hg-tag">{GIFT_TAG}</span>
      <ul class="hg-list">
        {GIFTS.map((g, i) => (
          <li>
            {i > 0 && <span class="hg-or">или</span>}
            {g.url ? (
              <a class="hg-row hg-row--link" href={href(g.url)} data-goal={g.goal}>
                <span class="hg-ic"><GiftIcon name={g.id} /></span>
                <span class="hg-txt">
                  <span class="hg-t">{g.t}</span>{g.d && <>{' '}<span class="hg-d">{g.d}</span></>}
                </span>
                <span class="hg-go" aria-hidden="true"><Icon name="arrow" size={17} /></span>
              </a>
            ) : (
              <div class="hg-row">
                <span class="hg-ic"><GiftIcon name={g.id} /></span>
                <span class="hg-txt">
                  <span class="hg-t">{g.t}</span>{g.d && <>{' '}<span class="hg-d">{g.d}</span></>}
                </span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>

    {/* Полоса доверия: три обещания значками, по образцу заказчика.
        На компьютере — под кнопками, на телефоне — после подарков:
        выше она отодвинула бы карточку условий за первый экран. */}
    <ul class="trust">
      {TRUST.map((x) => (
        <li>
          <span class="tr-ic"><Icon name={x.icon} size={20} /></span>
          <span class="tr-txt">
            <span class="tr-t">{x.t}{x.n && <>{' '}<span class="tr-n">{x.n}</span></>}</span>
            <span class="tr-d">{x.d}</span>
          </span>
        </li>
      ))}
    </ul>

    {/* Печать стоит здесь, а не на карточке предложения, и это важно.
        Она говорит «сверено с Градостроительным кодексом» — а условия
        вступления в карточке не нормы закона, а условия конкретных СРО.
        Печать рядом с ними означала бы, что закон эти льготы гарантирует;
        он их не гарантирует. */}
    <div class="verify">
      <span class="v-seal"><Seal size={96} /></span>
      {/* «Нормы», а не «все цифры»: взносы СРО законом не установлены,
          статьи у них нет и быть не должно (config/fees.ts). */}
      <div class="v-txt">
        <p>
          Нормы закона на сайте сверены с Градостроительным кодексом,
          у каждой — статья, устаревших норм нет. Дата сверки — на печати.
        </p>
        {/* Проверяемость владельца — тоже на первом экране: ИНН и ссылка
            в ЕГРИП, как в бланке «Контактов». */}
        <p class="v-id">
          Работаю как ИП: ИНН <span class="v-inn">{SITE.inn}</span> —{' '}
          <a href={REGISTRIES.egrip} target="_blank" rel="noopener noreferrer">проверить в ЕГРИП</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--paper);
    color: var(--ink);
    padding: 46px 0 0;
    overflow: hidden;
  }

  /* Свет на листе: голубоватая дымка от левого верхнего угла к белому.
     Ровный белый под крупной антиквой выглядел пустым, а узор под ней
     рябит; дымка даёт листу объём и ничего не рисует. */
  .hero-wash {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(80% 70% at 6% -10%, color-mix(in srgb, var(--acc-soft) 85%, transparent) 0%, transparent 62%),
      linear-gradient(180deg, color-mix(in srgb, var(--paper-2) 70%, var(--paper)) 0%, var(--paper) 72%);
    pointer-events: none;
  }

  .rosette {
    position: absolute;
    z-index: -2;
    left: -340px;
    top: -80px;
    width: 780px;
    height: 780px;
    color: var(--acc);
    opacity: 0.07;
    pointer-events: none;
    mask-image:
      radial-gradient(58% 58% at 50% 50%, #000 30%, transparent 78%),
      linear-gradient(90deg, #000 0%, #000 40%, transparent 70%);
    -webkit-mask-image:
      radial-gradient(58% 58% at 50% 50%, #000 30%, transparent 78%),
      linear-gradient(90deg, #000 0%, #000 40%, transparent 70%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }
  @media (max-width: 1023px) {
    .rosette { display: none; }
  }

  /* ── Кадр ──
     Чёткий, без обесцвечивания: он больше не лежит под текстом, текст
     стоит на белом слева, а на кадре — только карточки со своим фоном.
     Левый край растворяется в листе — у кадра нет рамки со стороны
     текста, как в образце. Кадр «дышит» (global.css, @keyframes breathe):
     за полминуты приближается на 6 % и обратно. */
  .photo {
    display: none;
    position: absolute;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--photo-pos);
    transform-origin: var(--photo-pos);
    animation: breathe 30s ease-in-out infinite alternate;
    will-change: transform;
  }
  .hero-side { position: relative; display: grid; gap: 18px; align-content: start; }
  .hero-offer,
  .presence { position: relative; z-index: 1; }

  @media (min-width: 1024px) {
    /* Кадр — на всю высоту первого экрана справа: от шапки (вверх
       на отступ первого экрана) до низа печати, от промежутка между
       колонками до правого края окна; левый край растворяется в листе.
       До вечера 07.10.2026 кадр был полосой 356 px в правом верхнем
       углу, и заказчик сказал: «бедно смотрится… побольше». Карточка
       условий стоит НА кадре, как карточки в образце, а не под ним. */
    .hero-side { align-self: stretch; }
    .photo {
      display: block;
      top: -66px;
      bottom: 0;
      left: -40px;
      right: min(-20px, calc((1080px - 100vw) / 2));
      mask-image: linear-gradient(90deg, transparent 0, #000 150px);
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 150px);
    }
    .hero-offer { margin-top: 218px; }
    /* «Отвечаю лично» — у верхнего левого угла кадра, на его
       растворяющемся крае (как карточка «выписки» в образце). Справа
       от неё — голова Фемиды и весы: у правого края карточка закрывала
       бы их на любой ширине. */
    .presence {
      position: absolute;
      top: 22px;
      left: -60px;
      max-width: 360px;
    }
  }
  /* Планшет и телефон: одна колонка, кадр — полосой во всю ширину
     над карточкой условий, карточка наезжает на него. На телефоне
     из-под карточки виден только верх кадра (76 px): больше — и пятая
     строка условий уходит за первый экран 390×844 (сейчас низ — 832). */
  @media (max-width: 1023px) {
    .photo {
      display: block;
      top: 0;
      left: -20px;
      right: -20px;
      height: 250px;
      mask-image: linear-gradient(180deg, #000 72%, transparent);
      -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent);
    }
    .hero-offer { margin-top: 180px; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-offer { max-width: 520px; }
  }
  @media (max-width: 767px) {
    .photo { height: 180px; }
    .hero-offer { margin-top: 76px; }
  }

  .draft {
    position: absolute;
    z-index: -1;
    right: -60px;
    top: 40px;
    width: min(560px, 50vw);
    color: var(--ink);
    opacity: 0.2;
    pointer-events: none;
  }
  .draft .crane { color: var(--acc); opacity: 0.85; }
  .draft path {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: draw 1.5s var(--ease) forwards;
  }

  .stat .law { justify-self: start; margin-top: 7px; }

  /* minmax(0, 1fr), а не 1fr: у 1fr нижняя граница — min-content,
     и чип со статьёй («ч. 2.1 ст. 52 ГрК РФ», он неразрывный) раздвигал
     колонку до 163 px при 140 доступных. Строка цифр вылезала за экран
     и обрезалась по краю первого экрана — последние два числа читались
     наполовину. */
  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat { border-left: 0; padding: 20px 14px 20px 0; }
    .stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }

  @media (max-width: 560px) {
    .cta .btn { width: 100%; }
    .v { font-size: 26px; }
  }

  /* На самом узком телефоне два столбца не спасает и minmax: под чип
     остаётся 140 px, а он неразрывный. Числа встают в один столбец —
     их всего четыре, и по одному они читаются лучше, чем в обрез. */
  @media (max-width: 400px) {
    .stats { grid-template-columns: 1fr; }
    .stat { padding: 18px 0; }
    .stat:nth-child(n + 2) { border-top: 1px solid var(--line); }
  }
</style>

---
import { SITE, href } from '../config/site'
import { LAW, TERMS } from '../config/facts'
import Icon from './Icon.astro'
import MapPlate from './MapPlate.astro'
import { OFFER } from '../config/offer'

// Первый экран.
//
// Устроен в три яруса, и это не украшение, а решение двух задач сразу.
//
//   Ярус 1 — слово и предложение. Тёмно-синий фон, никакого видео под
//   текстом. Раньше текст лежал поверх ролика, и держать его читаемым
//   приходилось пеленой поверх кадра и тенью у каждой буквы: две подпорки,
//   которые к тому же гасили сам ролик. Теперь текст на сплошном цвете —
//   контраст 15:1 без единой уловки, и подпорки убраны.
//
//   Ярус 2 — карта. Отдельная полоса, на которой не написано ничего,
//   поэтому ролик виден целиком и в полную силу. Почему именно так —
//   в MapPlate.astro.
//
//   Ярус 3 — четыре числа. Они же служат подписью к карте: полоса цифр
//   под картинкой читается как легенда под схемой в документе, а не как
//   ещё один блок. У двух чисел стоит чип со статьёй закона — с первого
//   же экрана видно, что цифры здесь не с потолка.
//
// Чего здесь больше нет: списка из трёх обещаний под заголовком. Одно из
// них слово в слово повторяло число из третьего яруса, два других страница
// доказывает ниже — калькулятором и чипами норм. Заказчик просил убрать
// с сайта лишнее; это было лишним первым.

const stats = [
  { v: TERMS.extract, d: `от подачи документов до выписки из реестра, ${TERMS.extractTypical}` },
  { v: '0 ₽', d: 'подготовка документов и сопровождение — мои услуги' },
  { v: '10', unit: 'млн ₽', d: 'порог, с которого строителю нужно членство', law: LAW.build },
  { v: '≤ 2', unit: 'мес.', d: 'срок рассмотрения по закону; с готовыми документами — дни', law: LAW.term },
]
---

<section class="hero">
  {/* Короткий вариант, а не полный: под чипом идёт карта, и «по всей
      России» она говорит убедительнее любой строки. На телефоне длинная
      фраза занимала две строки и отодвигала заголовок под сгиб. */}
  <span class="geo"><i></i>{SITE.geoShort}</span>

  <h1 class="page-title">
    Вступить в <em>СРО</em><br />без устаревших норм
  </h1>
  <p class="tagline">Точно. Честно. За 2–3 дня.</p>

  <div class="cta">
    <a class="btn btn--acc btn--lg" href="#calc">Проверить, нужна ли СРО</a>
    <a class="btn btn--ghost-dark btn--lg" href={href('/stoimost/')}>Узнать стоимость</a>
  </div>
  <p class="note">2 минуты · 4 вопроса · ответ со ссылкой на закон</p>

  {/* Главное предложение сайта. На компьютере занимает правую колонку,
      на телефоне встаёт сразу под картой — то есть в обоих случаях
      попадает на первый экран, а не уезжает под сгиб. */}
  <aside class="hero-offer">
    <span class="ho-tag"><Icon name="star" size={15} /> Только через меня</span>
    <p class="ho-title">Вступление <b>без стартовых расходов</b></p>
    <ul class="ho-list">
      {OFFER.map((p) => (
        <li><Icon name="check" size={15} /> {p.short}</li>
      ))}
    </ul>
    <a class="ho-go" href={href('/#predlozhenie')}>
      Все пять условий <Icon name="arrow" size={15} />
    </a>
  </aside>

  <MapPlate name="hero" />

  <ul class="stats">
    {stats.map((s) => (
      <li class="stat">
        {/* Пробел ставится явно: Astro съедает пробел перед строчным тегом,
            и число слипалось с единицей — «10млн ₽». Отступом в стилях это
            не лечится: при копировании текста и в программе чтения с экрана
            пробела всё равно бы не было. */}
        <span class="v">{s.unit ? <>{s.v}{' '}<em>{s.unit}</em></> : s.v}</span>
        <span class="d">{s.d}</span>
        {s.law && <span class="law law--dark">{s.law}</span>}
      </li>
    ))}
  </ul>
</section>

<style>
  /* Первый экран — одна сетка на все ярусы, без вложенных обёрток.
     Так сделано ради телефона: карта должна встать между подзаголовком
     и карточкой предложения, а лежи они в разных блоках, переставить их
     местами было бы нечем. В общей сетке порядок задаётся раскладкой,
     а разметка остаётся в том порядке, в каком её читают поисковики
     и программы чтения с экрана.

     Крайние колонки сетки — поля страницы. Карта занимает все колонки
     разом и потому идёт во всю ширину экрана, а текст держится в тех же
     1120 px, что и на остальных страницах. */
  .hero {
    background: var(--navy);
    color: var(--on-navy);
    padding: 34px 0 0;
    display: grid;
    grid-template-columns:
      [full-start] minmax(20px, 1fr)
      [main-start] minmax(0, 1120px) [main-end]
      minmax(20px, 1fr) [full-end];
    grid-template-areas:
      '. geo   .'
      '. title .'
      '. tag   .'
      'map map map'
      '. offer .'
      '. cta   .'
      '. note  .'
      '. stats .';
  }

  .geo { grid-area: geo; }
  .page-title { grid-area: title; }
  .tagline { grid-area: tag; }
  .hero-offer { grid-area: offer; }
  .cta { grid-area: cta; }
  .note { grid-area: note; }
  .hero :global(.plate) { grid-area: map; }
  .stats { grid-area: stats; }

  /* Компьютер. Текст слева, предложение справа отдельной колонкой,
     карта под ними во всю ширину, числа — подписью под картой. */
  @media (min-width: 1024px) {
    .hero {
      padding-top: 46px;
      grid-template-columns:
        [full-start] minmax(20px, 1fr)
        [main-start] minmax(0, 728px) 392px [main-end]
        minmax(20px, 1fr) [full-end];
      grid-template-areas:
        '. geo   offer .'
        '. title offer .'
        '. tag   offer .'
        '. cta   offer .'
        '. note  offer .'
        'map map map map'
        '. stats stats .';
    }
    /* Просвет между колонками отдан карточке: он должен уйти вместе с ней,
       когда на узком экране колонок не станет. */
    .hero-offer { margin-left: 52px; align-self: start; }
  }

  /* ── Предложение ── */

  .hero-offer {
    margin: 28px 0 0;
    background: #fff;
    color: var(--ink);
    border-radius: var(--r-l);
    padding: 24px 22px 20px;
    display: grid;
    gap: 12px;
    align-content: start;
    /* Светлое кольцо по краю: без него белая карточка на тёмно-синем
       выглядит вырезанной ножницами. */
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.5),
      0 0 0 7px color-mix(in srgb, var(--acc) 20%, transparent),
      0 28px 60px -22px rgba(2, 8, 18, 0.8);
  }
  .ho-tag {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--acc-btn);
    color: #fff;
    font-family: var(--font-head);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 6px 12px;
    border-radius: 999px;
  }
  .ho-title { font-family: var(--font-head); font-size: 25px; line-height: 1.18; font-weight: 800; margin: 0; }
  .ho-title b { color: var(--acc-deep); }
  .ho-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .ho-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 9px;
    align-items: start;
    font-size: 15px;
    color: var(--ink);
  }
  .ho-list :global(svg) { color: var(--good); margin-top: 3px; }
  .ho-go {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    justify-self: start;
    color: var(--acc-deep);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 14.5px;
    text-decoration: none;
    padding: 6px 0 2px;
  }
  .ho-go:hover { text-decoration: underline; }

  /* ── Слово ── */

  .geo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--on-navy);
    border: 1px solid var(--navy-line);
    padding: 5px 12px;
    border-radius: 999px;
    justify-self: start;
    margin-bottom: 22px;
  }
  .geo i { width: 6px; height: 6px; border-radius: 50%; background: var(--acc-bright); flex: none; }

  .page-title {
    color: #fff;
    font-size: clamp(34px, 6.6vw, 68px);
    font-weight: 800;
    max-width: 16ch;
  }

  .tagline {
    color: var(--on-navy);
    font-family: var(--font-head);
    font-size: clamp(16px, 2.2vw, 21px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 16px;
    font-weight: 500;
  }

  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .btn--lg { padding: 16px 28px; font-size: 16px; min-height: 54px; }
  .note { font-size: 13px; color: var(--on-navy-muted); margin: 14px 0 26px; }

  /* ── Числа под картой ──
     Тонкие разделители и подписи в разрядку: полоса должна читаться как
     легенда под схемой, а не как ещё одна секция с карточками. */

  .stats {
    list-style: none;
    margin: 0;
    padding: 0 0 6px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    padding: 22px 20px 28px;
    border-left: 1px solid var(--navy-line);
    display: grid;
    gap: 5px;
    align-content: start;
  }
  .stat:first-child { border-left: 0; padding-left: 0; }
  .v {
    font-family: var(--font-head);
    font-size: 28px;
    font-weight: 800;
    color: #fff;
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1.1;
  }
  .v em { font-style: normal; color: var(--acc-bright); font-size: 20px; }
  .d { font-size: 13px; color: var(--on-navy-muted); line-height: 1.45; }
  .stat .law { justify-self: start; margin-top: 6px; }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat { border-left: 0; padding: 20px 14px 20px 0; }
  }

  @media (max-width: 560px) {
    .cta .btn { width: 100%; }
    .v { font-size: 23px; }
  }
</style>

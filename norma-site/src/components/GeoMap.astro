  .gmap-sro li b { font-weight: 600; }
  /* Номер в реестре — цифры в колонку, поэтому табличные. По нему
     организацию находят в государственном реестре, и обрывать его
     переносом нельзя. */
  .gmap-sro li span {
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;

  /* Легенда разложена той же сеткой, что показания: слева подпись
     и знаки, справа текст. Тогда при наведении содержимое не прыгает
     из колонки в колонку. */
  .gmap-cap {
    display: grid;
    grid-template-columns: minmax(180px, 265px) minmax(0, 1fr);
    gap: 0 28px;
    align-items: start;
    margin: 0;

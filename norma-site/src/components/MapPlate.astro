---
import { href } from '../config/site'

interface Props {
  /** Имя файлов в public/video/ без расширения. */
  name: string
}
const { name } = Astro.props

// Карта России на первом экране.
//
// Раньше этот ролик был фоном: он лежал под всем первым экраном, а поверх
// шёл текст. С картой так нельзя, и вот почему.
//
// Фон растягивается под размер экрана и обрезается по краям (object-fit:
// cover). Кадр со стройкой это переживает — какой кусок площадки видно,
// не так важно. У карты важен каждый край: обрезанная по бокам Россия —
// это уже не Россия, а на телефоне от неё оставалась вертикальная полоса
// шириной примерно с Урал. Плюс поверх карты приходилось класть плотную
// пелену, чтобы читался белый текст, — и карту было почти не видно.
//
// Поэтому теперь ролик показывается целиком (object-fit: contain) и живёт
// отдельной полосой, на которой ничего не написано. Полоса ниже страны по
// пропорции, поэтому на широком экране карта стоит по центру, а по бокам
// остаётся тёмное поле — оно того же цвета, что и края самого ролика, так
// что границы кадра не видно и полоса читается как единая плита.
//
// Как ролик грузится:
//
// 1. Сначала показывается картинка-заглушка — первый кадр. Она грузится
//    вместе со страницей, и полоса выглядит готовой сразу.
// 2. Сам ролик браузер начинает качать только после того, как страница
//    полностью загрузилась и освободилась. preload="none" запрещает
//    загрузку до этого момента, а ожидание load — обязательное условие:
//    иначе ролик отнимает канал у шрифтов и стилей (проверено замером
//    скорости: 89 баллов против 96). Файлов два: WebM для Chrome,
//    Firefox, Яндекс.Браузера и Edge, MP4 для Safari и айфонов.
// 3. Ролик не грузится совсем, если включена экономия трафика или в
//    системе стоит «уменьшить движение». Тогда остаётся заглушка —
//    тот же кадр, просто неподвижный.
// 4. Звука в файле нет: браузеры запрещают автозапуск со звуком.
//
// Заменить карту: положите свои файлы в public/video/ под теми же именами.
// Как их подготовить — README, раздел про видео. Ролик из нейросети
// сначала прогоняется через scripts/clean-video.mjs (он снимает водяной
// знак и делает петлю), потом через scripts/encode-video.mjs.
---

<div class="plate">
  <video
    class="plate-video"
    poster={href(`/video/${name}-poster.webp`)}
    preload="none"
    muted
    loop
    playsinline
    disablepictureinpicture
    tabindex="-1"
    aria-label="Карта России: огни городов от Калининграда до Камчатки"
    data-webm={href(`/video/${name}.webm`)}
    data-mp4={href(`/video/${name}.mp4`)}></video>
</div>

<style>
  /* Пропорция ровно та же, что у файла с картой (1264 × 604). Совпадение
     обязательно: при object-fit: contain любое расхождение тут же вылезет
     пустыми полями по краям карты. Пустое море сверху и снизу срезано ещё
     при подготовке ролика — scripts/clean-video.mjs, последний аргумент.

     Высота ограничена сверху: иначе на широком мониторе полоса заняла бы
     пол-экрана. За пределом карта не растягивается, а встаёт по центру,
     и по бокам остаётся тёмное поле того же цвета, что края кадра. */
  .plate {
    position: relative;
    /* width обязателен. Без него у блока с aspect-ratio и max-height
       ширина считается от высоты: полоса упиралась в 380 px по высоте
       и сама сжималась до 844 px по ширине, прижимаясь к левому краю.
       С явной шириной высота считается от неё, а max-height только
       подрезает — как и задумано. */
    width: 100%;
    aspect-ratio: 1264 / 604;
    max-height: 420px;
    background: var(--night);
    overflow: hidden;
  }

  /* Мягкий переход к секции сверху и снизу. Без него полоса упирается
     в тёмно-синий ровной чертой и выглядит вставленной картинкой,
     а не частью первого экрана. */
  .plate::before,
  .plate::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 34px;
    pointer-events: none;
  }
  .plate::before { top: 0; background: linear-gradient(var(--navy), transparent); }
  .plate::after { bottom: 0; background: linear-gradient(transparent, var(--navy)); }

  .plate-video {
    width: 100%;
    height: 100%;
    /* contain, а не cover: страна показывается целиком при любой ширине
       экрана. Пустое поле по бокам заливает .plate тем же цветом, что и
       края кадра, — стыка не видно. */
    object-fit: contain;
    display: block;
  }

  /* Плавного появления здесь намеренно нет. Заглушка — это первый кадр
     того же ролика с той же обработкой, и ролик начинается тоже с него:
     в момент подмены на экране не меняется ничего. Прозрачность накладывать
     было бы и нельзя: заглушку рисует сам элемент video, и вместе с
     кадрами исчезла бы она. */
</style>

<script>
  // Ролик подключается только после того, как страница отрисована,
  // и только если это уместно. Всё остальное время висит заглушка.
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.plate-video'))

  if (videos.length) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    const saveData = conn?.saveData === true
    const calmer = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (!saveData && !calmer) {
      const start = () => {
        for (const video of videos) {
          // Спрашиваем сам браузер, что он умеет: 'probably' или 'maybe'
          // означают, что формат поддерживается, пустая строка — что нет.
          const src = video.canPlayType('video/webm; codecs="vp9"')
            ? video.dataset.webm
            : video.dataset.mp4
          if (!src) continue
          video.src = src
          // play() возвращает обещание, которое браузер может отклонить
          // (например, экономия энергии на ноутбуке). Это не ошибка:
          // тогда просто остаётся картинка-заглушка.
          video.play().catch(() => {})
        }
      }

      const queue = () => {
        if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 3000 })
        else setTimeout(start, 900)
      }
      if (document.readyState === 'complete') queue()
      else window.addEventListener('load', queue, { once: true })

      // Ушли со вкладки — останавливаем: незачем греть телефон роликом,
      // которого никто не видит.
      document.addEventListener('visibilitychange', () => {
        for (const video of videos) {
          if (!video.src) continue
          if (document.hidden) video.pause()
          else video.play().catch(() => {})
        }
      })
    }
  }
</script>

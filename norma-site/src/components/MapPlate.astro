---
import { href } from '../config/site'

interface Props {
  /** Имя файлов в public/video/ без расширения. */
  name: string
}
const { name } = Astro.props

// Карта России — фон первого экрана. Лежит под текстом, текст читается поверх.
//
// Главная тонкость — object-fit: contain, а не cover.
//
// Обычный фоновый ролик растягивают по размеру блока и обрезают лишнее
// (cover). Со съёмкой это работает: какой кусок площадки видно, не так важно.
// С картой — нет: у неё важен каждый край. На телефоне, где первый экран
// высокий и узкий, cover оставлял от страны вертикальную полосу шириной
// примерно с Урал.
//
// Поэтому кадр вписывается целиком: по ширине блока, а сверху и снизу
// остаётся тёмно-синее поле секции. На компьютере поля почти нет — там
// первый экран сам по себе широкий. На телефоне карта идёт полосой в верхней
// части, ровно за заголовком, и мягко растворяется в фоне по краям.
//
// Как ролик грузится:
//
// 1. Сначала показывается картинка-заглушка — первый кадр. Она грузится
//    вместе со страницей, и фон выглядит готовым сразу.
// 2. Сам ролик браузер начинает качать только после того, как страница
//    полностью загрузилась и освободилась. preload="none" запрещает
//    загрузку до этого момента, а ожидание load — обязательное условие:
//    иначе ролик отнимает канал у шрифтов и стилей (проверено замером
//    скорости: 89 баллов против 96). Файлов два: WebM для Chrome,
//    Firefox, Яндекс.Браузера и Edge, MP4 для Safari и айфонов.
// 3. Ролик не грузится совсем, если включена экономия трафика или в
//    системе стоит «уменьшить движение». Тогда остаётся заглушка —
//    тот же кадр, просто неподвижный.
// 4. Звука в файле нет: браузеры запрещают автозапуск со звуком.
//
// Заменить карту: положите свои файлы в public/video/ под теми же именами.
// Как их подготовить — README, раздел про видео. Ролик из нейросети
// сначала прогоняется через scripts/clean-video.mjs (он снимает водяной
// знак и делает петлю), потом через scripts/encode-video.mjs.
---

<div class="plate" aria-hidden="true">
  <video
    class="plate-video"
    poster={href(`/video/${name}-poster.webp`)}
    preload="none"
    muted
    loop
    playsinline
    disablepictureinpicture
    tabindex="-1"
    data-webm={href(`/video/${name}.webm`)}
    data-mp4={href(`/video/${name}.mp4`)}></video>
</div>

<style>
  .plate {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Пока картинка не пришла, фон не мигает светлым. */
    background: var(--navy);
  }

  .plate-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    /* Края кадра растворяются в фоне секции. Без этого карта на телефоне
       читается как вставленный прямоугольник: у ролика края почти чёрные,
       а фон секции тёмно-синий, и граница между ними видна. */
    mask-image: linear-gradient(180deg, transparent 0, #000 7%, #000 93%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 7%, #000 93%, transparent 100%);
  }

  /* На телефоне первый экран высокий: карта, вписанная в него целиком,
     оказалась бы узкой полосой ровно посередине — за карточкой предложения,
     где её не видно. Поэтому слой с картой здесь не на всю секцию, а только
     на верхние 400 px, и карта встаёт в них за заголовком.

     Высота задана числом, а не долей от секции, нарочно: доля зависела бы
     от того, сколько текста в первом экране, и карта уезжала бы от заголовка
     при любой правке. 400 px — это чип с географией, заголовок и строка
     под ним на любом телефоне. */
  @media (max-width: 767px) {
    .plate { bottom: auto; height: 400px; }
    .plate-video {
      object-position: 50% 34%;
      mask-image: linear-gradient(180deg, transparent 0, #000 11%, #000 60%, transparent 100%);
      -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 11%, #000 60%, transparent 100%);
    }
  }

  /* Плавного появления здесь намеренно нет. Заглушка — это первый кадр
     того же ролика с той же обработкой, и ролик начинается тоже с него:
     в момент подмены на экране не меняется ничего. Прозрачность накладывать
     было бы и нельзя: заглушку рисует сам элемент video, и вместе с
     кадрами исчезла бы она. */
</style>

<script>
  // Ролик подключается только после того, как страница отрисована,
  // и только если это уместно. Всё остальное время висит заглушка.
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.plate-video'))

  if (videos.length) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    const saveData = conn?.saveData === true
    const calmer = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (!saveData && !calmer) {
      const start = () => {
        for (const video of videos) {
          // Спрашиваем сам браузер, что он умеет: 'probably' или 'maybe'
          // означают, что формат поддерживается, пустая строка — что нет.
          const src = video.canPlayType('video/webm; codecs="vp9"')
            ? video.dataset.webm
            : video.dataset.mp4
          if (!src) continue
          video.src = src
          // play() возвращает обещание, которое браузер может отклонить
          // (например, экономия энергии на ноутбуке). Это не ошибка:
          // тогда просто остаётся картинка-заглушка.
          video.play().catch(() => {})
        }
      }

      const queue = () => {
        if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 3000 })
        else setTimeout(start, 900)
      }
      if (document.readyState === 'complete') queue()
      else window.addEventListener('load', queue, { once: true })

      // Ушли со вкладки — останавливаем: незачем греть телефон роликом,
      // которого никто не видит.
      document.addEventListener('visibilitychange', () => {
        for (const video of videos) {
          if (!video.src) continue
          if (document.hidden) video.pause()
          else video.play().catch(() => {})
        }
      })
    }
  }
</script>

---
import { GIFTS, OFFER } from '../config/offer'
import { FEES, money } from '../config/fees'

// Сумма считается, а не вписана в текст.
//
// Здесь стояли числа руками: «15 000 ₽ у строителей и 21 000 ₽
// у проектировщиков». Первое было верно при членском взносе 5 000 ₽ за год,
// второе не сходилось ни при каких суммах из fees.ts. Когда выяснилось,
// что 5 000 ₽ — это месяц, оба стали враньём вчетверо, и поймать это
// глазами нельзя: текст выглядит уверенно.
//
// Теперь строка складывается из FEES и меняется вместе с ними. Проверка
// npm run facts следит, чтобы числа на страницах сходились с конфигом, —
// но она видит только те числа, которые оттуда взяты.
const extra = (kind: 'build' | 'design') =>
  FEES[kind].entry + FEES[kind].memberMonth * 12 + FEES[kind].target
const firstYearExtra = extra('build')
// У строителей и проектировщиков суммы сейчас совпадают. Если разойдутся,
// одной строкой не отделаться — текст придётся разворачивать в две.
const extraDiffers = extra('build') !== extra('design')
import { href } from '../config/site'
import Icon from './Icon.astro'

// Главное предложение сайта: условия вступления, которых нет у конкурентов.
//
// Самый яркий блок на странице — так и задумано. Это единственное место,
// где сайт говорит не «вот как устроен закон», а «вот что предлагаю я»,
// и его должно быть видно сразу.
//
// Текст условий не здесь, а в src/config/offer.ts — там же записано правило,
// по которому эти пункты нельзя подавать как нормы закона. Оговорка внизу
// блока обязательная, снимать её нельзя.
---

<section class="section offer" id="predlozhenie" data-anchor>
  <div class="wrap">
    <div class="obox rv">
      {/* Надзаголовок и заголовок здесь НЕ повторяют карточку из первого
          экрана, и это важно. Раньше повторяли слово в слово: карточка
          анонсировала «Условия, которых нет больше нигде. Первый год —
          только обязательные взносы», и ровно та же пара стояла здесь.
          Человек, который просто листает, видел одну и ту же шапку блока
          дважды за четыре экрана и решал, что попал в повтор. Связка
          «анонс наверху — разбор ниже» осталась (карточка ведёт сюда
          ссылкой «Все пять условий»), но разбор обязан называться разбором. */}
      <div class="ohead">
        <span class="otag"><Icon name="star" size={15} /> Разбор предложения</span>
        <h2>Те же пять условий — <em>по порядку и с цифрами</em></h2>
        {/* Блок стоит только на «Стоимости» (карточка «Условия вступления» —
            на главной, её ссылка «Все пять условий» ведёт сюда). До 30.09.2026
            текст писал «карточка в начале страницы» и «полная разбивка —
            в разделе „Стоимость“»: так было, пока блок стоял на главной.
            Переехав, он стал отсылать человека на ту страницу, где тот уже
            находится, и к карточке, которой на ней нет. */}
        <p class="olead">
          Что стоит за каждым пунктом карточки «Условия вступления» с главной.
          Сверх компенсационного фонда, размер которого установлен законом,
          за первый год набегает {money(firstYearExtra)}{extraDiffers ? ' у строителей' : ''} —
          и это все платежи, а не «от». Разбивка до рубля —{' '}
          <a href="#sostav">сразу под этим блоком</a>.
        </p>
      </div>

      <ol class="olist">
        {OFFER.map((p, i) => (
          <li>
            <span class="on">{String(i + 1).padStart(2, '0')}</span>
            <div class="ob">
              <b>{p.full}</b>
              <p>{p.note}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="ofoot">
        {/* Подарок — ОДИН на выбор (GIFTS в config/offer.ts). Здесь стояла
            ссылка «И сайт компании бесплатно — отдельным подарком»; с 28.09.2026
            подарков три — сайт, год без членских взносов или кэшбэк, — и слова
            «один на выбор» обязательны: без них «год без членских» спорил бы
            с третьим пунктом списка выше. Ссылка — только у сайта: у него есть
            своя страница. */}
        <p class="ogift">
          <Icon name="gift" size={16} />
          <span>
            Плюс подарок — один на выбор:{' '}
            {GIFTS.map((g, i) => (
              <>
                {i > 0 && (i === GIFTS.length - 1 ? ' или ' : ', ')}
                {g.url ? <a href={href(g.url)}>{g.short}</a> : g.short}
                {g.d && ` ${g.d}`}
              </>
            ))}.
          </span>
        </p>
        <div class="oacts">
          <a class="btn btn--white btn--lg" href={href('/kontakty/#form')}>Узнать условия для моей компании</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ярче всего на странице — намеренно: это главное предложение.
     Здесь один цвет вместо прежнего градиента. Градиент из двух оттенков
     красного смотрелся бы дешёвой заливкой; ровный сургуч читается как
     красное поле бланка, а нужный объём даёт не цвет, а тонкая светлая
     линейка сверху и глубокая тень. */
  .obox {
    position: relative;
    background: var(--acc);
    color: #fff;
    border-radius: var(--r-m);
    padding: 34px;
    display: grid;
    gap: 24px;
    box-shadow: 0 30px 70px -34px color-mix(in srgb, var(--acc) 70%, #000);
  }
  .obox::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border-top: 3px solid rgba(255, 255, 255, 0.5);
    pointer-events: none;
  }
  @media (min-width: 900px) {
    .obox { padding: 42px 46px; }
  }

  .ohead { display: grid; gap: 10px; justify-items: start; }
  .otag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .obox h2 { color: #fff; margin: 4px 0 0; }
  /* Выделенное слово в заголовке: на красном акцентный красный не
     читается, поэтому здесь белый с подчёркиванием, а не цветом. */
  .obox h2 :global(em) {
    color: #fff;
    font-style: normal;
    box-shadow: inset 0 -0.14em rgba(255, 255, 255, 0.45);
  }
  .olead { color: rgba(255, 255, 255, 0.88); font-size: 17px; line-height: 1.6; margin: 0; max-width: 62ch; }

  .olist { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  @media (min-width: 1040px) {
    .olist { grid-template-columns: 1fr 1fr; gap: 2px 34px; }
    /* Условий пять, то есть нечётное число: последнее занимает обе колонки,
       иначе справа от него остаётся пустая половина строки. */
    .olist li:last-child { grid-column: 1 / -1; }
  }
  .olist li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding: 16px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .on {
    font-family: var(--font-mono);
    font-variant-numeric: lining-nums tabular-nums;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    padding-top: 3px;
  }
  .ob { display: grid; gap: 5px; }
  .ob b { font-size: 17px; line-height: 1.35; }
  .ob p { margin: 0; color: rgba(255, 255, 255, 0.82); font-size: 14.5px; line-height: 1.6; }

  .ofoot { display: grid; gap: 18px; }
  .oacts { display: grid; gap: 14px; justify-items: start; align-items: center; }
  @media (min-width: 760px) {
    .oacts { grid-template-columns: auto minmax(0, 1fr); gap: 22px; }
  }
  .ogift {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 0;
    max-width: 70ch;
    font-size: 15px;
    line-height: 1.6;
    color: #fff;
  }
  .ogift :global(svg) { flex: none; margin-top: 4px; }
  .ogift a,
  .olead a {
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.55);
    text-underline-offset: 3px;
  }
  .ogift a:hover,
  .olead a:hover { text-decoration-color: #fff; }

  @media print {
    .obox { background: none; color: #000; border: 1px solid #000; box-shadow: none; }
    .obox h2, .ob b { color: #000; }
    .olead, .ob p, .odis { color: #000; }
  }
</style>

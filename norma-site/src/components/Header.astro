---
import { SITE, href } from '../config/site'
import Icon from './Icon.astro'
import LogoMark from './LogoMark.astro'

const nav = [
  { label: 'Услуги', url: href('/uslugi/') },
  { label: 'Стоимость', url: href('/stoimost/') },
  { label: 'Кому нужна СРО', url: href('/komu-nuzhna-sro/') },
  { label: 'Города', url: href('/sro/') },
  { label: 'База знаний', url: href('/baza-znaniy/') },
  { label: 'Контакты', url: href('/kontakty/') },
]

// Где посетитель сейчас. Раздел подсвечивается и на вложенных страницах:
// со статьи о пороге 10 млн подсвечена «База знаний», со страницы услуги —
// «Услуги». Без этого на двадцати страницах из двадцати меню выглядит
// одинаково, и человек теряет, в каком разделе находится.
const path = Astro.url.pathname
const isCurrent = (url: string) => path === url || (url !== href('/') && path.startsWith(url))
---

<header class="site-header">
  <div class="wrap hdr">
    <a class="logo" href={href('/')}>
      <LogoMark size={27} class="logo-mark" />
      <span class="logo-text">
        <b>{SITE.brand}</b>
        <small>{SITE.brandTag}</small>
      </span>
    </a>

    <nav class="nav" aria-label="Основное меню">
      {nav.map((item) => (
        <a href={item.url} aria-current={isCurrent(item.url) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="hdr-right">
      <button
        class="icon-search"
        type="button"
        aria-label="Поиск по сайту"
        aria-expanded="false"
        aria-controls="site-search"
      >
        <Icon name="search" size={19} />
      </button>
      <a class="phone" href={SITE.phoneHref}>
        <Icon name="phone" size={16} />
        <span>
          <b>{SITE.phone}</b>
          <small>{SITE.geoShort}</small>
        </span>
      </a>
      {/* Кнопка в шапке ведёт к форме, а НЕ к калькулятору.
          Раньше вела к калькулятору и повторяла слово в слово главную кнопку
          первого экрана: две одинаковые красные кнопки с одинаковой надписью
          в поле зрения разом. Прятать её до прокрутки пробовали — место
          под неё приходится держать всегда (иначе при появлении шапка
          дёргается), и на первом экране справа оставалась дыра в 190 px.
          Развести действия оказалось и проще, и честнее: в первом экране
          «проверить, нужна ли СРО» — необязывающий шаг, в шапке «оставить
          заявку» — целевой, и он же заменил круглую плавающую кнопку. */}
      <a class="btn btn--acc btn--sm hdr-cta" href={href('/kontakty/#form')}>Оставить заявку</a>
      <!-- На телефоне номер должен быть виден с первого экрана, не только
           в нижней панели, которая появляется после прокрутки. -->
      <a class="icon-phone" href={SITE.phoneHref} aria-label={`Позвонить ${SITE.phone}`} data-goal="click_phone">
        <Icon name="phone" size={19} />
      </a>
      <button class="burger" type="button" aria-label="Меню" aria-expanded="false" aria-controls="mobile-menu">
        <span class="burger-open"><Icon name="menu" size={22} /></span>
        <span class="burger-close"><Icon name="x" size={22} /></span>
      </button>
    </div>
  </div>

  <!-- Строка поиска. Лежит внутри шапки, поэтому раскрывается ровно под ней
       на любой странице. Индекс подгружается при первом обращении к поиску,
       а не вместе со страницей: он весит больше, чем вся остальная страница,
       и на скорость открытия сайта влиять не должен. -->
  <div class="search-panel" id="site-search" hidden>
    <div class="wrap">
      <form class="sp-form" role="search" action={href('/poisk/')} method="get">
        <span class="sp-ico" aria-hidden="true"><Icon name="search" size={18} /></span>
        <input
          class="sp-input"
          type="search"
          name="q"
          placeholder="Найти на сайте: взносы, документы, НРС…"
          autocomplete="off"
          aria-label="Что искать"
        />
        <button class="sp-close" type="button" aria-label="Закрыть поиск">
          <Icon name="x" size={18} />
        </button>
      </form>
      <p class="sp-status" role="status"></p>
      <div class="sp-out" hidden></div>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="wrap">
      <!-- Поиск в меню. На узком телефоне кнопка поиска в шапке не помещается:
           знак, поиск, телефон и меню — четыре элемента, и при 320 px ряд
           вылезал за край. Здесь поле обычное, без живой подсказки: оно
           уводит на страницу результатов, где список и так весь. -->
      <form class="mm-search" role="search" action={href('/poisk/')} method="get">
        <input
          type="search"
          name="q"
          placeholder="Поиск по сайту"
          aria-label="Поиск по сайту"
          autocomplete="off"
        />
        <button type="submit" aria-label="Найти">
          <Icon name="search" size={18} />
        </button>
      </form>

      <nav aria-label="Меню на мобильном">
        {nav.map((item) => (
          <a href={item.url} aria-current={isCurrent(item.url) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a class="btn btn--acc mm-cta" href={href('/#calc')}>Проверить, нужна ли СРО</a>
      <a class="mm-phone" href={SITE.phoneHref}>{SITE.phone}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--dark);
    color: var(--on-dark);
    border-bottom: 1px solid var(--dark-line);
    transition: box-shadow var(--t-mid) var(--ease);
  }
  /* Прокрутили страницу — шапка подбирается и отделяется тенью от листа.
     Класс вешает скрипт внизу компонента. Смысл не в украшении: на белой
     странице тёмная шапка без тени выглядит наклеенной, а не лежащей
     поверх. */
  .site-header.stuck { box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.55); }

  .hdr {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    /* Подбирается содержимое шапки, а не сама шапка. Раньше при прокрутке
       уменьшались отступы, и это стоило дорого: высота шапки менялась
       с 79 до 71 px, а шапка стоит в потоке (position: sticky) — значит
       вся страница под ней прыгала на 8 px в момент, когда посетитель
       только тронул колесо. Вдобавок padding пересчитывает раскладку
       на каждом кадре перехода, и это те самые 340 мс, на которых
       прокрутка ощущалась не гладкой.
       Масштаб такой цены не имеет: он считается композитором, высота
       шапки остаётся 79 px всегда, страница не двигается. */
    transition: transform var(--t-mid) var(--ease);
    transform-origin: 50% 50%;
  }
  .site-header.stuck .hdr { transform: scale(0.965); }

  .nav a,
  .logo,
  .phone,
  .icon-phone,
  .burger { transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease); }

  /* Подчёркивание в меню выезжает из-под пункта, а не появляется разом. */
  .nav a { position: relative; }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -5px;
    height: 1.5px;
    background: var(--acc-bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-mid) var(--ease);
  }
  .nav a:hover::after { transform: scaleX(1); }

  /* Раздел, в котором посетитель находится: подчёркнут постоянно. */
  .nav a[aria-current='page'] { color: #fff; }
  .nav a[aria-current='page']::after { transform: scaleX(1); }

  .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; color: #fff; flex: none; }
  /* Монограмма стоит без рамки: знак самодостаточный, рамка спорила бы
     с его собственной геометрией.
     :global обязателен — знак приходит из отдельного компонента, и обычное
     правило до него не достаёт: Astro привязывает стили к служебному атрибуту,
     которого у чужой разметки нет. Без этого знак остался бы белым. */
  .logo :global(.logo-mark) { color: var(--acc-bright); flex: none; display: block; }
  .logo-text { display: grid; line-height: 1.15; }
  .logo-text b { font-family: var(--font-head); font-size: 17px; font-weight: 800; letter-spacing: 0.08em; }
  .logo-text small { font-size: 11px; letter-spacing: 0.01em; color: var(--on-dark-muted); }

  .nav { display: none; gap: 20px; font-size: 14.5px; }
  /* Отступ сверху и снизу растит область нажатия с 23 до 31 px: строка
     меню мелкая по замыслу, но попадать в неё должно быть легко.
     Подчёркивание при наведении стоит на ::after с фиксированным
     bottom, поэтому от отступа не уезжает. */
  .nav a {
    color: var(--on-dark-muted);
    text-decoration: none;
    white-space: nowrap;
    padding-block: 4px;
  }
  .nav a:hover { color: #fff; }

  .hdr-right { margin-left: auto; display: flex; align-items: center; gap: 14px; }

  .phone { display: none; align-items: center; gap: 8px; color: #fff; text-decoration: none; }
  .phone svg { color: var(--acc-bright); flex: none; }
  .phone span { display: grid; line-height: 1.2; }
  .phone b { font-family: var(--font-mono); font-size: 14px; font-weight: 500; white-space: nowrap; }
  .phone small { font-size: 10.5px; color: var(--on-dark-muted); white-space: nowrap; }

  .hdr-cta { display: none; }

  .burger,
  .icon-phone {
    background: transparent;
    border: 1px solid var(--dark-line);
    border-radius: var(--r-s);
    color: var(--on-dark);
    /* 44×44 — норма попадания пальцем, и в покое кнопки именно такие.
       При прокрутке шапка подбирается (transform: scale(0.965)), и вместе
       с ней кнопки становятся 42.5 px. Это осознанный размен: высота шапки
       обязана оставаться постоянной, иначе страница под липкой шапкой
       прыгает, а масштаб — единственный способ подобрать содержимое,
       ничего не пересчитывая. Полтора пикселя ниже рекомендации AAA
       (44 px) при выполненной норме AA (24 px) дешевле, чем прыгающая
       страница. */
    box-sizing: border-box;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    cursor: pointer;
    text-decoration: none;
    flex: none;
  }
  .icon-phone { color: var(--acc-bright); border-color: color-mix(in srgb, var(--acc-bright) 40%, transparent); }

  /* Кнопка поиска — того же размера и вида, что телефон и меню:
     в ряду одинаковых кнопок глаз не должен спотыкаться. */
  .icon-search {
    background: transparent;
    border: 1px solid var(--dark-line);
    border-radius: var(--r-s);
    color: var(--on-dark);
    box-sizing: border-box;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex: none;
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .icon-search:hover { color: var(--acc-bright); }
  .icon-search[aria-expanded='true'] {
    color: var(--acc-bright);
    border-color: color-mix(in srgb, var(--acc-bright) 45%, transparent);
  }

  /* ── Строка поиска ────────────────────────────────────────────────────
     Раскрывается под шапкой во всю ширину. Шапка липкая (position: sticky)
     и потому сама служит точкой отсчёта для этой панели — отдельной
     обёртки не нужно. */
  .search-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--dark);
    border-top: 1px solid var(--dark-line);
    border-bottom: 1px solid var(--dark-line);
    box-shadow: 0 24px 44px -28px rgba(0, 0, 0, 0.8);
    padding: 14px 0 18px;
    max-height: calc(100dvh - 100%);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .sp-form {
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--dark-line);
  }
  .sp-ico { color: var(--on-dark-muted); display: grid; place-items: center; flex: none; }
  .sp-input {
    flex: 1 1 auto;
    min-width: 0;
    background: transparent;
    border: 0;
    color: var(--on-dark);
    font-family: var(--font-body);
    /* 16 px — не вкусовщина: при меньшем размере Safari на телефоне
       приближает страницу, когда встаёшь в поле, и обратно уже не отдаёт. */
    font-size: 16.5px;
    padding: 12px 0;
  }
  .sp-input::placeholder { color: var(--on-dark-muted); }
  .sp-input:focus { outline: none; }
  .sp-form:focus-within { border-bottom-color: var(--acc-bright); }
  /* Крестик очистки у type="search" в вебките рисуется тёмным
     и на тёмной шапке пропадает. */
  .sp-input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }

  .sp-close {
    background: transparent;
    border: 0;
    color: var(--on-dark-muted);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex: none;
    border-radius: var(--r-s);
  }
  .sp-close:hover { color: var(--on-dark); }

  .sp-status { margin: 12px 0 0; font-size: 13.5px; color: var(--on-dark-muted); }
  .sp-status:empty { display: none; }
  .sp-out { display: grid; gap: 2px; margin-top: 8px; }

  /* Найденное вставляет скрипт, а не разметка страницы. Астро помечает
     своим признаком только то, что написано в шаблоне, — до вставленного
     обычные правила не достают, и без :global() список остался бы
     без единого стиля. Обёртка .sp-out в шаблоне есть, поэтому область
     действия правил всё равно ограничена ею. */
  .sp-out :global(.s-hit) {
    display: grid;
    gap: 3px;
    padding: 11px 12px;
    margin: 0 -12px;
    border-radius: var(--r-s);
    text-decoration: none;
    color: var(--on-dark);
  }
  .sp-out :global(.s-hit:hover),
  .sp-out :global(.s-hit:focus-visible) { background: var(--dark-2); color: var(--on-dark); }
  .sp-out :global(.s-sec) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .sp-out :global(.s-title) { font-family: var(--font-head); font-size: 16.5px; line-height: 1.3; color: #fff; }
  .sp-out :global(.s-snip) { font-size: 13.5px; line-height: 1.55; color: var(--on-dark-muted); }
  /* Подсветка найденного. Фон — разбавленный акцент: по нему белые буквы
     дают 14:1, тогда как сам акцент под белым текстом дал бы 3,4:1. */
  .sp-out :global(mark) {
    background: color-mix(in srgb, var(--acc-bright) 22%, transparent);
    color: #fff;
    border-radius: 2px;
    padding: 0 2px;
  }

  .sp-out :global(.sp-all) {
    display: inline-block;
    margin-top: 10px;
    font-size: 14px;
    color: var(--acc-bright);
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-search { transition: none; }
  }

  .burger-close { display: none; }
  .burger[aria-expanded='true'] .burger-open { display: none; }
  .burger[aria-expanded='true'] .burger-close { display: block; }

  /* Меню на весь экран, как на образце: тёмная подложка, крупные ссылки
     по центру. Шапка остаётся видимой сверху, поэтому отступ под неё. */
  .mobile-menu {
    position: fixed;
    inset: 68px 0 0;
    background: var(--dark);
    padding: 28px 0 40px;
    overflow-y: auto;
    z-index: 49;
  }
  .mobile-menu .wrap { min-height: 100%; display: grid; align-content: center; gap: 4px; }
  .mm-search {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 auto 18px;
    width: 100%;
    max-width: 420px;
    border: 1px solid var(--dark-line);
    border-radius: var(--r-s);
    padding-left: 14px;
  }
  .mm-search:focus-within { border-color: var(--acc-bright); }
  .mm-search input {
    flex: 1 1 auto;
    min-width: 0;
    background: transparent;
    border: 0;
    color: var(--on-dark);
    font-family: var(--font-body);
    /* 16 px и больше: при меньшем Safari на телефоне приближает страницу,
       когда встаёшь в поле, и обратно уже не отдаёт. */
    font-size: 16.5px;
    padding: 13px 0;
  }
  .mm-search input::placeholder { color: var(--on-dark-muted); }
  .mm-search input:focus { outline: none; }
  .mm-search input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
  .mm-search button {
    background: transparent;
    border: 0;
    color: var(--acc-bright);
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex: none;
  }

  .mobile-menu nav { display: grid; justify-items: center; gap: 4px; }
  .mobile-menu nav a {
    color: var(--on-dark);
    text-decoration: none;
    padding: 15px 10px;
    font-size: 20px;
    text-align: center;
  }
  .mobile-menu nav a:hover { color: var(--acc-bright); }
  .mobile-menu nav a[aria-current='page'] { color: var(--acc-bright); }
  .mm-cta { margin-top: 24px; width: 100%; }
  .mm-phone {
    display: block;
    margin-top: 12px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 17px;
    color: var(--acc-bright);
    text-decoration: none;
  }

  /* На узком телефоне кнопки поиска в шапке нет: знак, поиск, телефон
     и меню в один ряд при 320 px не помещаются — ряд вылезал за правый
     край на 17 px. Там поиск живёт полем внутри меню (.mm-search).
     Прячем здесь, а не в самом правиле: остальные кнопки шапки устроены
     так же — видны по умолчанию, скрываются медиазапросом. */
  @media (max-width: 559px) {
    .icon-search { display: none; }
  }

  @media (min-width: 768px) {
    .phone { display: flex; }
    .hdr-cta { display: inline-flex; }
    .icon-phone { display: none; }
  }

  /* Гамбургер убирается ровно тогда, когда появляется меню, — не раньше.
     Раньше он прятался с 768 px, а меню приходило с 1000: в полосе между
     ними на сайте не было навигации вообще. Айпад в портрете (768),
     Air (820) и небольшое окно на ноутбуке попадали именно в неё —
     оттуда можно было уйти только по ссылкам в подвале.

     Порог поднят с 1000 до 1100 px, когда в меню появился шестой пункт
     «Города»: на 1000 px шапка от него вылезала за правый край. Оба правила
     ниже двигаются вместе — иначе полоса без навигации вернётся. */
  @media (min-width: 1100px) {
    .nav { display: flex; }
    .burger { display: none; }
    .mobile-menu { display: none !important; }
  }

  /* Подпись под номером — деталь, а не главное в шапке. В полосе, где меню
     уже появилось, а экран ещё узкий, она распирала строку и выталкивала
     кнопку за край: при 1024 px шапка вылезала на 49 px и появлялась
     горизонтальная прокрутка. Прячем подпись там, где она не помещается.
     Подрезать под ширину сам текст нельзя: тогда каждая правка
     формулировки снова ломала бы шапку, а формулировку здесь правят
     (например, когда к «выписка за 2–3 дня» добавили «с подачи»).
     Верхняя граница полосы поднята с 1179 до 1279 px вместе с шестым пунктом
     меню: шапка с подписью перестаёт вылезать только с 1258 px, и на 1180
     она давала 37 px горизонтальной прокрутки. Ширины 1279 и 1360 стоят
     в scripts/test-widths.mjs по обе стороны границы — то есть проверка
     видит и полосу без подписи, и полосу с ней. */
  @media (min-width: 1100px) and (max-width: 1279px) {
    .phone small { display: none; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger')
  const menu = document.getElementById('mobile-menu')

  // Меню и поиск занимают одно и то же место под шапкой и потому
  // закрывают друг друга. Ссылки на закрытие объявлены здесь, чтобы
  // оба блока могли до них дотянуться.
  let closeMenu = () => {}
  let closeSearch = () => {}

  if (burger && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open
      burger.setAttribute('aria-expanded', String(open))
      document.body.style.overflow = open ? 'hidden' : ''
      if (open) closeSearch()
    }
    closeMenu = () => {
      if (!menu.hidden) setOpen(false)
    }

    burger.addEventListener('click', () => setOpen(menu.hidden))

    // Закрытие по Esc и по клику вне меню — иначе на телефоне из него не выйти.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false)
    })
    document.addEventListener('click', (e) => {
      const target = e.target as Node
      if (!menu.hidden && !menu.contains(target) && !burger.contains(target)) setOpen(false)
    })
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)))
  }

  // ── Поиск по сайту ─────────────────────────────────────────────────────
  //
  // Индекс и разбор слов подгружаются при первом обращении к поиску,
  // а не вместе со страницей: вместе они весят больше, чем вся остальная
  // страница, и на скорость открытия сайта влиять не должны.
  const searchBtn = document.querySelector<HTMLButtonElement>('.icon-search')
  const panel = document.getElementById('site-search')
  const form = panel?.querySelector<HTMLFormElement>('.sp-form')
  const input = panel?.querySelector<HTMLInputElement>('.sp-input')
  const out = panel?.querySelector<HTMLElement>('.sp-out')
  const status = panel?.querySelector<HTMLElement>('.sp-status')
  const closeBtn = panel?.querySelector<HTMLButtonElement>('.sp-close')

  if (searchBtn && panel && form && input && out && status && closeBtn) {
    const base = document.body.dataset.base || '/'
    const searchUrl = base.replace(/\/$/, '') + '/poisk/'

    type Lib = typeof import('../lib/search')
    let lib: Lib | null = null
    let docs: ReturnType<Lib['prepare']> | null = null
    let loading: Promise<void> | null = null

    const load = () => {
      if (!loading) {
        loading = (async () => {
          const [mod, raw] = await Promise.all([
            import('../lib/search'),
            fetch(base + 'search-index.json').then((r) => {
              if (!r.ok) throw new Error(`индекс не загрузился: ${r.status}`)
              return r.json()
            }),
          ])
          lib = mod
          docs = mod.prepare(raw)
        })().catch((e) => {
          // Следующая попытка должна начаться заново, а не ждать
          // уже провалившееся обещание.
          loading = null
          throw e
        })
      }
      return loading
    }

    const clear = () => {
      out.hidden = true
      out.innerHTML = ''
      status.textContent = ''
    }

    const setOpen = (open: boolean) => {
      panel.hidden = !open
      searchBtn.setAttribute('aria-expanded', String(open))
      if (open) {
        closeMenu()
        load().catch(() => {})
        input.focus()
      } else {
        clear()
      }
    }
    closeSearch = () => {
      if (!panel.hidden) setOpen(false)
    }

    searchBtn.addEventListener('click', () => setOpen(panel.hidden))
    closeBtn.addEventListener('click', () => {
      setOpen(false)
      searchBtn.focus()
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false)
        searchBtn.focus()
      }
    })
    document.addEventListener('click', (e) => {
      const target = e.target as Node
      if (!panel.hidden && !panel.contains(target) && !searchBtn.contains(target)) setOpen(false)
    })

    // Стрелками — по найденному, как в поисковой строке браузера.
    panel.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return
      const links = [...out.querySelectorAll<HTMLAnchorElement>('.s-hit')]
      if (links.length === 0) return
      e.preventDefault()
      const at = links.indexOf(document.activeElement as HTMLAnchorElement)
      if (e.key === 'ArrowDown') links[at < 0 ? 0 : Math.min(at + 1, links.length - 1)].focus()
      else if (at <= 0) input.focus()
      else links[at - 1].focus()
    })

    const SHOWN = 6
    let timer = 0

    const render = async () => {
      const q = input.value.trim()
      if (q.length < 2) {
        clear()
        return
      }
      try {
        await load()
      } catch {
        out.hidden = true
        out.innerHTML = ''
        status.textContent = 'Поиск сейчас недоступен. Обновите страницу или откройте базу знаний.'
        return
      }
      if (!lib || !docs) return

      // Сотня вместо предела по умолчанию: на сайте 44 страницы,
      // и это значит «все» — иначе счётчик найденного врал бы.
      const hits = lib.search(docs, q, 100)
      if (hits.length === 0) {
        out.hidden = true
        out.innerHTML = ''
        status.textContent = 'Ничего не нашлось. Попробуйте другое слово — например «взносы» или «документы».'
        return
      }

      status.textContent = `Найдено: ${lib.foundLabel(hits.length)}`
      let html = lib.hitsHtml(hits.slice(0, SHOWN), base)
      if (hits.length > SHOWN) {
        html += `<a class="sp-all" href="${searchUrl}?q=${encodeURIComponent(q)}">Показать все результаты →</a>`
      }
      out.innerHTML = html
      out.hidden = false
    }

    input.addEventListener('input', () => {
      window.clearTimeout(timer)
      timer = window.setTimeout(render, 140)
    })

    // Enter уводит на страницу результатов: там весь список и есть куда
    // вернуться по ссылке. Форма — обычная, поэтому работает и без скриптов.
    form.setAttribute('action', searchUrl)
    form.addEventListener('submit', () => {
      const w = window as unknown as { ym?: (...a: unknown[]) => void; __metrikaId?: string }
      if (typeof w.ym === 'function' && w.__metrikaId) w.ym(w.__metrikaId, 'reachGoal', 'site_search')
    })
    out.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.s-hit')) return
      const w = window as unknown as { ym?: (...a: unknown[]) => void; __metrikaId?: string }
      if (typeof w.ym === 'function' && w.__metrikaId) w.ym(w.__metrikaId, 'reachGoal', 'search_click')
    })
  }

  // Шапка «прилипла»: как только страница сдвинулась, она подбирается
  // и получает тень. Проверка идёт на кадре прокрутки, а не по таймеру,
  // и слушатель помечен passive — иначе браузер ждёт от него отмены
  // прокрутки и на телефоне появляются рывки.
  const header = document.querySelector('.site-header')
  if (header) {
    let ticking = false
    const update = () => {
      header.classList.toggle('stuck', window.scrollY > 8)
      ticking = false
    }
    update()
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(update)
      },
      { passive: true },
    )
  }
</script>

---
// Кому нужна СРО, а кому нет — два честных столбца.
// Блок «не нужна» обязателен и стоит наравне с «нужна», а не мелким шрифтом внизу.
import { LAW } from '../config/facts'
import Icon from './Icon.astro'

// Короткий вид (brief) для главной убран вместе с разделом: на главной
// на тот же вопрос отвечает калькулятор, а таблица целиком живёт здесь,
// на /komu-nuzhna-sro/, и страница стоит в главном меню. Если короткий
// вид понадобится снова — он в истории git. Помнить при этом: обрезать
// список случаев нельзя, прежний «compact» замалчивал четыре из
// одиннадцати, в том числе «ГУП и МУП членство не требуется».
interface Props {
  /** Уровень заголовков колонок. На странице, где перед таблицей нет своего
      заголовка второго уровня, ставим 2 — иначе порядок заголовков рвётся
      и страдают программы чтения с экрана. */
  headingLevel?: 2 | 3
}
const { headingLevel = 3 } = Astro.props
const H = `h${headingLevel}` as 'h2' | 'h3'

const needed = [
  {
    t: 'Строителям — если обязательства по договору превышают 10 млн ₽',
    d: 'Договор с застройщиком, техническим заказчиком или лицом, ответственным за эксплуатацию здания. У капремонта многоквартирного дома правило своё — строкой ниже.',
    law: LAW.build,
  },
  {
    t: 'Проектировщикам — при любой сумме договора',
    d: 'Порога нет. Прямой договор на подготовку проектной документации, а с 1 марта 2026 года и рабочей, требует членства независимо от цены.',
    law: 'ч. 4 ст. 48 ГрК РФ',
  },
  {
    t: 'Изыскателям — при любой сумме договора',
    d: 'То же правило: для инженерных изысканий денежного порога не установлено.',
    law: 'ч. 4 ст. 47 ГрК РФ',
  },
  {
    t: 'Участникам строительных госзакупок от 10 млн ₽',
    d: 'Плюс отдельный взнос в компенсационный фонд обеспечения договорных обязательств — без него заявку отклонят.',
    law: LAW.rights,
  },
  {
    t: 'Подрядчикам на капремонте общего имущества МКД — при любой сумме',
    // До 29.09.2026 здесь стоял чип ч. 2.1 ст. 52 ГрК — а она как раз
    // разрешает работать без СРО до 10 млн, в том числе с региональным
    // оператором. «При любой сумме» говорит ч. 7 ст. 166 ЖК РФ.
    d: 'С 1 сентября 2024 года — только член СРО, порога 10 млн ₽ нет. Неважно, копит дом у регионального оператора или на специальном счёте.',
    law: LAW.mkdRepair,
  },
  {
    t: 'Техническим заказчикам',
    d: 'Организация, выполняющая функции технического заказчика, должна быть членом соответствующей СРО.',
    law: LAW.techCustomer,
  },
]

const notNeeded = [
  {
    t: 'Субподрядчикам, работающим от генподрядчика — при любой сумме',
    d: 'Требование привязано к тому, с кем заключён договор, а не к его размеру. Договор с подрядной организацией, а не с застройщиком, обязанности членства не создаёт.',
    law: LAW.build,
  },
  {
    t: 'На объектах ИЖС, садовых домах, гаражах',
    d: 'Индивидуальное жилищное строительство и объекты, для которых не требуется разрешение на строительство, выведены из-под требования.',
    law: LAW.build,
  },
  {
    t: 'При сносе, если договор до 1 млн ₽',
    d: 'Для работ по сносу объектов капитального строительства установлен собственный порог.',
    law: LAW.demolition,
  },
  {
    // Письмо Минстроя от 27.02.2026 № 485-ПОС/18; разбор — статья
    // «Авторский надзор: нужно ли членство в СРО».
    t: 'За авторский надзор — пока документацию не меняют',
    d: 'Авторский надзор проверяет, что строят по проекту, а документацию не готовит. Минстрой в 2026 году подтвердил: членства для него закон не требует. Правка проекта по договору с застройщиком — уже проектирование.',
    law: 'ч. 4 ст. 48 ГрК РФ',
  },
  {
    t: 'ГУП, МУП, учреждениям и компаниям с госучастием свыше 50%',
    d: 'Государственным и муниципальным унитарным предприятиям, учреждениям, а также юрлицам с долей публично-правовых образований более 50% членство не требуется.',
    law: LAW.buildExempt,
  },
  {
    t: 'Строителям — если обязательства по договору не превышают 10 млн ₽',
    d: 'Порог поднят с 3 млн до 10 млн законом 124-ФЗ с 1 мая 2022 года. Старая цифра до сих пор встречается на сайтах по теме.',
    law: LAW.build,
  },
]

---

<div class="cols">
  <div class="col col--yes">
    <div class="col-head">
      <span class="ic ic--yes"><Icon name="check" size={18} /></span>
      <H>Членство обязательно</H>
    </div>
    <ul>
      {needed.map((row) => (
        <li>
          <b>{row.t}</b>
          <p>{row.d}</p>
          <span class="law">{row.law}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="col col--no">
    <div class="col-head">
      <span class="ic ic--no"><Icon name="x" size={18} /></span>
      <H>Членство не требуется</H>
    </div>
    <ul>
      {notNeeded.map((row) => (
        <li>
          <b>{row.t}</b>
          <p>{row.d}</p>
          <span class="law">{row.law}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }

  .col { background: var(--card); border: 1px solid var(--line); border-radius: var(--r-l); padding: 24px; }
  .col--no { background: var(--good-bg); border-color: rgba(30, 142, 90, 0.3); }

  .col-head { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
  .col-head h2, .col-head h3 { font-size: 18px; }
  .ic { width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; flex: none; }
  .ic--yes { background: var(--acc-soft); color: var(--acc-deep); }
  .ic--no { background: rgba(30, 142, 90, 0.14); color: var(--good); }

  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  li { display: grid; gap: 5px; }
  li b { font-size: 15.5px; font-weight: 600; line-height: 1.4; }
  li p { font-size: 14px; color: var(--muted); }
  li .law { justify-self: start; }

  .col--no li .law {
    color: var(--good);
    background: rgba(30, 142, 90, 0.1);
    border-color: rgba(30, 142, 90, 0.35);
  }

  @media (max-width: 800px) {
    .cols { grid-template-columns: 1fr; }
  }
</style>

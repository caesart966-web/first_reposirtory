---
// Силуэт города для первого экрана.
//
// Нарисован кодом, а не фотография. Причины: во-первых, весит около килобайта
// вместо трёхсот и не тормозит загрузку на мобильном интернете; во-вторых,
// не нужно разбираться с правами на снимок; в-третьих, остаётся чётким
// на любом экране. Если захотите настоящее фото — положите его в public/img/
// и замените этот компонент на <img> в Hero.astro.
---

<svg
  class="skyline"
  viewBox="0 0 1440 420"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="sky-far" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#16304F" />
      <stop offset="100%" stop-color="#0F2340" />
    </linearGradient>
    <linearGradient id="sky-near" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#122845" />
      <stop offset="100%" stop-color="#0B1D33" />
    </linearGradient>
  </defs>

  <!-- Дальний план: башни ниже и бледнее — так появляется глубина -->
  <g fill="url(#sky-far)">
    <rect x="40" y="210" width="86" height="210" />
    <rect x="150" y="260" width="64" height="160" />
    <rect x="238" y="180" width="74" height="240" />
    <rect x="336" y="245" width="92" height="175" />
    <rect x="452" y="205" width="60" height="215" />
    <rect x="536" y="150" width="80" height="270" />
    <rect x="640" y="230" width="70" height="190" />
    <rect x="734" y="120" width="88" height="300" />
    <rect x="846" y="215" width="66" height="205" />
    <rect x="936" y="170" width="82" height="250" />
    <rect x="1042" y="240" width="72" height="180" />
    <rect x="1138" y="195" width="90" height="225" />
    <rect x="1252" y="255" width="68" height="165" />
    <rect x="1344" y="200" width="76" height="220" />
  </g>

  <!-- Ближний план: выше, темнее, с окнами -->
  <g fill="url(#sky-near)">
    <rect x="96" y="300" width="110" height="120" />
    <rect x="286" y="285" width="96" height="135" />
    <rect x="482" y="265" width="118" height="155" />
    <rect x="672" y="240" width="104" height="180" />
    <rect x="880" y="290" width="112" height="130" />
    <rect x="1070" y="270" width="98" height="150" />
    <rect x="1268" y="300" width="106" height="120" />
  </g>

  <!-- Редкие светящиеся окна: оживляют силуэт, но не спорят с текстом -->
  <g fill="#6BA3FF" opacity="0.45">
    <rect x="756" y="150" width="8" height="14" /><rect x="776" y="150" width="8" height="14" />
    <rect x="756" y="180" width="8" height="14" /><rect x="796" y="196" width="8" height="14" />
    <rect x="556" y="180" width="8" height="14" /><rect x="576" y="212" width="8" height="14" />
    <rect x="956" y="200" width="8" height="14" /><rect x="976" y="232" width="8" height="14" />
    <rect x="258" y="210" width="8" height="14" /><rect x="278" y="244" width="8" height="14" />
    <rect x="1158" y="225" width="8" height="14" /><rect x="1188" y="258" width="8" height="14" />
    <rect x="700" y="270" width="8" height="14" /><rect x="730" y="304" width="8" height="14" />
    <rect x="504" y="296" width="8" height="14" /><rect x="534" y="330" width="8" height="14" />
  </g>
</svg>

<style>
  .skyline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 62%;
    display: block;
    pointer-events: none;
  }
</style>

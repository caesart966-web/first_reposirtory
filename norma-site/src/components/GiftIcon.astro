---
// ЗНАЧКИ ПОДАРКОВ — окошко «Подарок на выбор» на первом экране главной.
//
// «Сайт» — значок, который прислал заказчик (28.09.2026): окно браузера
// со строкой поиска и курсором. Не обведён potrace, как DirIcon, а начерчен
// заново по его картинке — координаты здесь в пикселях присланного файла,
// снятых по середине линий. Фигуры в нём простые (прямоугольники, круги,
// ломаная курсора), и чертёж даёт ровные линии там, где обводка растра
// оставляет лёгкую волну.
//
// Линия вдвое толще, чем в присланном файле: там 4 px на картинку в 256,
// и на 40 px значок превращался в паутинку. Кружки в строке и лупа — тоньше
// остального, иначе в них не остаётся просвета.
//
// «Год» и «кэшбэк» заказчик не присылал — они начерчены тем же приёмом,
// в той же сетке и той же линией, чтобы три значка в ряд читались одним
// набором: календарь с шапкой (повторяет верхнюю полосу окна браузера)
// и монета с ₽ под стрелкой возврата.
import type { Gift } from '../config/offer'

interface Props {
  name: Gift['id']
  size?: number
}
const { name, size = 40 } = Astro.props

const ICONS: Record<Props['name'], string> = {
  site:
    '<rect x="34.5" y="18.5" width="252" height="233" rx="11"/><path d="M34.5 57.5h252"/>' +
    '<g stroke-width="6"><circle cx="57.5" cy="38.5" r="6.5"/><circle cx="82.5" cy="38.5" r="6.5"/><circle cx="107.5" cy="38.5" r="6.5"/></g>' +
    '<rect x="140.5" y="31.5" width="129" height="14" rx="7"/>' +
    '<rect x="52.5" y="78.5" width="216" height="37" rx="4"/><path d="M92.5 78.5v37"/>' +
    '<g stroke-width="6"><circle cx="71" cy="95" r="7"/><path d="M76.5 100.5l5 5"/></g>' +
    '<rect x="52.5" y="134" width="132" height="99.5" rx="2"/>' +
    '<rect x="202.5" y="134" width="66" height="40.5" rx="2"/><rect x="202.5" y="193" width="66" height="40.5" rx="2"/>' +
    '<path d="M124.5 175.5L136 214.5l7.5-12.5 16 14.5 8-7-16-16.5 13.5-8.5z"/>',
  year:
    '<rect x="40" y="44" width="240" height="204" rx="11"/><path d="M40 92h240"/><path d="M100 24v38M220 24v38"/>' +
    '<rect x="64" y="114" width="48" height="40" rx="3"/><rect x="136" y="114" width="48" height="40" rx="3"/><rect x="208" y="114" width="48" height="40" rx="3"/>' +
    '<rect x="64" y="182" width="48" height="40" rx="3"/><rect x="136" y="182" width="48" height="40" rx="3"/><rect x="208" y="182" width="48" height="40" rx="3"/>',
  cashback:
    '<circle cx="161" cy="135" r="64"/>' +
    '<path d="M147.5 101v70M147.5 101H169a19 19 0 0 1 0 38h-21.5M134 157h39"/>' +
    '<path d="M242.2 66.9A106 106 0 1 0 260.6 171.3"/><path d="M233.5 188.3L260.6 171.3L270.5 201.7"/>',
}
---

<svg
  viewBox="29 13 264 244"
  width={size}
  height={Math.round((size * 244) / 264)}
  fill="none"
  stroke="currentColor"
  stroke-width="8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>

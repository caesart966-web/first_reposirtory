---
// Блок проверяемости: прямые ссылки на официальные реестры.
// Ни один конкурент этого не делает — а это самый простой способ показать,
// что скрывать нечего.
import { REGISTRIES, SITE } from '../config/site'
import Icon from './Icon.astro'
---

<section class="section reg" id="proverka" data-anchor>
  <div class="wrap">
    <div class="s-head rv">
      <span class="eyebrow">Проверяемость</span>
      <h2>Проверьте нас и любую СРО <em>в госреестре</em></h2>
      <p>
        Не верьте на слово ни мне, ни кому-либо ещё на этом рынке. Всё проверяется
        бесплатно и за минуту в официальных реестрах национальных объединений.
        Ссылки прямые — открываются в новой вкладке.
      </p>
    </div>

    <div class="grid-2">
      <a class="card reg-card rv" href={REGISTRIES.nostroy} target="_blank" rel="noopener noreferrer">
        <div class="rc-top">
          <Icon name="search" size={20} />
          <span class="host">reestr.nostroy.ru</span>
        </div>
        <h3>Реестр НОСТРОЙ — строители</h3>
        <p>
          Единый реестр членов СРО в строительстве. Здесь видно, состоит ли компания
          в СРО, с какого числа, какой у неё уровень ответственности и не исключена ли она.
          Там же — национальный реестр специалистов (НРС).
        </p>
        <span class="go">Открыть реестр <Icon name="arrow" size={16} /></span>
      </a>

      <a class="card reg-card rv" href={REGISTRIES.nopriz} target="_blank" rel="noopener noreferrer">
        <div class="rc-top">
          <Icon name="search" size={20} />
          <span class="host">nopriz.ru</span>
        </div>
        <h3>Реестр НОПРИЗ — проектировщики и изыскатели</h3>
        <p>
          Национальное объединение изыскателей и проектировщиков. Реестр членов СРО
          и реестр специалистов для проектных и изыскательских компаний.
        </p>
        <span class="go">Открыть реестр <Icon name="arrow" size={16} /></span>
      </a>
    </div>

    <!-- Карточка реквизитов в стиле образца. Важное отличие: на образце
         в такой карточке стоят атрибуты самой СРО — номер в госреестре,
         число членов, сканы свидетельств. Здесь их быть не может: заказчик
         не саморегулируемая организация, а специалист, который помогает
         в неё вступить. Поэтому в карточке только его настоящие реквизиты. -->
    <div class="ident rv">
      <h3 class="ident-title">Кто я и как меня проверить</h3>

      <dl class="ident-rows">
        <div>
          <dt>Полное наименование</dt>
          <dd>{SITE.legalName}</dd>
        </div>
        <div>
          <dt>Статус</dt>
          <dd class="with-mark">
            Индивидуальный предприниматель
            <span class="verified"><Icon name="check" size={14} /> проверяется в ЕГРИП</span>
          </dd>
        </div>
        <div>
          <dt>ИНН</dt>
          <dd class="mono">{SITE.inn}</dd>
        </div>
        {SITE.ogrnip && (
          <div>
            <dt>ОГРНИП</dt>
            <dd class="mono">{SITE.ogrnip}</dd>
          </div>
        )}
        <div>
          <dt>География</dt>
          <dd>{SITE.geo}</dd>
        </div>
        <div>
          <dt>Телефон</dt>
          <dd><a class="ident-phone" href={SITE.phoneHref} data-goal="click_phone">{SITE.phone}</a></dd>
        </div>
      </dl>

      <p class="ident-note">
        <b>Я не саморегулируемая организация.</b> Я не веду реестр, не принимаю взносы
        и не выдаю документы о членстве: решение принимает СРО, взносы вы переводите
        напрямую на её счёт. Моя работа — разобрать вашу ситуацию, подобрать СРО
        и подготовить документы.
      </p>
    </div>

    <div class="reg-note rv">
      <p>
        <b>Не путайте объединения:</b> НОСТРОЙ — это строители, НОПРИЗ — проектировщики
        и изыскатели. Если на сайте вам предлагают «СРО НОСТРОЙ для проектирования» —
        перед вами человек, который не разбирается в предмете.
      </p>
      <p class="who">
        Мои реквизиты для проверки: {SITE.legalName}, ИНН {SITE.inn}
        {SITE.ogrnip && `, ОГРНИП ${SITE.ogrnip}`}. Проверяются на сайте ФНС.
      </p>
    </div>
  </div>
</section>

<style>
  .reg-card { display: grid; gap: 10px; align-content: start; }
  .rc-top { display: flex; align-items: center; gap: 10px; color: var(--acc-deep); }
  .host { font-family: var(--font-mono); font-size: 13px; }
  .reg-card h3 { margin: 0; }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--acc-deep);
    margin-top: 4px;
  }

  .ident {
    margin-top: 18px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-l);
    padding: 26px 28px;
  }
  .ident-title { font-size: 19px; margin-bottom: 20px; }
  .ident-rows { margin: 0; display: grid; gap: 18px; }
  .ident-rows > div { display: grid; gap: 4px; }
  .ident-rows dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ident-rows dd { margin: 0; font-size: 16px; }
  .ident-rows dd.mono { font-family: var(--font-mono); font-size: 15px; }
  .with-mark { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  /* Зелёная плашка с галочкой — приём с образца, но подтверждает она
     проверяемый факт, а не рекламное утверждение. */
  .verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--good);
    background: var(--good-bg);
    border: 1px solid color-mix(in srgb, var(--good) 40%, transparent);
    padding: 4px 11px;
    border-radius: 999px;
  }
  /* Отступы сверху и снизу — чтобы в номер можно было попасть пальцем:
     по стандарту доступности высота ссылки-кнопки от 24 px. */
  .ident-phone {
    font-family: var(--font-mono);
    font-size: 19px;
    color: var(--acc-deep);
    text-decoration: none;
    display: inline-block;
    padding: 3px 0;
  }
  .ident-phone:hover { text-decoration: underline; }
  .ident-note {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 78ch;
  }
  .ident-note b { color: var(--ink); }

  @media (min-width: 700px) {
    .ident-rows { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 40px; }
  }

  .reg-note {
    margin-top: 18px;
    background: var(--acc-soft);
    border: 1px solid color-mix(in srgb, var(--acc) 25%, transparent);
    border-radius: var(--r-m);
    padding: 18px 22px;
    display: grid;
    gap: 8px;
  }
  .reg-note p { font-size: 14.5px; }
  .who { color: var(--muted); font-size: 13.5px; }
</style>

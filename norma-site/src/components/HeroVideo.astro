---
import { href } from '../config/site'

// Фон первого экрана: облёт стройплощадки.
//
// Видео — украшение, а не содержание, поэтому оно не должно мешать
// открыть сайт. Устроено так:
//
// 0. Контраст, яркость и насыщенность подняты прямо в файлах при сжатии:
//    исходник снят в утренней дымке и на сайте выглядел блёклым.
//    Делать это фильтром в браузере нельзя — он пересчитывает каждый кадр.
// 1. Сначала показывается картинка-заглушка (32 КБ) — первый кадр ролика.
//    Она грузится вместе со страницей, и первый экран выглядит готовым сразу.
// 2. Ролик браузер начинает качать только после того, как страница полностью
//    загрузилась и освободилась. Атрибут preload="none" запрещает загрузку
//    до этого момента, а ожидание события load — обязательное условие:
//    иначе ролик отнимает канал у шрифтов и стилей, и страница открывается
//    заметно дольше (проверено замером скорости: 89 против 96 баллов).
//    Файлов два: WebM (828 КБ) для Chrome, Firefox, Яндекс.Браузера и Edge,
//    MP4 (737 КБ) для Safari и айфонов. Браузер берёт тот, который умеет.
// 3. Ролик не грузится совсем, если посетитель включил экономию трафика
//    или в системе стоит «уменьшить движение». Тогда остаётся заглушка.
// 4. Звука в файле нет. Это не только уместнее — браузеры запрещают
//    автозапуск со звуком, и ролик просто не пошёл бы.
//
// Заменить ролик: положите свои файлы в public/video/ (hero.mp4, hero.webm
// и первый кадр hero-poster.webp). Больше ничего менять не нужно.
// Как сделать оба формата из одного файла — написано в README.
---

<div class="hero-bg" aria-hidden="true">
  <video
    class="hero-video"
    poster={href('/video/hero-poster.webp')}
    preload="none"
    muted
    loop
    playsinline
    disablepictureinpicture
    tabindex="-1"
    data-webm={href('/video/hero.webm')}
    data-mp4={href('/video/hero.mp4')}></video>
</div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Тот же тёмно-синий, что и у секции: пока картинка не пришла,
       фон не мигает светлым. */
    background: var(--navy);
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Фильтров здесь больше нет. Контраст и насыщенность подняты в самом
       файле при сжатии (исходник снят в дымке и выглядел блёклым) — так
       лучше, чем фильтром в браузере: тот пересчитывает каждый кадр
       на видеокарте и заметно греет телефон. */
    /* Плавное появление, когда видео сменяет заглушку. */
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .hero-video.ready { opacity: 1; }

  /* Пока видео не запустилось, показываем сам постер — он лежит
     атрибутом poster и рисуется браузером в том же элементе. */
  .hero-video:not(.ready) { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .hero-video { transition: none; }
  }
</style>

<script>
  // Ролик подключается только после того, как страница отрисована,
  // и только если это уместно. Всё остальное время висит заглушка.
  const video = document.querySelector<HTMLVideoElement>('.hero-video')
  if (video) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    const saveData = conn?.saveData === true
    const calmer = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (!saveData && !calmer) {
      const start = () => {
        // Спрашиваем сам браузер, что он умеет: 'probably' или 'maybe'
        // означают, что формат поддерживается, пустая строка — что нет.
        const src = video.canPlayType('video/webm; codecs="vp9"')
          ? video.dataset.webm
          : video.dataset.mp4
        if (!src) return
        video.src = src
        video.addEventListener('canplay', () => video.classList.add('ready'), { once: true })
        // play() возвращает обещание, которое браузер может отклонить
        // (например, экономия энергии на ноутбуке). Это не ошибка:
        // тогда просто остаётся картинка-заглушка.
        video.play().catch(() => {})
      }

      // Ждём полной загрузки страницы, и только потом — свободной минуты
      // у браузера. requestIdleCallback есть не везде, поэтому запасной
      // вариант — обычная задержка.
      const queue = () => {
        if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 3000 })
        else setTimeout(start, 900)
      }
      if (document.readyState === 'complete') queue()
      else window.addEventListener('load', queue, { once: true })

      // Ушли со вкладки — останавливаем: незачем греть телефон
      // роликом, которого никто не видит.
      document.addEventListener('visibilitychange', () => {
        if (!video.src) return
        if (document.hidden) video.pause()
        else video.play().catch(() => {})
      })
    }
  }
</script>

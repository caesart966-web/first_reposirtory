---
// ПОЛОСА ПРО ФАЙЛЫ COOKIE — и заодно единственный выключатель Яндекс.Метрики.
//
// ПОЧЕМУ ПОЛОСА ПОКАЗЫВАЕТСЯ НЕ ВСЕГДА. Она выводится, только когда
// в site.ts вписан номер счётчика или номер организации на Яндекс Картах
// (значок рейтинга, с 05.10.2026). Без них сайт не ставит ни одного файла
// cookie — ни своего, ни чужого, — и сообщать было бы не о чем.
// Полоса «сайт использует cookie» на сайте, который их не использует, —
// это ровно то враньё мелким шрифтом, против которого здесь всё построено.
// Впишете счётчик — полоса появится сама.
//
// «Принять» включает и значок рейтинга (YandexRating.astro): он грузится
// с yandex.ru, и Яндекс ставит свои cookie. О выборе полоса сообщает
// событием CONSENT_EVENT — значок на этой же странице появляется без
// перезагрузки.
//
// ПОЧЕМУ ВЫБОР НАСТОЯЩИЙ. Кнопки две, и «Только необходимые» действительно
// не грузит Метрику: счётчик подключается ИЗ этого скрипта после согласия,
// а не стоит в разметке страницы. Полоса с одной кнопкой «Хорошо» ничего
// не решает — она лишь сообщает о том, что уже случилось.
//
// ВЫБОР ХРАНИТСЯ В localStorage, а не в cookie. Хранить согласие
// на cookie в cookie до получения согласия — замкнутый круг; localStorage
// здесь строго необходим для работы сайта и под согласие не подпадает.
//
// СДВИГА ВЁРСТКИ НЕТ: полоса лежит position: fixed поверх страницы
// и в поток не встаёт. Показатель CLS на сайте равен нулю, и уронить его
// баннером было бы обидно.
import { SITE, YANDEX_ORG, href } from '../config/site'
import { CONSENT_KEY, CONSENT_EVENT } from '../config/consent'

// Счётчик — только на сайте, открытом людям. Превью (PUBLIC_NOINDEX=1)
// считать в той же Метрике нельзя: заходы владельца на черновик смешались
// бы с настоящими, а Вебвизор записывал бы черновик. Без счётчика и значка
// нет и полосы — превью не ставит ни одного файла cookie.
const live = import.meta.env.PUBLIC_NOINDEX !== '1'
const metrikaId = live ? SITE.metrikaId : ''
const rating = live && YANDEX_ORG !== null
---

{(metrikaId || rating) && (
  <div class="cookie" id="cookie-note" role="region" aria-label="Файлы cookie" hidden>
    <div class="wrap cookie-in">
      {/* Коротко нарочно. Прежний текст в четыре строки закрывал на телефоне
          четверть первого экрана — вместе с кнопкой «Узнать стоимость».
          Что именно собирается и зачем, по-прежнему расписано в политике,
          а выбор настоящий: «Только необходимые» Метрику не грузит. */}
      {/* Что включает «Принять» — по тому, что подключено. С Метрикой
          и значком рейтинга строка короче прежней нарочно: «…для статистики
          посещений и значка рейтинга Яндекса» шла на 390 px в три строки,
          а эта — в две, как прежняя (замер 05.10.2026). */}
      <p class="cookie-text">
        {metrikaId && rating
          ? 'Cookie — для статистики и рейтинга Яндекса.'
          : metrikaId
            ? 'Сайт использует cookie для статистики посещений.'
            : 'Cookie — для значка рейтинга Яндекса.'}{' '}
        Подробнее — в <a href={href('/politika/')}>политике обработки данных</a>.
      </p>
      <div class="cookie-act">
        <button type="button" class="btn btn--acc btn--sm" data-cookie="all">Принять</button>
        <button type="button" class="btn btn--ghost-dark btn--sm" data-cookie="need">
          Только необходимые
        </button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ id: metrikaId, key: CONSENT_KEY, evt: CONSENT_EVENT }}>
    ;(function () {
      var note = document.getElementById('cookie-note')

      // localStorage бывает недоступен: приватное окно, запрет на хранение
      // данных сайта. Тогда обращение к нему бросает исключение, и без
      // перехвата падал бы весь скрипт вместе с полосой.
      function read() {
        try {
          return localStorage.getItem(key)
        } catch (e) {
          return null
        }
      }
      function write(value) {
        try {
          localStorage.setItem(key, value)
        } catch (e) {
          /* не сохранили — полоса просто появится снова */
        }
      }

      // Загрузчик и настройки — как в коде, который Метрика выдала для этого
      // счётчика 27 сентября 2026: tag.js с номером в адресе и ssr: true.
      // Отличий три, и все нарочно: код вызывается отсюда, после согласия,
      // а не стоит в разметке; нет картинки в noscript — она уходила бы
      // к Яндексу до всякого выбора; нет ecommerce — магазина на сайте нет.
      // Номер — числом, как в выданном коде: по window.__metrikaId шлются
      // все цели сайта, и ключ счётчика должен совпасть с тем, что в init.
      function loadMetrika() {
        if (!id || window.__metrikaId) return
        var num = Number(id)
        window.__metrikaId = num
        ;(function (m, e, t, r, i, k, a) {
          m[i] =
            m[i] ||
            function () {
              ;(m[i].a = m[i].a || []).push(arguments)
            }
          m[i].l = 1 * new Date()
          for (var j = 0; j < document.scripts.length; j++) {
            if (document.scripts[j].src === r) return
          }
          k = e.createElement(t)
          a = e.getElementsByTagName(t)[0]
          k.async = 1
          k.src = r
          a.parentNode.insertBefore(k, a)
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + num, 'ym')
        window.ym(num, 'init', {
          ssr: true,
          webvisor: true,
          clickmap: true,
          referrer: document.referrer,
          url: location.href,
          accurateTrackBounce: true,
          trackLinks: true,
        })
      }

      // Кнопки связи на телефоне стоят над полосой, а не под ней: её высоту
      // они берут из --cookie-h. Меряет ResizeObserver, а не разовый замер:
      // высота полосы меняется — перенос строк при повороте экрана, запас
      // под полоску iPhone, который Safari меняет на ходу, — и разовый замер
      // устаревал бы. Следим за рамкой целиком (border-box): запас под
      // полоску сидит в отступе, и по одному содержимому его перемены
      // не видно. Спрятанная полоса даёт ноль, и кнопки опускаются.
      if (note && 'ResizeObserver' in window) {
        new ResizeObserver(function () {
          document.documentElement.style.setProperty('--cookie-h', (note.hidden ? 0 : note.offsetHeight) + 'px')
        }).observe(note, { box: 'border-box' })
      }

      var choice = read()
      if (choice === 'all') {
        loadMetrika()
      } else if (choice !== 'need' && note) {
        note.hidden = false
      }

      if (note) {
        note.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-cookie]')
          if (!btn) return
          var value = btn.getAttribute('data-cookie')
          write(value)
          note.hidden = true
          if (value === 'all') loadMetrika()
          // Значку рейтинга (YandexRating.astro): согласие получено сейчас,
          // ждать следующей страницы не нужно.
          document.dispatchEvent(new CustomEvent(evt, { detail: value }))
        })
      }
    })()
  </script>
)}

<style>
  /* Тёмная полоса в тон шапке: тонкая линейка сверху, никаких теней
     и скруглённых карточек — то же «печать и бумага», что и везде. */
  .cookie {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 70;
    background: var(--dark);
    color: var(--on-dark);
    border-top: 1px solid var(--dark-line);
    padding: 14px 0 calc(14px + env(safe-area-inset-bottom, 0px));
  }
  .cookie-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .cookie-text {
    margin: 0;
    flex: 1 1 32ch;
    font-size: 14px;
    line-height: 1.6;
    color: var(--on-dark);
  }
  .cookie-text a {
    color: var(--acc-bright);
    /* Поле промаха: сама строка 17 px по высоте, а попадать в ссылку нужно
       пальцем. Тот же приём, что у ссылок в подвале, — растёт только область
       нажатия, строка на месте. */
    padding-block: 6px;
    margin-block: -6px;
  }
  .cookie-act {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 767px) {
    /* Полоса стоит у самого низа экрана, а кнопки связи поднимаются
       над ней (--cookie-h, скрипт выше). Пока внизу была сплошная панель
       связи, полоса стояла над панелью — панели больше нет. */
    .cookie { padding: 11px 0 calc(11px + env(safe-area-inset-bottom, 0px)); }
    .cookie-in { justify-content: stretch; gap: 9px; }
    .cookie-text { font-size: 13.5px; line-height: 1.5; }
    .cookie-act { width: 100%; gap: 8px; flex-wrap: nowrap; }
    .cookie-act .btn { flex: 1 1 0; padding-inline: 10px; }
  }
  @media (max-width: 380px) {
    .cookie-act .btn { font-size: 13px; padding-inline: 6px; }
  }
</style>

---
// Значки каналов связи для нижней панели на телефоне.
//
// ВСЕ ЧЕТЫРЕ — ОДИНАКОВЫЕ КРУГИ С БЕЛЫМ ЗНАКОМ ПОСЕРЕДИНЕ. Первая версия
// ставила фирменные знаки как есть, и заказчик сказал: «сами иконки кривые».
// Были кривые: тонкое кольцо телефона рядом с залитыми знаками, пузырь
// WhatsApp с хвостиком, выпиравшим влево вниз, круг Telegram и квадрат MAX,
// заметно меньше соседей. Четыре разные формы и четыре разных веса в ряд.
// Теперь форма одна (круг, диаметр во всё поле), вес один (заливка), знак
// один и тот же по размеру (около 60 % круга) и стоит по центру.
//
// Цвета — фирменные: по ним мессенджеры и узнают. СИНИЙ ЗДЕСЬ —
// ИСКЛЮЧЕНИЕ: правило «синего на сайте нет» про палитру сайта, а цвет
// Telegram и MAX — часть их товарного знака. Решение заказчика, записано
// в CLAUDE.md. Телефон — акцент сайта (цвет текста, CSS задаёт --acc-btn):
// тот же цвет, что у кнопок заявки.
//
// Знаки:
//   • WhatsApp — Simple Icons (CC0), белым по зелёному #25D366;
//   • Telegram — самолёт из официального знака, белым по его переходу;
//   • MAX — капля обведена potrace по картинке, присланной заказчиком,
//     фон повторяет цвета их знака по краям;
//   • телефон — трубка Material Icons (Apache 2.0).
//
// У переходов свои id, и на одной странице значок стоит до трёх раз
// (нижняя панель, строка под кнопками первого экрана, строка под формой).
// Повтор id проверка ссылок считает ошибкой, поэтому у каждого места
// своя приставка: idp="hero", idp="apply"; у нижней панели — по умолчанию.
interface Props {
  name: 'phone' | 'whatsapp' | 'telegram' | 'max'
  size?: number
  idp?: string
}
const { name, size = 28, idp = 'bi' } = Astro.props
const id = (k: string) => `${idp}-${k}`
---

{name === 'phone' && (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="12" fill="currentColor" />
    <path
      fill="#FFFFFF"
      transform="translate(12 12) scale(.6) translate(-12 -12)"
      d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"
    />
  </svg>
)}

{name === 'whatsapp' && (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="12" fill="#25D366" />
    <path
      fill="#FFFFFF"
      transform="translate(12 12) scale(.58) translate(-12 -12)"
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
    />
  </svg>
)}

{name === 'telegram' && (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={id("tg")} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#38B0E3" />
        <stop offset="1" stop-color="#1D93D2" />
      </linearGradient>
    </defs>
    <circle cx="12" cy="12" r="12" fill={`url(#${id("tg")})`} />
    <path
      fill="#FFFFFF"
      transform="translate(12 12) scale(.1) translate(-120 -120)"
      d="M100.04 144.41l48.36 35.729c5.519 3.045 9.501 1.468 10.876-5.123l19.685-92.763c2.015-8.08-3.08-11.746-8.36-9.349l-115.59 44.571c-7.89 3.165-7.843 7.567-1.438 9.528l29.663 9.259 68.673-43.325c3.242-1.966 6.218-.91 3.776 1.258"
    />
  </svg>
)}

{name === 'max' && (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={id("mx-a")} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#44CBFF" />
        <stop offset=".5" stop-color="#4C58E7" />
        <stop offset="1" stop-color="#9433DE" />
      </linearGradient>
      <radialGradient id={id("mx-b")} cx=".38" cy="0" r=".62">
        <stop offset="0" stop-color="#2F22B4" stop-opacity=".95" />
        <stop offset="1" stop-color="#2F22B4" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={id("mx-c")} cx="0" cy=".8" r=".55">
        <stop offset="0" stop-color="#44CCFF" />
        <stop offset="1" stop-color="#44CCFF" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={id("mx-d")} cx="1" cy=".05" r=".6">
        <stop offset="0" stop-color="#9A34DD" />
        <stop offset="1" stop-color="#9A34DD" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="12" cy="12" r="12" fill={`url(#${id("mx-a")})`} />
    <circle cx="12" cy="12" r="12" fill={`url(#${id("mx-b")})`} />
    <circle cx="12" cy="12" r="12" fill={`url(#${id("mx-c")})`} />
    <circle cx="12" cy="12" r="12" fill={`url(#${id("mx-d")})`} />
    <g transform="translate(12 12) scale(.0145) translate(-640 -640)">
      <path fill="#FFFFFF" transform="translate(0 1280) scale(.1 -.1)" d="M6182 11260 c-1490 -89 -2849 -810 -3722 -1975 -658 -878 -974 -1896 -946 -3050 20 -862 118 -1453 440 -2653 173 -645 236 -1006 255 -1462 12 -274 36 -346 147 -451 168 -156 499 -180 901 -63 389 113 786 343 1006 585 l63 69 65 -47 c441 -321 851 -513 1254 -588 426 -78 1052 -84 1535 -14 2460 358 4249 2557 4101 5045 -162 2736 -2409 4765 -5099 4604z m463 -2395 c1148 -121 2051 -977 2232 -2115 28 -179 25 -563 -5 -725 -178 -947 -815 -1676 -1714 -1963 -666 -213 -1373 -124 -1962 246 l-98 62 -84 -80 c-251 -237 -507 -396 -603 -375 -184 40 -389 679 -463 1445 -17 181 -18 855 0 1005 65 556 192 958 426 1353 479 806 1347 1244 2271 1147z" />
    </g>
  </svg>
)}

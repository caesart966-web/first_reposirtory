---
// Фоновая фотография в тёмной шапке раздела.
//
// Отдельный компонент, а не копия слоя из Hero.astro: на главной кадр
// растворяется в белой бумаге, здесь — в тёмном графите, и обработка
// нужна противоположная. На белом фотографию высветляют, на тёмном
// приглушают, иначе светлый текст ложится на светлые пятна кадра
// и перестаёт читаться.
//
// Ставится внутрь <section class="section page-head"> первым элементом,
// до .wrap с текстом. Стили лежат в global.css рядом с .page-head:
// правило должно доставать до слоя из любой страницы, а областью
// видимости компонента оно бы туда не дотянулось.
//
// Меняете фотографию или маску — обязательно прогоните
// node scripts/test-hero-photo.mjs: он снимает настоящие пиксели под
// каждой строкой на трёх ширинах. Статический расчёт контраста этого
// не видит — в стилях под текстом ровный тёмный фон.
import { href, SITE } from '../config/site'

interface Props {
  /** Имя файла в public/img/. Без него слой не рисуется вовсе. */
  src?: string
  /** Точка кадра, которая должна остаться в поле зрения. */
  position?: string
}

const { src = SITE.headPhoto, position = '72% center' } = Astro.props
---

{src && (
  <div
    class="head-photo"
    aria-hidden="true"
    style={`background-image: url(${href(`/img/${src}`)}); background-position: ${position}`}
  ></div>
)}

---
import '../styles/fonts.css'
import '../styles/global.css'

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Icon from '../components/Icon.astro'
import { SITE, href } from '../config/site'
import { SEO } from '../config/seo'

interface Props {
  title: string
  description: string
  /** Дополнительные блоки микроразметки Schema.org (FAQ, HowTo, Article) */
  schema?: object[]
  /** Хлебные крошки: [{ label, url }] — последний элемент текущая страница */
  breadcrumbs?: { label: string; url?: string }[]
  /** Закрыть страницу от поиска независимо от режима сборки (страница 404). */
  noindex?: boolean
  /**
   * Тип страницы в микроразметке: ContactPage у контактов, CollectionPage
   * у списков, WebPage у всего остального. Поисковик по нему понимает,
   * что это за страница, не разбирая её текст.
   */
  pageType?: string
  /**
   * Страница — статья. Тогда Open Graph получает тип article и даты:
   * мессенджеры и агрегаторы показывают их в карточке ссылки, а Яндекс
   * использует дату при сортировке по свежести.
   */
  article?: { published: string; modified: string; section?: string }
}

const {
  title,
  description,
  schema = [],
  breadcrumbs = [],
  noindex: noindexProp = false,
  pageType = 'WebPage',
  article,
} = Astro.props

// Полный адрес страницы: нужен для canonical, Open Graph и микроразметки.
const canonical = new URL(Astro.url.pathname, Astro.site).toString()

// Черновик на превью-ссылке не должен попадать в поиск. Боевая сборка на своём
// домене делается без NOINDEX — тогда сайт открыт для индексации.
//
// Плюс отдельные страницы могут закрываться сами, пропом noindex. Так делает
// страница 404: она отдаётся по любому несуществующему адресу, и попасть
// в выдачу ей нельзя ни в каком режиме сборки. Проп раньше передавался,
// но layout его не читал — на боевой сборке (без PUBLIC_NOINDEX) страница
// «Такой страницы нет» вышла бы в поиск с меткой index, follow.
const noindex = import.meta.env.PUBLIC_NOINDEX === '1' || noindexProp

const abs = (path: string) => new URL(href(path), Astro.site).toString()
const home = new URL('/', Astro.site).toString()
const ogImage = abs(SEO.ogImage)

// Организация — базовый блок разметки, есть на каждой странице.
const orgSchema = {
  '@type': 'ProfessionalService',
  '@id': new URL('/', Astro.site).toString() + '#org',
  name: `${SITE.brand} — вступление в СРО`,
  description:
    'Помощь строительным, проектным и изыскательским компаниям во вступлении в СРО, внесении специалистов в НРС, прохождении НОК и получении лицензий.',
  url: new URL('/', Astro.site).toString(),
  telephone: SITE.phone,
  email: SITE.email,
  founder: { '@type': 'Person', name: 'Багишев Алихан Ахадович' },
  taxID: SITE.inn,
  // Работа дистанционная по всей стране. Конкретные города в разметке
  // сузили бы выдачу: поисковик решил бы, что это местная фирма.
  areaServed: { '@type': 'Country', name: 'Россия' },
  address: { '@type': 'PostalAddress', addressCountry: 'RU' },
  sameAs: [SITE.whatsapp, SITE.telegram, SITE.maxLink].filter(Boolean),
  // Знак и картинка-превью. Без logo поисковик не покажет фирменный знак
  // ни рядом с сайтом в выдаче, ни в карточке организации.
  logo: { '@type': 'ImageObject', '@id': `${home}#logo`, url: abs('/logo-512.png'), width: 512, height: 512 },
  image: { '@id': `${home}#logo` },
}

// Сайт целиком — узел, к которому привязываются все страницы. Через него
// поисковик понимает, что двадцать адресов складываются в один ресурс
// с одним владельцем, а не лежат сами по себе.
const siteSchema = {
  '@type': 'WebSite',
  '@id': `${home}#website`,
  url: home,
  name: SITE.brand,
  description: 'Вступление в СРО, НРС, НОК и лицензии — по всей России',
  inLanguage: 'ru-RU',
  publisher: { '@id': `${home}#org` },
}

// Сама страница. Тип уточняется пропом: ContactPage у контактов,
// CollectionPage у списков.
const pageSchema = {
  '@type': pageType,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ru-RU',
  isPartOf: { '@id': `${home}#website` },
  about: { '@id': `${home}#org` },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
  ...(breadcrumbs.length > 0 ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
  ...(article ? { datePublished: article.published, dateModified: article.modified } : {}),
}

const crumbSchema =
  breadcrumbs.length > 0
    ? [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: breadcrumbs.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.label,
            ...(c.url ? { item: new URL(c.url, Astro.site).toString() } : {}),
          })),
        },
      ]
    : []

const graph = {
  '@context': 'https://schema.org',
  '@graph': [orgSchema, siteSchema, pageSchema, ...crumbSchema, ...schema],
}
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* У страницы, закрытой от поиска, canonical только вредит: 404
        отдаётся по любому несуществующему адресу, и указывать «настоящий»
        адрес ей не на что. */}
    {!noindexProp && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Шрифты грузим заранее и в режиме optional (см. styles/fonts.css):
         так они успевают к первой отрисовке и вёрстка не дёргается.
         Латиница нужна не ради латинских слов, а ради цифр: «2–3 дня», «10 млн ₽».
         Курсив заранее не грузим: он встречается только в статьях. -->
    <!-- Предзагружается только кириллица. Латиница на сайте встречается
         в десятке слов («WhatsApp», «Telegram», адреса реестров), но весит
         60 КБ из 98 — вдвое больше кириллицы. На критическом пути она
         отнимала канал у тех начертаний, которыми набрана вся страница,
         а при font-display: optional это решает судьбу всего показа:
         не успел шрифт к первой отрисовке — посетитель весь визит читает
         запасным. Латиница грузится обычным порядком, по unicode-range,
         когда встретится. -->
    <link rel="preload" as="font" type="font/woff2" href={href('/fonts/literata-cyrillic.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={href('/fonts/golos-cyrillic.woff2')} crossorigin />

    <!-- Значок сайта. SVG понимают все современные браузеры, но Яндекс
         в выдаче берёт растр, а телефоны — apple-touch-icon: значок сайта
         виден в результатах поиска и на домашнем экране, и его отсутствие
         заметнее, чем кажется. Манифест даёт Андроиду название и цвет. -->
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <meta name="theme-color" content="#171310" />

    <!-- Карта сайта и лента статей. Робот находит их и по robots.txt,
         но ссылка со страницы — второй путь, а у ленты она единственный. -->
    <link rel="sitemap" type="application/xml" href={href('/sitemap-index.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`База знаний — ${SITE.brand}`}
      href={href('/rss.xml')}
    />

    <!-- Подтверждение прав в Яндекс.Вебмастере и Google Search Console.
         Коды вписываются в src/config/seo.ts. Пока их нет, тегов тоже нет:
         пустой content Вебмастер считает неверным кодом. -->
    {SEO.yandexVerification && <meta name="yandex-verification" content={SEO.yandexVerification} />}
    {SEO.googleVerification && <meta name="google-site-verification" content={SEO.googleVerification} />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SEO.ogImageAlt} />

    {article && (
      <>
        <meta property="article:published_time" content={article.published} />
        <meta property="article:modified_time" content={article.modified} />
        <meta property="article:author" content="Багишев Алихан Ахадович" />
        {article.section && <meta property="article:section" content={article.section} />}
      </>
    )}

    <!-- Twitter читает og:*, но остальные, кто разбирает карточку ссылки
         по его правилам (в том числе часть мессенджеров), — только twitter:*.
         Дублируем: это четыре строки против пустой карточки. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SEO.ogImageAlt} />

    {SITE.metrikaId && (
      <>
        <link rel="preconnect" href="https://mc.yandex.ru" crossorigin />
        <link rel="dns-prefetch" href="https://mc.yandex.ru" />
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Прятать блоки под анимацию можно только когда скрипт точно работает.
         Ставим класс до отрисовки, чтобы не было мигания. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>

  <body data-base={import.meta.env.BASE_URL}>
    <a class="skip" href="#main">Перейти к содержанию</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Круглая кнопка связи в углу убрана.
         Она была единственным быстрым путём к форме при долгой прокрутке —
         пока кнопка в шапке вела к калькулятору и дублировала кнопку первого
         экрана. Теперь кнопка в шапке ведёт к форме, липнет к верху страницы
         и делает то же самое, не занимая угол. Заодно ушёл единственный
         элемент, из-за которого сайт с печатью и бумагой выглядел как
         соседние лендинги: круглый значок в правом нижнем углу читается
         виджетом чата и стоит на каждом втором сайте рынка.
         На телефоне за связь по-прежнему отвечает нижняя панель. -->

    <!-- Панель связи на мобильных: появляется после первого экрана -->
    <nav class="mobile-bar" aria-label="Быстрая связь">
      <a href={SITE.phoneHref} data-goal="click_phone">
        <Icon name="phone" size={20} />
        Позвонить
      </a>
      <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" data-goal="click_whatsapp">
        <Icon name="whatsapp" size={20} />
        WhatsApp
      </a>
      <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" data-goal="click_telegram">
        <Icon name="telegram" size={20} />
        Telegram
      </a>
    </nav>

    <!-- ═══ МЕСТО ПОД СЧЁТЧИК ЯНДЕКС.МЕТРИКИ ═══
         Номер счётчика вписывается в src/config/site.ts → metrikaId.
         Пока он пустой, код счётчика на страницы не попадает. -->
    {SITE.metrikaId && (
      <script is:inline define:vars={{ id: SITE.metrikaId }}>
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments) }
          m[i].l = 1 * new Date()
          for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) return }
          k = e.createElement(t); a = e.getElementsByTagName(t)[0]
          k.async = 1; k.src = r; a.parentNode.insertBefore(k, a)
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym')
        ym(id, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true })
      </script>
      <noscript><div><img src={`https://mc.yandex.ru/watch/${SITE.metrikaId}`} style="position:absolute;left:-9999px" alt="" /></div></noscript>
    )}

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        background: var(--acc-btn);
        color: #fff;
        padding: 10px 16px;
        z-index: 100;
        border-radius: 0 0 var(--r-s) 0;
      }
      .skip:focus { left: 0; top: 0; }
    </style>

    <script>
      // Плавное появление блоков при прокрутке.
      const reveal = () => {
        const items = Array.from(document.querySelectorAll<HTMLElement>('.rv'))
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          items.forEach((el) => el.classList.add('in'))
          return
        }

        // Ступенчатая задержка: соседи в одном ряду выходят один за другим,
        // а не разом. Номер считается среди соседей с тем же классом, чтобы
        // отсчёт начинался заново в каждой новой сетке карточек.
        // Потолок в шесть шагов не случаен: на списке из двадцати пунктов
        // последний иначе появился бы почти через две секунды после первого,
        // и это читалось бы не как анимация, а как подвисание.
        for (const el of items) {
          const parent = el.parentElement
          if (!parent) continue
          const twins = Array.from(parent.children).filter((n) => n.classList.contains('rv'))
          if (twins.length < 2) continue
          el.style.setProperty('--rv-i', String(Math.min(twins.indexOf(el), 6)))
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in')
                io.unobserve(entry.target)
              }
            })
          },
          // Запускаем ДО того, как блок войдёт в кадр, а не после.
          // Раньше стояло -8%: появление начиналось, когда блок уже
          // на восьмую часть влез снизу, и при быстрой прокрутке пальцем
          // содержимое доезжало проявляться уже после того, как человек
          // остановился — три блока из четырёх в кадре ещё были полупрозрачны.
          // Плюс 12% дают анимации фору примерно в сотню пикселей, и к моменту,
          // когда блок виден целиком, он уже на месте.
          { rootMargin: '0px 0px 12% 0px' },
        )
        items.forEach((el) => io.observe(el))

        // Страховка: если наблюдатель почему-то не сработал, через 3 секунды
        // показываем всё принудительно. Невидимый текст хуже отсутствия анимации.
        setTimeout(() => items.forEach((el) => el.classList.add('in')), 3000)
      }
      reveal()

      // Нижняя панель связи показывается, когда посетитель ушёл с первого экрана.
      const bar = document.querySelector('.mobile-bar')
      if (bar) {
        const toggle = () => bar.classList.toggle('show', window.scrollY > window.innerHeight * 0.6)
        toggle()
        window.addEventListener('scroll', toggle, { passive: true })
      }

      // Цели Яндекс.Метрики на кликах по контактам.
      document.querySelectorAll('[data-goal]').forEach((el) => {
        el.addEventListener('click', () => {
          const goal = (el as HTMLElement).dataset.goal
          const w = window as unknown as { ym?: (...a: unknown[]) => void; __metrikaId?: string }
          if (goal && typeof w.ym === 'function' && w.__metrikaId) w.ym(w.__metrikaId, 'reachGoal', goal)
        })
      })
    </script>

    {SITE.metrikaId && (
      <script is:inline define:vars={{ id: SITE.metrikaId }}>
        window.__metrikaId = id
      </script>
    )}
  </body>
</html>

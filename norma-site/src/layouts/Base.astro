---
import '../styles/fonts.css'
import '../styles/global.css'

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Icon from '../components/Icon.astro'
import BrandIcon from '../components/BrandIcon.astro'
import CookieBanner from '../components/CookieBanner.astro'
import { SITE, href } from '../config/site'
import { SEO } from '../config/seo'
import { ABOUT } from '../config/about'

interface Props {
  title: string
  description: string
  /** Дополнительные блоки микроразметки Schema.org (FAQ, HowTo, Article) */
  schema?: object[]
  /** Хлебные крошки: [{ label, url }] — последний элемент текущая страница */
  breadcrumbs?: { label: string; url?: string }[]
  /** Закрыть страницу от поиска независимо от режима сборки (страница 404). */
  noindex?: boolean
  /**
   * Тип страницы в микроразметке: ContactPage у контактов, CollectionPage
   * у списков, WebPage у всего остального. Поисковик по нему понимает,
   * что это за страница, не разбирая её текст.
   */
  pageType?: string
  /**
   * Страница — статья. Тогда Open Graph получает тип article и даты:
   * мессенджеры и агрегаторы показывают их в карточке ссылки, а Яндекс
   * использует дату при сортировке по свежести.
   */
  article?: { published: string; modified: string; section?: string }
}

const {
  title,
  description,
  schema = [],
  breadcrumbs = [],
  noindex: noindexProp = false,
  pageType = 'WebPage',
  article,
} = Astro.props

// Полный адрес страницы: нужен для canonical, Open Graph и микроразметки.
const canonical = new URL(Astro.url.pathname, Astro.site).toString()

// Черновик на превью-ссылке не должен попадать в поиск. Боевая сборка на своём
// домене делается без NOINDEX — тогда сайт открыт для индексации.
//
// Плюс отдельные страницы могут закрываться сами, пропом noindex. Так делает
// страница 404: она отдаётся по любому несуществующему адресу, и попасть
// в выдачу ей нельзя ни в каком режиме сборки. Проп раньше передавался,
// но layout его не читал — на боевой сборке (без PUBLIC_NOINDEX) страница
// «Такой страницы нет» вышла бы в поиск с меткой index, follow.
const noindex = import.meta.env.PUBLIC_NOINDEX === '1' || noindexProp

const abs = (path: string) => new URL(href(path), Astro.site).toString()
const home = new URL('/', Astro.site).toString()
const ogImage = abs(SEO.ogImage)

// Организация — базовый блок разметки, есть на каждой странице.
const orgSchema = {
  '@type': 'ProfessionalService',
  '@id': new URL('/', Astro.site).toString() + '#org',
  name: `${SITE.brand} — вступление в СРО`,
  description:
    'Помощь строительным, проектным и изыскательским компаниям во вступлении в СРО, внесении специалистов в НРС, прохождении НОК и получении лицензий.',
  url: new URL('/', Astro.site).toString(),
  telephone: SITE.phone,
  email: SITE.email,
  // Владелец — отдельный узел со своим @id: на него ссылается автор каждой
  // статьи. Страница «Обо мне» и фотография связывают разборы базы знаний
  // с живым человеком, который за них отвечает, — поисковики учитывают
  // это у текстов о законе и деньгах. Род занятий — та же строка, что
  // подписана под фотографией над формой (LeadForm).
  founder: {
    '@type': 'Person',
    '@id': `${home}#person`,
    name: 'Багишев Алихан Ахадович',
    url: abs('/obo-mne/'),
    description: 'Вступление в СРО, НРС, НОК и лицензии',
    ...(SITE.photo ? { image: abs(`/img/${SITE.photo}`) } : {}),
  },
  taxID: SITE.inn,
  // Работа дистанционная по всей стране — это areaServed. Город в адресе
  // появился 29.09.2026: регион сайта в Вебмастере — Санкт-Петербург
  // (решение заказчика: ИП зарегистрирован там, 78 в ОГРНИП, там 5 из 8
  // партнёрских СРО). Раньше здесь стоял один код страны, «чтобы выдача
  // не сузилась», — заказчик выбрал прибавку по Петербургу. Улицы нет
  // нарочно: адрес домашний, он стоит только в политике.
  areaServed: { '@type': 'Country', name: 'Россия' },
  address: { '@type': 'PostalAddress', addressCountry: 'RU', addressLocality: ABOUT.city },
  sameAs: [SITE.whatsapp, SITE.telegram, SITE.maxLink].filter(Boolean),
  // Знак и картинка-превью. Без logo поисковик не покажет фирменный знак
  // ни рядом с сайтом в выдаче, ни в карточке организации.
  logo: { '@type': 'ImageObject', '@id': `${home}#logo`, url: abs('/logo-512.png'), width: 512, height: 512 },
  image: { '@id': `${home}#logo` },
}

// Сайт целиком — узел, к которому привязываются все страницы. Через него
// поисковик понимает, что двадцать адресов складываются в один ресурс
// с одним владельцем, а не лежат сами по себе.
const siteSchema = {
  '@type': 'WebSite',
  '@id': `${home}#website`,
  url: home,
  name: SITE.brand,
  description: 'Вступление в СРО, НРС, НОК и лицензии — по всей России',
  inLanguage: 'ru-RU',
  publisher: { '@id': `${home}#org` },
}

// Сама страница. Тип уточняется пропом: ContactPage у контактов,
// CollectionPage у списков.
const pageSchema = {
  '@type': pageType,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ru-RU',
  isPartOf: { '@id': `${home}#website` },
  about: { '@id': `${home}#org` },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
  ...(breadcrumbs.length > 0 ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
  ...(article ? { datePublished: article.published, dateModified: article.modified } : {}),
}

const crumbSchema =
  breadcrumbs.length > 0
    ? [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: breadcrumbs.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.label,
            ...(c.url ? { item: new URL(c.url, Astro.site).toString() } : {}),
          })),
        },
      ]
    : []

const graph = {
  '@context': 'https://schema.org',
  '@graph': [orgSchema, siteSchema, pageSchema, ...crumbSchema, ...schema],
}
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover — ради нижней панели связи: без него iPhone отдаёт
        env(safe-area-inset-bottom) нулём, и подписи панели ложатся вплотную
        к полоске «домой». Поля страницы при этом не уходят под «чёлку»
        в альбомной ориентации — .wrap берёт max(20px, выреза), global.css. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* У страницы, закрытой от поиска, canonical только вредит: 404
        отдаётся по любому несуществующему адресу, и указывать «настоящий»
        адрес ей не на что. */}
    {!noindexProp && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Шрифты грузим заранее и в режиме optional (см. styles/fonts.css):
         так они успевают к первой отрисовке и вёрстка не дёргается.
         Латиница нужна не ради латинских слов, а ради цифр: «2–3 дня», «10 млн ₽».
         Курсив заранее не грузим: он встречается только в статьях. -->
    <!-- Латиница предзагружается вместе с кириллицей — все четыре файла.
         Какое-то время грузилась одна кириллица: латиница весит 60 КБ из 98,
         и было решено, что она подгрузится сама, «когда встретится».
         Не подгружалась никогда. При font-display: optional браузер берёт
         шрифт, только если тот готов к первой отрисовке, а незагруженный
         заранее к ней не готов ни при каком канале — даже с локального
         сервера. В латинской части не только латиница: цифры, пробел,
         знаки препинания, «₽» рядом с ними. Поэтому телефон, все суммы,
         «WhatsApp» и «Telegram» в панели связи набирались запасными
         шрифтами (Helvetica или Arial, в заголовках Georgia), а «Позвонить»
         рядом — Golos. Заказчик увидел
         это на панели: «некрасиво, сделай ровнее».
         Замер 27.09.2026 (медленный 4G, процессор ×4, пять прогонов):
         с предзагрузкой первый экран не медленнее, а быстрее — главная
         1,78 → 1,58 с, «Контакты» 1,80 → 1,63 с, «Стоимость» без разницы;
         сдвиг вёрстки 0 в обоих случаях. Прежний довод «2236 → 1700 мс»
         при нынешней сборке не повторяется. -->
    <link rel="preload" as="font" type="font/woff2" href={href('/fonts/literata-cyrillic.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={href('/fonts/golos-cyrillic.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={href('/fonts/golos-latin.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={href('/fonts/literata-latin.woff2')} crossorigin />
    {/* Знак рубля — по килобайту (styles/fonts.css): «₽» стоит в каждой сумме. */}
    <link rel="preload" as="font" type="font/woff2" href={href('/fonts/golos-rub.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={href('/fonts/literata-rub.woff2')} crossorigin />

    <!-- Значок сайта. SVG понимают все современные браузеры, но Яндекс
         в выдаче берёт растр, а телефоны — apple-touch-icon: значок сайта
         виден в результатах поиска и на домашнем экране, и его отсутствие
         заметнее, чем кажется. Манифест даёт Андроиду название и цвет. -->
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <meta name="theme-color" content="#171310" />

    <!-- Карта сайта и лента статей. Робот находит их и по robots.txt,
         но ссылка со страницы — второй путь, а у ленты она единственный. -->
    <link rel="sitemap" type="application/xml" href={href('/sitemap-index.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`База знаний — ${SITE.brand}`}
      href={href('/rss.xml')}
    />

    <!-- Подтверждение прав в Яндекс.Вебмастере и Google Search Console.
         Коды вписываются в src/config/seo.ts. Пока их нет, тегов тоже нет:
         пустой content Вебмастер считает неверным кодом. -->
    {SEO.yandexVerification && <meta name="yandex-verification" content={SEO.yandexVerification} />}
    {SEO.googleVerification && <meta name="google-site-verification" content={SEO.googleVerification} />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SEO.ogImageAlt} />

    {article && (
      <>
        <meta property="article:published_time" content={article.published} />
        <meta property="article:modified_time" content={article.modified} />
        <meta property="article:author" content="Багишев Алихан Ахадович" />
        {article.section && <meta property="article:section" content={article.section} />}
      </>
    )}

    <!-- Twitter читает og:*, но остальные, кто разбирает карточку ссылки
         по его правилам (в том числе часть мессенджеров), — только twitter:*.
         Дублируем: это четыре строки против пустой карточки. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SEO.ogImageAlt} />

    {/* preconnect к mc.yandex.ru убран из головы страницы намеренно:
        соединение к Яндексу открывалось бы ещё до того, как посетитель
        что-либо выбрал. Выигрыш в скорости тут меньше, чем цена такого
        соединения без согласия. */}

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    {/* Предзагрузка страниц по наведению — правила для браузера, без скрипта.
        Хостинг отвечает на запрос страницы за 1,5–4,4 с (Seobility и Вебмастер,
        29.09.2026), а та же сборка на Apache с нашим .htaccess — за 2–4 мс:
        ждёт сервер, не сайт. Навёл курсор на ссылку — браузер запрашивает
        страницу, пока рука идёт к клику, и ожидание проходит заранее.
        Только prefetch, не prerender: страница скачивается, но не выполняется,
        поэтому Метрика не считает визит, которого не было. Chrome, Edge
        и Яндекс Браузер понимают правила, остальные браузеры их пропускают.
        Стережёт test-pages: наведение даёт запрос с Sec-Purpose: prefetch. */}
    <script
      is:inline
      type="speculationrules"
      set:html={JSON.stringify({
        prefetch: [
          {
            source: 'document',
            where: {
              and: [
                { href_matches: `${import.meta.env.BASE_URL}*` },
                { not: { href_matches: `${import.meta.env.BASE_URL}api/*` } },
                { not: { selector_matches: '[download], [target=_blank]' } },
              ],
            },
            eagerness: 'moderate',
          },
        ],
      })}
    />

    <!-- Прятать блоки под анимацию можно только когда скрипт точно работает.
         Ставим класс до отрисовки, чтобы не было мигания. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>

  <body data-base={import.meta.env.BASE_URL}>
    <a class="skip" href="#main">Перейти к содержанию</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer title={title} share={!article && !noindexProp} />

    <!-- Кнопки связи на телефоне: столбик круглых значков у правого края.
         Видны сразу, с первого экрана, все четыре канала — у многих клиентов
         рабочий мессенджер MAX («всё, что человеку нужно, — на самом видном
         месте», просьба заказчика).

         До 27.09.2026 здесь была сплошная тёмная полоса во всю ширину низа
         экрана, с подписями. Заказчик попросил убрать «чёрный блок» и оставить
         одни значки справа. Цена названа: значки лежат поверх страницы и
         закрывают правый край строк, пока те проезжают под ними, — полоса
         держала под собой своё место. Поэтому столбик уходит, когда мешает
         по-настоящему: открыто меню, человек печатает в поле формы (global.css),
         страница докручена до конца (скрипт ниже, у подвала своя связь)
         и человек листает вниз, то есть читает (с 30.09.2026, там же).
         Над полосой про cookie он поднимается сам — её высоту сообщает
         CookieBanner.astro.

         Порядок в разметке — телефон первым, как и раньше: так их читает
         экранный диктор. На экране столбик собран снизу вверх, и телефон
         оказывается внизу, ближе всего к большому пальцу. Подписей
         на экране нет, поэтому у каждой ссылки есть текст, видный только
         голосом (.vh). Раньше это было aria-label без текста — для
         поисковика такие ссылки пустые (аудит 28.09.2026). -->
    <nav class="contact-rail" aria-label="Быстрая связь">
      <a href={SITE.phoneHref} data-goal="click_phone">
        <BrandIcon name="phone" size={46} /><span class="vh">Позвонить: {SITE.phone}</span>
      </a>
      <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" data-goal="click_whatsapp">
        <BrandIcon name="whatsapp" size={46} /><span class="vh">Написать в WhatsApp</span>
      </a>
      <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" data-goal="click_telegram">
        <BrandIcon name="telegram" size={46} /><span class="vh">Написать в Telegram</span>
      </a>
      {SITE.maxLink && (
        <a href={SITE.maxLink} target="_blank" rel="noopener noreferrer" data-goal="click_max">
          <BrandIcon name="max" size={46} /><span class="vh">Написать в MAX</span>
        </a>
      )}
    </nav>

    {/* СЧЁТЧИК ЯНДЕКС.МЕТРИКИ. Номер вписывается в src/config/site.ts →
        metrikaId. Сам счётчик подключается НЕ отсюда, а из CookieBanner.astro
        и только после согласия посетителя: до нажатия кнопки к Яндексу
        не уходит ни одного запроса. Пока metrikaId пустой, нет ни счётчика,
        ни полосы про cookie — сообщать не о чем.
        Картинки-пикселя в noscript здесь тоже больше нет: она срабатывала бы
        до всякого согласия и мимо выбора посетителя.
        Комментарий намеренно в фигурных скобках, а не в HTML: обычный
        комментарий уехал бы в разметку всех 81 страницы. */}
    <CookieBanner />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        background: var(--acc-btn);
        color: #fff;
        padding: 10px 16px;
        z-index: 100;
        border-radius: 0 0 var(--r-s) 0;
      }
      .skip:focus { left: 0; top: 0; }
    </style>

    <script>
      // Плавное появление блоков при прокрутке.
      const reveal = () => {
        const items = Array.from(document.querySelectorAll<HTMLElement>('.rv'))
        const show = (el: Element) => {
          el.classList.remove('rv-wait')
          el.classList.add('in')
        }
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          items.forEach(show)
          return
        }

        // Ступенчатая задержка: соседи в одном ряду выходят один за другим,
        // а не разом. Номер считается среди соседей с тем же классом, чтобы
        // отсчёт начинался заново в каждой новой сетке карточек.
        // Потолок в шесть шагов не случаен: на списке из двадцати пунктов
        // последний иначе появился бы почти через две секунды после первого,
        // и это читалось бы не как анимация, а как подвисание.
        for (const el of items) {
          const parent = el.parentElement
          if (!parent) continue
          const twins = Array.from(parent.children).filter((n) => n.classList.contains('rv'))
          if (twins.length < 2) continue
          el.style.setProperty('--rv-i', String(Math.min(twins.indexOf(el), 6)))
        }

        // Прячем только то, что ниже экрана. Что видно сейчас (и что выше,
        // если страница открылась прокрученной), остаётся как есть: блоки
        // первого экрана не ждут ни скрипта, ни анимации. Прячем уже после
        // отрисовки, но за краем экрана — этого не видно.
        const later = items.filter((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            show(el)
            return false
          }
          el.classList.add('rv-wait')
          return true
        })

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                show(entry.target)
                io.unobserve(entry.target)
              }
            })
          },
          // Запускаем ДО того, как блок войдёт в кадр, а не после.
          // Раньше стояло -8%: появление начиналось, когда блок уже
          // на восьмую часть влез снизу, и при быстрой прокрутке пальцем
          // содержимое доезжало проявляться уже после того, как человек
          // остановился — три блока из четырёх в кадре ещё были полупрозрачны.
          // Плюс 12% дают анимации фору примерно в сотню пикселей, и к моменту,
          // когда блок виден целиком, он уже на месте.
          { rootMargin: '0px 0px 12% 0px' },
        )
        later.forEach((el) => io.observe(el))

        // Страховка: если наблюдатель почему-то не сработал, через 3 секунды
        // показываем всё принудительно. Невидимый текст хуже отсутствия анимации.
        setTimeout(() => later.forEach(show), 3000)
      }
      reveal()

      // Кнопки связи на телефоне уходят в самом конце страницы.
      // Дальше подвала прокрутить нельзя, и правый край его последних строк
      // (реквизиты, оговорка, © ) остался бы под значками навсегда.
      // Связь при этом не теряется: в подвале свои телефон и мессенджеры.
      const legal = document.querySelector('.site-footer .legal')
      if (legal && 'IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => {
          document.documentElement.classList.toggle('at-page-end', entry.isIntersecting)
        }).observe(legal)
      }

      // Кнопки связи уходят и тогда, когда человек листает вниз, — то есть
      // читает. Столбик лежит поверх текста, и до 30.09.2026 он закрывал
      // правый край каждой строки: на первом экране главной — суммы
      // в карточке условий, в вопросах — «плюсы», по которым нажимают
      // (палец попадал в Telegram вместо ответа), в статьях — концы строк.
      // Листнул вверх или вернулся к началу страницы — значки на месте:
      // так ищут, где написать. Телефон в шапке виден всегда.
      // Движение копится в одну сторону, иначе столбик мигал бы от дрожи
      // пальца. Скачок больше экрана — не чтение, а переход по ссылке или
      // возврат прокрутки после меню; такой скачок решения не меняет.
      const rootEl = document.documentElement
      let lastY = window.scrollY
      let run = 0
      window.addEventListener(
        'scroll',
        () => {
          const y = window.scrollY
          const dy = y - lastY
          lastY = y
          if (dy === 0 || rootEl.classList.contains('menu-open')) return
          if (Math.abs(dy) > window.innerHeight * 0.9) {
            run = 0
            return
          }
          run = Math.sign(dy) === Math.sign(run) ? run + dy : dy
          if (y < 80 || run < -32) rootEl.classList.remove('rail-away')
          else if (run > 32) rootEl.classList.add('rail-away')
        },
        { passive: true },
      )

      // Цели Яндекс.Метрики на кликах по контактам и по окошку «Сайт компании —
      // бесплатно» на первом экране (список целей — в README).
      document.querySelectorAll('[data-goal]').forEach((el) => {
        el.addEventListener('click', () => {
          const goal = (el as HTMLElement).dataset.goal
          const w = window as unknown as { ym?: (...a: unknown[]) => void; __metrikaId?: string }
          if (goal && typeof w.ym === 'function' && w.__metrikaId) w.ym(w.__metrikaId, 'reachGoal', goal)
        })
      })
    </script>


  </body>
</html>

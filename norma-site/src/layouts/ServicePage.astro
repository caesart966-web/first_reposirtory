---
import Base from './Base.astro'
import LeadForm from '../components/LeadForm.astro'
import Icon from '../components/Icon.astro'
import { SERVICES } from '../config/services'
import { href, SITE } from '../config/site'

interface Props {
  slug: string
  title: string
  metaTitle: string
  description: string
  lead: string
  /** Ключевые факты в шапке: [{ v: '10 млн ₽', d: 'порог', law: 'ч. 2.1 ст. 52' }] */
  facts?: { v: string; d: string; law?: string }[]
  faq?: { q: string; a: string }[]
  formTitle?: string
  formSubtitle?: string
}

const { slug, title, metaTitle, description, lead, facts = [], faq = [], formTitle, formSubtitle } = Astro.props

const others = SERVICES.filter((s) => s.slug !== slug).slice(0, 3)

const faqSchema =
  faq.length > 0
    ? [
        {
          '@type': 'FAQPage',
          mainEntity: faq.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []

const serviceSchema = {
  '@type': 'Service',
  name: title,
  description,
  areaServed: { '@type': 'Country', name: 'Россия' },
  provider: { '@id': new URL('/', Astro.site).toString() + '#org' },
}
---

<Base
  title={metaTitle}
  description={description}
  schema={[serviceSchema, ...faqSchema]}
  breadcrumbs={[
    { label: 'Главная', url: href('/') },
    { label: 'Услуги', url: href('/uslugi/') },
    { label: title },
  ]}
>
  <section class="section page-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={href('/')}>Главная</a>
        <span aria-hidden="true">/</span>
        <a href={href('/uslugi/')}>Услуги</a>
      </nav>
      <h1>{title}</h1>
      <p class="lead" set:html={lead} />

      {facts.length > 0 && (
        <div class="facts">
          {facts.map((f) => (
            <div class="fact">
              <div class="fv">{f.v}</div>
              <div class="fd">{f.d}</div>
              {f.law && <span class="law law--dark">{f.law}</span>}
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap svc-body">
      <div class="prose">
        <slot />
      </div>

      <aside class="svc-side">
        <div class="side-card side-card--acc">
          <span class="sc-label">Проверьте себя</span>
          <h2>Нужна ли вам СРО</h2>
          <p>Четыре вопроса, ответ со ссылкой на норму. Если членство не требуется — скажем прямо.</p>
          <a class="btn btn--acc" href={href('/#calc')}>Открыть калькулятор</a>
        </div>

        <div class="side-card">
          <span class="sc-label">Стоимость</span>
          <h2>Что придётся оплатить</h2>
          <p>Открытая разбивка всех взносов по уровням ответственности — с отдельной строкой для торгов.</p>
          <a class="btn btn--ghost" href={href('/stoimost/')}>Посмотреть разбивку</a>
        </div>

        <div class="side-card side-card--dark">
          <span class="sc-label">Связаться</span>
          <a class="side-phone" href={SITE.phoneHref} data-goal="click_phone">{SITE.phone}</a>
          <p>{SITE.geoShort}</p>
          <div class="side-msgs">
            <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" data-goal="click_whatsapp">WhatsApp</a>
            <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" data-goal="click_telegram">Telegram</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {faq.length > 0 && (
    <section class="section section--tight faq-sec">
      <div class="wrap">
        <div class="s-head rv">
          <h2>Частые вопросы</h2>
        </div>
        <div class="faq rv">
          {faq.map((f, i) => (
            <details name="svcfaq" open={i === 0}>
              <summary>{f.q}</summary>
              <div class="fa"><p set:html={f.a} /></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap narrow">
      <LeadForm
        title={formTitle ?? 'Оставьте заявку — разберу вашу задачу'}
        subtitle={formSubtitle ?? 'Отвечу лично и скажу прямо, что нужно в вашем случае, а что нет.'}
      />
    </div>
  </section>

  <section class="section section--tight others">
    <div class="wrap">
      <h2>Другие услуги</h2>
      <div class="grid-3">
        {others.map((s) => (
          <a class="card oc" href={href(`/uslugi/${s.slug}/`)}>
            <span class="ic"><Icon name={s.icon} size={19} /></span>
            <h3>{s.short}</h3>
            <p>{s.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { background: var(--navy); color: var(--on-navy); padding-bottom: 40px; }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--on-navy-muted); margin-bottom: 16px; flex-wrap: wrap; }
  .crumbs a { color: var(--on-navy-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--acc-bright); }
  .page-head h1 { color: #fff; max-width: 22ch; }
  .page-head .lead { color: var(--on-navy-muted); margin-top: 16px; }
  .page-head .lead :global(b) { color: #fff; }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1px; background: var(--navy-line); border: 1px solid var(--navy-line); border-radius: var(--r-m); overflow: hidden; margin-top: 28px; }
  .fact { background: var(--navy); padding: 18px 20px; display: grid; gap: 4px; align-content: start; }
  .fv { font-family: var(--font-head); font-size: 22px; font-weight: 800; color: var(--acc-bright); font-variant-numeric: tabular-nums; line-height: 1.15; }
  .fd { font-size: 13px; color: var(--on-navy-muted); line-height: 1.45; }
  .fact .law { justify-self: start; margin-top: 4px; }

  .svc-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 40px; align-items: start; }

  /* min-width: 0 обязателен: без него широкая таблица внутри распирает
     колонку сетки и вся страница уезжает вбок на телефоне. */
  .prose { max-width: 70ch; min-width: 0; font-size: 16.5px; line-height: 1.72; }
  .prose :global(h2) { font-size: 25px; margin: 36px 0 14px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 19px; margin: 26px 0 10px; }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 18px; padding-left: 24px; display: grid; gap: 8px; }
  .prose :global(a) { color: var(--acc-deep); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(.callout) {
    background: var(--acc-soft);
    border: 1px solid color-mix(in srgb, var(--acc) 30%, transparent);
    border-radius: var(--r-m);
    padding: 18px 22px;
    margin: 0 0 20px;
  }
  .prose :global(.callout p) { margin: 0; }
  .prose :global(.callout p + p) { margin-top: 10px; }
  .prose :global(.warn-box) {
    background: var(--warn-bg);
    border: 1px solid rgba(138, 93, 0, 0.35);
    border-radius: var(--r-m);
    padding: 18px 22px;
    margin: 0 0 20px;
  }
  .prose :global(.warn-box p) { margin: 0; }
  .prose :global(.warn-box p + p) { margin-top: 10px; }
  .prose :global(.tbl-wrap) { margin: 0 0 20px; }

  .svc-side { display: grid; gap: 14px; position: sticky; top: 96px; }
  .side-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--r-l); padding: 22px; display: grid; gap: 10px; }
  .side-card--acc { background: var(--acc-soft); border-color: color-mix(in srgb, var(--acc) 30%, transparent); }
  .side-card--dark { background: var(--navy); border-color: var(--navy-line); }
  .sc-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .side-card--dark .sc-label { color: var(--on-navy-muted); }
  .side-card h2 { font-size: 17px; }
  .side-card p { font-size: 14px; color: var(--muted); }
  .side-card--dark p { color: var(--on-navy-muted); }
  .side-card .btn { justify-self: start; }
  .side-phone { font-family: var(--font-mono); font-size: 19px; color: #fff; text-decoration: none; }
  .side-phone:hover { color: var(--acc-bright); }
  .side-msgs { display: flex; gap: 14px; }
  .side-msgs a { color: var(--acc-bright); font-size: 14px; text-decoration: none; }

  .faq-sec { background: var(--card); border-top: 1px solid var(--line); }
  .faq { display: grid; gap: 10px; max-width: 900px; }
  .faq details { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-m); overflow: hidden; }
  .faq summary { padding: 18px 22px; font-weight: 600; font-size: 16px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 14px; align-items: center; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--font-mono); font-size: 20px; color: var(--acc-deep); flex: none; }
  .faq details[open] summary::after { content: '−'; }
  .faq .fa { padding: 0 22px 20px; }
  .faq .fa :global(p) { color: var(--muted); font-size: 15.5px; max-width: 76ch; }

  .narrow { max-width: 780px; }

  .others h2 { font-size: 22px; margin-bottom: 18px; }
  .oc { display: grid; gap: 9px; align-content: start; }
  .oc h3 { font-size: 17px; margin: 0; }
  .ic { width: 38px; height: 38px; border-radius: var(--r-s); background: var(--acc-soft); color: var(--acc-deep); display: grid; place-items: center; }

  @media (max-width: 900px) {
    .svc-body { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .svc-side { position: static; }
  }
</style>

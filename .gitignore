# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# construction-mcp backend runtime artifacts
backend/construction-mcp/data/
*.db
*.db-wal
*.db-shm

# OS / editors
.DS_Store
*.swp
.idea/
.vscode/

# Служебные папки сборщиков: иногда создаются в корне, если команду
# запустили не из папки проекта. В репозиторий они не нужны.
node_modules/
.astro/

# pto-site: реальные токены приёма заявок (заливаются на хостинг руками)
pto-site/assets/config.js
pto-site/dist/assets/config.js

# master-site: журнал заявок, если письмо не ушло (создаётся на хостинге)
master-site/leads.log

# sro-leads: секреты, база, снапшоты реестров, входящие выгрузки, отчёты, логи
sro-leads/.env
sro-leads/data/snapshots/*
!sro-leads/data/snapshots/.gitkeep
sro-leads/data/tenderguru/*
!sro-leads/data/tenderguru/.gitkeep
!sro-leads/data/tenderguru/processed/
sro-leads/data/tenderguru/processed/*
!sro-leads/data/tenderguru/processed/.gitkeep
sro-leads/data/companies/*
!sro-leads/data/companies/.gitkeep
sro-leads/output/*
!sro-leads/output/.gitkeep
sro-leads/logs/*
!sro-leads/logs/.gitkeep
sro-leads/inspect*.txt
